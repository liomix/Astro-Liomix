---
/**
 * 评论抽屉 iframe 专用极简布局
 * ---------------------------------------------------------------------------
 * 不套 Layout.astro：那套会带上 #progress-bar、左下角迷你播放器、樱花 / 波浪特效、
 * Fancybox 等全站级 DOM，塞进评论抽屉里全是噪音。
 * 这里只要三样东西 —— 主题 CSS 变量（main.css + variables.styl）、深浅色状态、
 * 以及一个干净的 body。
 *
 * 深浅色优先读父窗口的 <html class="dark">（同源可访问），这样首次渲染就不会
 * 出现「父页面深色、抽屉里先闪一下白色」；独立访问时回退到 localStorage。
 *
 * 注意这里**不做任何「让页面透明、把背景让给父窗口」的处理**：壁纸和顶栏、消息区、
 * 输入栏同在正文档里，页面自己就是完整的一层。父窗口只需要把 iframe 摆对位置。
 */
import "@/styles/main.css";
import "@/styles/variables.styl";
import { siteConfig } from "@/config";
import {
	COMMENT_WALLPAPER_STORAGE_KEY,
	commentWallpaperConfig,
} from "@/config/commentWallpaperConfig";

interface Props {
	title?: string;
	/** 站点语言，默认 zh-CN */
	lang?: string;
}

const { title = "", lang = "zh-CN" } = Astro.props;
/** 站点默认主题色相：用户没在设置里改过色时用它，保证 iframe 里 --hue 一定有值 */
const defaultHue = siteConfig.themeColor.hue;

/**
 * 壁纸 id → 垫底色（取色板第一个色）。
 * 内联脚本按访客实际选中的那张写进 --tg-wallpaper-tint，让评论页在壁纸还没画出来
 * 的那几帧就露出壁纸自己的色调 —— 而不是聊天底色那块浅灰白。
 */
const wallpaperTints: Record<string, string> = Object.fromEntries(
	commentWallpaperConfig.wallpapers.map((item) => [
		item.id,
		item.colors[0] ?? "",
	]),
);
const wallpaperStorageKey = COMMENT_WALLPAPER_STORAGE_KEY;
const wallpaperDefaultId = commentWallpaperConfig.defaultId;
---

<html lang={lang} data-default-hue={defaultHue}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<script
			is:inline
			define:vars={{
				wpTints: wallpaperTints,
				wpKey: wallpaperStorageKey,
				wpDefaultId: wallpaperDefaultId,
			}}
		>
			(function () {
				// 「装在评论抽屉里」这件事只能在这里判断：这一页是预渲染的静态路由，
				// 查询参数到不了服务端（Astro.url.search 在构建产物里是空的），
				// 所以由浏览器按真实地址打标记，且在首屏绘制前完成 —— 关闭按钮不会闪。
				// 标记本身只决定那颗按钮显不显示（见 telegram-chat.css 的 .tg-head-close）
				var embedded = false;
				try {
					embedded = new URLSearchParams(location.search).has("embed");
				} catch {
					embedded = false;
				}
				if (embedded) {
					document.documentElement.dataset.embedded = "true";
				}

				var dark = null;
				try {
					if (window.parent && window.parent !== window) {
						dark = window.parent.document.documentElement.classList.contains("dark");
					}
				} catch {
					dark = null;
				}
				if (dark === null) {
					var stored = localStorage.getItem("theme") || "light";
					if (stored === "system" || stored === "scheduled") {
						dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
					} else {
						dark = stored === "dark";
					}
				}
				document.documentElement.classList.toggle("dark", dark);
				document.documentElement.dataset.theme = dark ? "dark" : "light";
				// --hue 决定整套主题色（--primary / 输入栏强调色都按它算）。
				// 父窗口改过色就跟着走，没改过用 html 上的默认值 —— 不能留空，
				// 否则 var(--hue) 失效，oklch() 整条声明会被丢弃
				var hue = null;
				try {
					hue = localStorage.getItem("hue");
				} catch {
					hue = null;
				}
				if (!hue) hue = document.documentElement.dataset.defaultHue;
				if (hue) document.documentElement.style.setProperty("--hue", hue);

				// 壁纸垫底色：浅色下用访客选的那张壁纸的主色，壁纸还没画出来的那几帧
				// 露的就是它 —— 这是「打开抽屉第一眼不是白」的最后一道兜底。
				// 深色下不写：深色底本身就不是白，而浅色垫底会把画布（opacity .5）照亮
				if (!dark) {
					var tint = null;
					try {
						tint = wpTints[localStorage.getItem(wpKey)];
					} catch (error) {
						tint = null;
					}
					if (!tint) tint = wpTints[wpDefaultId];
					if (tint) {
						document.documentElement.style.setProperty(
							"--tg-wallpaper-tint",
							tint,
						);
					}
				}
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
