---
/**
 * MalPage 页面（域组件）。
 */
import { Icon } from "astro-icon/components";
import MalGrid from "@/features/catalog/mal/components/MalGrid.svelte";
import EmptyState from "@/shared/components/ui/EmptyState.astro";
import I18nKey from "@/shared/i18n/i18nKey";
import { i18n } from "@/shared/i18n/translation";
import { loadMalPageData } from "../lib/load";

const {
	buildTime,
	malConfig,
	isConfigured,
	fetchFailed,
	categories,
	activeCategory,
} = await loadMalPageData();
---

  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="relative w-full mb-8">
        <div class="mb-6">
          <div class="page-heading">
            <div class="page-icon" aria-hidden="true">
              <Icon name="material-symbols:menu-book" />
            </div>
            <div>
              <h2>{i18n(I18nKey.mal)}</h2>
              <p>{i18n(I18nKey.malSubtitle)}</p>
            </div>
            <p class="page-updated">
              <span>{i18n(I18nKey.malLastUpdated)}</span>
              <span>{buildTime}</span>
            </p>
          </div>
        </div>

        {!isConfigured ? (
          /* 未配置提示 */
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {i18n(I18nKey.malNotConfigured)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {i18n(I18nKey.malNotConfiguredDesc)}
            </p>
          </div>
        ) : fetchFailed ? (
          /* 获取失败提示 */
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:error-outline" class="text-[2rem] text-red-500" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {i18n(I18nKey.malFetchError)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {i18n(I18nKey.malFetchErrorDesc)}
            </p>
          </div>
        ) : categories.length > 0 ? (
          /* 分类网格（Svelte 交互组件） */
          <MalGrid
            client:load
            categories={categories}
            initialActiveCategory={activeCategory}
            animeBaseUrl={malConfig.animeBaseUrl}
            mangaBaseUrl={malConfig.mangaBaseUrl}
            nsfw={malConfig.nsfw}
          />
        ) : (
          /* 空列表提示 */
          <EmptyState
            title={isConfigured ? i18n(I18nKey.malEmpty) : i18n(I18nKey.malNotConfigured)}
            description={isConfigured ? i18n(I18nKey.malEmptyReason) : i18n(I18nKey.malNotConfiguredDesc)}
          />
        )}
      </div>
    </div>
  </div>
