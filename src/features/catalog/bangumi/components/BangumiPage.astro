---
/**
 * Bangumi 页面（域组件）：静态模式渲染构建期数据，动态模式挂 Svelte 岛。
 * 页面只留布局与开关判断。
 */
import { Icon } from "astro-icon/components";
import EmptyState from "@/shared/components/ui/EmptyState.astro";
import { siteConfig } from "@/shared/config/siteConfig";
import I18nKey from "@/shared/i18n/i18nKey";
import { i18n } from "@/shared/i18n/translation";
import BangumiGrid from "./BangumiGrid.svelte";
import "@/shared/styles/common.css";
import "@/features/catalog/styles/media-grid.css";
import { loadBangumiPageData } from "../lib/load";

const {
	buildTime,
	bangumiConfig,
	isDynamic,
	isUserIdConfigured,
	tabs,
	bangumiData,
	fetchFailed,
	activeTab,
} = await loadBangumiPageData();
---

  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
        <!-- 页面标题 -->
        <div class="relative w-full mb-8">
            <div class="mb-6">
                <div class="page-heading">
                    <div class="page-icon" aria-hidden="true">
                        <Icon name="material-symbols:movie" />
                    </div>
                    <div>
                        <h2>{i18n(I18nKey.bangumi)}</h2>
                        <p>{i18n(I18nKey.bangumiSubtitle)}</p>
                    </div>
                    {!isDynamic && (
                    <p class="page-updated">
                        <span>{i18n(I18nKey.bangumiLastUpdated)}</span>
                        <span>{buildTime}</span>
                    </p>
                    )}
                </div>
            </div>

      {isDynamic ? (
        /* ==================== Dynamic 模式 ==================== */
        <>
          {!isUserIdConfigured ? (
            <div class="text-center py-16">
              <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
                <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
              </div>
              <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
                未配置 Bangumi 用户ID
              </h2>
              <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
                请在 src/config/siteConfig.ts 中配置你的 Bangumi 用户ID
              </p>
            </div>
          ) : (
            <BangumiGrid
              client:load
              subjectBaseUrl={bangumiConfig.subjectBaseUrl}
              fetchConfig={{
                username: bangumiConfig.username!,
                apiUrl: bangumiConfig.apiUrl,
                categories: bangumiConfig.categories,
                categoryOrder: siteConfig.bangumi?.categoryOrder || [],
                pagination: bangumiConfig.pagination,
                nsfw: bangumiConfig.nsfw,
              }}
            />
          )}
        </>
      ) : (
        /* ==================== Static 模式 ==================== */
        <>
      {fetchFailed ? (
        <div class="text-center py-16">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
            <Icon name="material-symbols:error-outline" class="text-[2rem] text-red-500" />
          </div>
          <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
            {i18n(I18nKey.bangumiFetchError)}
          </h2>
          <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
            {i18n(I18nKey.bangumiFetchErrorDesc)}
          </p>
        </div>
      ) : tabs.length > 0 ? (
        <>
          <BangumiGrid client:load tabs={tabs} initialActiveTab={activeTab} bangumiData={bangumiData} subjectBaseUrl={bangumiConfig.subjectBaseUrl} nsfw={bangumiConfig.nsfw} />
        </>
      ) : (
        <EmptyState
          title={isUserIdConfigured ? i18n(I18nKey.bangumiEmpty) : "未配置 Bangumi 用户ID"}
          description={isUserIdConfigured ? i18n(I18nKey.bangumiEmptyReason) : "请在 src/config/siteConfig.ts 中配置你的 Bangumi 用户ID"}
        />
      )}
        </>
      )}
		</div>
    </div>
  </div>

<style>
  /* 自定义样式 */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
