---
import MalPage from "@/features/catalog/mal/components/MalPage.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/shared/config/siteConfig";
import I18nKey from "@/shared/i18n/i18nKey";
import { i18n } from "@/shared/i18n/translation";

// 页面开关：关掉时 sitemap 也已过滤，这里统一跳 404
if (!siteConfig.pages.mal) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout title={i18n(I18nKey.mal)} description={i18n(I18nKey.malSubtitle)}>
  <MalPage />
</MainGridLayout>
