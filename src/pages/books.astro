---
import Bookshelf3D from "@/components/misc/Bookshelf3D.svelte";
import ReadingHeatmap from "@/components/misc/ReadingHeatmap.svelte";
import { siteConfig } from "@/config";
import { wereadConfig } from "@/config/wereadConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/common.css";
import "@/styles/pages/books.css";
import {
	fetchWereadData,
	formatHours,
	formatMinutes,
} from "@/utils/weread-utils";
import { wereadCacheStats } from "@/utils/weread-cache";

// 页面开关：站点开关或微信读书配置任一关闭都跳 404
if (!siteConfig.pages.books || !wereadConfig.enable) {
	return Astro.redirect("/404/");
}

const title = wereadConfig.title || i18n(I18nKey.books);
const description =
	wereadConfig.description || i18n(I18nKey.booksDescription);

// 构建时抓取微信读书书架与阅读统计（网关只放行 weread.qq.com 跨域，必须服务端拉）
// 结果会落在 cache/weread/，TTL 内不再重复请求，避免 dev 反复刷新把 Key 撸限流
const data = await fetchWereadData(wereadConfig);

if (import.meta.env.DEV) {
	const cache = wereadCacheStats();
	console.log(
		`[Weread] 缓存命中 ${cache.hit} 次 / 复用旧数据 ${cache.stale} 次 / 实际请求 ${cache.fetch} 次${
			cache.denied ? ` / 被拒 ${cache.denied} 次` : ""
		}${cache.skipped ? ` / 冷却跳过 ${cache.skipped} 次` : ""}`,
	);
	if (cache.fetch > 0) {
		console.log(
			"[Weread] dev 只读缓存：本次有缓存缺失才请求了网关；平时刷新页面不会重复请求，要更新数据请跑 pnpm books:refresh",
		);
	}
}

const limit = Math.max(0, wereadConfig.limit ?? 0);
const books = limit > 0 ? data.books.slice(0, limit) : data.books;
const stats = wereadConfig.showStats === false ? null : data.stats;

// 书架组件是客户端组件，这里把详情弹窗要用的文字预先格式化好：
// 字数按语系换算（中日韩用「万」，其它用「千」），评分是 0~1000 的推荐值
const lang = (siteConfig.lang || "zh_cn").toLowerCase();
const useWan = /^(zh|ja|ko)/.test(lang);
const wordTemplate = i18n(I18nKey.booksWordCount);
const scoreTemplate = i18n(I18nKey.booksScore);
const ratingTemplate = i18n(I18nKey.booksRatingCount);
// 韩语的「万」是 만，其它 CJK 语系直接用「万」
const countUnit = lang.startsWith("ko") ? "만" : "万";

function formatWords(count: number): string {
	if (!count) return "";
	const n = useWan
		? (count / 10000).toFixed(1)
		: Math.round(count / 1000).toString();
	return wordTemplate.replace("{n}", n);
}

function formatScore(rating: number): string {
	if (!rating) return "";
	return scoreTemplate.replace("{n}", (rating / 100).toFixed(1));
}

// 「2376人评分」；上万折成「15.5万人评分」，没有人数就返回空串
function formatRatingCount(count: number): string {
	if (!count) return "";
	let text = String(count);
	if (count >= 10000) {
		text = useWan
			? `${(count / 10000).toFixed(1)}${countUnit}`
			: `${Math.round(count / 1000)}k`;
	}
	return ratingTemplate.replace("{n}", text);
}

// 封面图在微信读书的图床，提前建连，书架首图少一次 DNS + TLS 握手
const coverOrigin = (() => {
	const cover = books.find((book) => book.cover)?.cover;
	if (!cover) return "";
	try {
		return new URL(cover).origin;
	} catch {
		return "";
	}
})();

const shelfBooks = books.map((book) => ({
	id: book.id,
	title: book.title,
	author: book.author,
	cover: book.cover,
	link: book.link,
	status: book.status,
	intro: book.intro,
	wordsText: formatWords(book.wordCount),
	scoreText: formatScore(book.rating),
	ratingLabel: formatRatingCount(book.ratingCount),
}));

// 顶部的三项阅读概览（日均 / 本月 / 累计），缺数据时整块不渲染
const statItems = stats
	? [
			{
				label: i18n(I18nKey.booksDailyAverage),
				value: formatMinutes(stats.monthDailyAverage),
				unit: "min",
			},
			{
				label: i18n(I18nKey.booksThisMonth),
				value: formatHours(stats.monthReadTime),
				unit: "h",
			},
			{
				label: i18n(I18nKey.booksAllTime),
				value: formatHours(stats.totalReadTime),
				unit: "h",
			},
		]
	: [];

// 热力图：月份 / 星期短名按站点语言在构建时算好，避免客户端 locale 不一致
const intlLocale =
	lang === "zh_cn"
		? "zh-CN"
		: lang === "zh_tw"
			? "zh-TW"
			: lang.startsWith("ja")
				? "ja-JP"
				: lang.startsWith("ko")
					? "ko-KR"
					: lang.startsWith("ru")
						? "ru-RU"
						: "en-US";

// 俄语等语言的短名会带结尾句点，去掉统一一点
const trimDot = (text: string) => text.replace(/\.$/, "");

const monthLabels = Array.from({ length: 12 }, (_, month) =>
	trimDot(
		new Intl.DateTimeFormat(intlLocale, { month: "short" }).format(
			new Date(Date.UTC(2024, month, 1)),
		),
	),
);

// 2024-01-07 是周日，往后 7 天正好是周日 → 周六
const weekdayLabels = Array.from({ length: 7 }, (_, day) =>
	trimDot(
		new Intl.DateTimeFormat(intlLocale, { weekday: "short" }).format(
			new Date(Date.UTC(2024, 0, 7 + day)),
		),
	),
);

const heatmap = wereadConfig.showHeatmap === false ? null : data.calendar;
---

<MainGridLayout title={title} description={description}>
	{
		coverOrigin && (
			<link rel="preconnect" href={coverOrigin} slot="head" />
		)
	}
	{
		coverOrigin && (
			<link rel="dns-prefetch" href={coverOrigin} slot="head" />
		)
	}
	<section class="page-shell books-page">
		<div class="books-hero card-base">
			{
				statItems.length > 0 && (
					<div class="books-hero-stats">
						{statItems.map((item) => (
							<div class="books-hero-stat">
								<span class="books-hero-stat-label">{item.label}</span>
								<span class="books-hero-stat-value">
									{item.value}
									{item.unit && <small>{item.unit}</small>}
								</span>
							</div>
						))}
					</div>
				)
			}

			{
				heatmap && (
					<ReadingHeatmap
						client:load
						years={heatmap.years}
						days={heatmap.days}
						months={monthLabels}
						weekdays={weekdayLabels}
						title={i18n(I18nKey.booksHeatmap)}
						lessLabel={i18n(I18nKey.booksHeatmapLess)}
						moreLabel={i18n(I18nKey.booksHeatmapMore)}
						summaryTemplate={i18n(I18nKey.booksHeatmapSummary)}
						emptyLabel={i18n(I18nKey.booksHeatmapEmpty)}
					/>
				)
			}
		</div>

		<div class="books-section card-base">
			<div class="books-section-head">
				<h3>{i18n(I18nKey.booksShelf)}</h3>
			</div>

			<Bookshelf3D
				client:load
				books={shelfBooks}
				readingLabel={i18n(I18nKey.booksReading)}
				readLabel={i18n(I18nKey.booksReadCount)}
				finishedLabel={i18n(I18nKey.booksFinished)}
				openLabel={i18n(I18nKey.booksOpen)}
				emptyLabel={i18n(I18nKey.booksEmpty)}
			/>
		</div>
	</section>
</MainGridLayout>
