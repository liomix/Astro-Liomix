---
import BooknavPage from "@/features/catalog/booknav/components/BooknavPage.astro";
import { loadBooknavPageData } from "@/features/catalog/booknav/lib/load";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/shared/config/siteConfig";

// 页面开关：关掉时 sitemap 也已过滤，这里统一跳 404
if (!siteConfig.pages.booknav) {
	return Astro.redirect("/404/");
}

const pageData = await loadBooknavPageData();
---

<MainGridLayout title={pageData.title} description={pageData.description}>
  <BooknavPage {...pageData} />
</MainGridLayout>
