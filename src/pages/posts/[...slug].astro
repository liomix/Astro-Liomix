---
import { render } from "astro:content";
import PostDetail from "@/features/post/components/PostDetail.astro";
import PostHeadMeta from "@/features/post/components/PostHeadMeta.astro";
import { buildPostPagePayload } from "@/features/post/lib/post-page-data";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import KatexManager from "@/shared/components/integrations/KatexManager.astro";
import {
	getRelatedPosts,
	getSeriesPosts,
	getSortedPosts,
} from "@/shared/lib/content/content-utils";
import { removeFileExtension } from "@/shared/lib/seo/url";
import "@/shared/styles/banner/banner-post.css";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => ({
		// 路由参数去掉扩展名，与站内链接生成规则一致
		params: { slug: removeFileExtension(entry.id) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const payload = await buildPostPagePayload({
	entry,
	pageUrl: Astro.url.toString(),
	wordCount: remarkPluginFrontmatter.words,
});

const relatedPosts = await getRelatedPosts(entry, 5);
const seriesData = await getSeriesPosts(entry);

const bannerPostMeta = {
	title: entry.data.title,
	description: entry.data.description,
	published: entry.data.published,
	updated: entry.data.updated,
	words: remarkPluginFrontmatter.words,
	minutes: remarkPluginFrontmatter.minutes,
};

const { coverImage, jsonLd } = payload;
---

<MainGridLayout
  title={entry.data.title}
  description={entry.data.description || entry.data.title}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCoverImage={coverImage?.url}
  postCategory={entry.data.category || undefined}
  ogImageWidth={coverImage?.width}
  ogImageHeight={coverImage?.height}
  ogImageAlt={entry.data.title}
  headings={headings}
  encrypted={!!entry.data.password}
  bannerPostMeta={bannerPostMeta}
>
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />

  <PostHeadMeta slot="head" entry={entry} jsonLd={jsonLd} />

  <PostDetail
    entry={entry}
    Content={Content}
    remarkPluginFrontmatter={remarkPluginFrontmatter as { words: number; minutes: number }}
    payload={payload}
    relatedPosts={relatedPosts}
    seriesData={seriesData}
    pageUrl={Astro.url.href}
  />
</MainGridLayout>
