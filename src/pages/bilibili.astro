---
import BilibiliPage from "@/features/catalog/bilibili/components/BilibiliPage.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/shared/config/siteConfig";
import I18nKey from "@/shared/i18n/i18nKey";
import { i18n } from "@/shared/i18n/translation";

// 页面开关：关掉时 sitemap 也已过滤，这里统一跳 404
if (!siteConfig.pages.bilibili) {
	return Astro.redirect("/404/");
}
---

<MainGridLayout title={i18n(I18nKey.bilibili)} description={i18n(I18nKey.bilibiliSubtitle)}>
  <BilibiliPage />
</MainGridLayout>
