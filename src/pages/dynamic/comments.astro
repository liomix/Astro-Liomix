---
/**
 * 评论抽屉的内容页（也支持直接访问）
 * ---------------------------------------------------------------------------
 * 页面里自带全部东西：壁纸、顶栏、消息区、输入栏 —— 全在同一个 document 里。
 * 这是「顶栏和底栏用壁纸的高斯模糊」能成立的前提：backdrop-filter 只采样同一个
 * document 里画在它下面的东西，跨 iframe 是采不到的。父窗口那层抽屉因此只剩外壳。
 */
import Comment from "@/components/features/comment/Comment.astro";
import { dynamicConfig, profileConfig, siteConfig } from "@/config";
import { commentApiConfig } from "@/config/commentApiConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import CommentLayout from "@/layouts/CommentLayout.astro";
// 只引这一页自己的样式：聊天与身份弹窗的样式由 Comment 组件自带
import "@/styles/pages/dynamic-comments.css";

// 接口关掉时这一页没有意义：入口（动态卡片上的评论按钮）也随之消失，
// 留下一个空壳只会被当成故障
if (
	!siteConfig.pages.dynamic ||
	dynamicConfig.showComment === false ||
	!commentApiConfig.enable
) {
	return Astro.redirect("/404/");
}

// 评论地址（?path=）这里故意不读：这一页是预渲染的静态路由，构建期拿不到查询
// 参数，真正的值由 Comment 的脚本从地址栏补写到 [data-tg-chat] 上，再算成
// 后端认的 slug。挂在这里的默认值只决定「直接打开 /dynamic/comments/ 时聊哪个线程」

// 顶栏现在展示的是「访客的评论身份」，默认值取站点昵称 + Email 链接：
// 没设置过的访客点开弹窗就是预填好的这两条，改成自己的保存一次才解锁输入框。
// 头像不再用站点头像 —— 它由邮箱算（QQ 邮箱取 qlogo，其余用昵称首字）
const contact = (
	profileConfig.links.find((link) => link.name.toLowerCase() === "email")
		?.url || ""
).replace(/^mailto:/, "");
---

<CommentLayout title={dynamicConfig.title || "Comments"}>
	<main class="page-comment-embed">
		<Comment
			name={profileConfig.name}
			contact={contact}
			closeLabel={i18n(I18nKey.tabClose)}
		/>
	</main>
</CommentLayout>

<script>
	import {
		applyWallpaperTint,
		setChatWallpaper,
	} from "@/components/features/comment/comment-wallpaper.ts";

	window.addEventListener("message", (event) => {
		if (event.origin !== window.location.origin) return;

		if (event.data?.type === "dynamic-comment-theme") {
			document.documentElement.classList.toggle(
				"dark",
				Boolean(event.data.dark),
			);
			document.documentElement.dataset.theme = event.data.dark
				? "dark"
				: "light";
			// 主题色相也跟着换：iframe 是独立文档，父窗口改 --hue 不会自动传进来
			if (event.data.hue) {
				document.documentElement.style.setProperty(
					"--hue",
					String(event.data.hue),
				);
			}
			// 垫底色只在浅色下有意义：切深浅时重算一次，免得留着一份过期的浅色底
			applyWallpaperTint();
			return;
		}

		// 换了一条动态看评论：抽屉里是同一个预渲染页面，父窗口只把 path 递过来，
		// 不重载文档（重载等于白屏几百毫秒）。切换线程的逻辑收在聊天组件自己身上
		// —— 它要据此重新拉评论，这里再写一遍会变成两份状态

		// 父窗口（设置面板）换了评论区壁纸：壁纸画在本文档里，只能由这边换
		if (event.data?.type === "dynamic-comment-wallpaper" && event.data.id) {
			setChatWallpaper(String(event.data.id));
		}
	});
</script>
