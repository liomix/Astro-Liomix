---
import TelegramChat from "@/components/pages/dynamic/TelegramChat.astro";
import { dynamicConfig, siteConfig } from "@/config";
import CommentLayout from "@/layouts/CommentLayout.astro";
import "@/styles/pages/dynamic-comments.css";
import "@/styles/pages/telegram-chat.css";

if (!siteConfig.pages.dynamic || dynamicConfig.showComment === false) {
	return Astro.redirect("/404/");
}

// 抽屉用 ?path= 传入当前动态的评论地址；现在消息是内置示例，
// 这个值只挂到 root 的 data 属性上，等接了真实数据源再按它拉取
const commentPath = Astro.url.searchParams.get("path") || "/dynamic/";
---

<CommentLayout title={dynamicConfig.title || "Comments"}>
	<main class="page-comment-embed">
		<TelegramChat path={commentPath} />
	</main>
</CommentLayout>

<script>
	window.addEventListener("message", (event) => {
		if (
			event.origin !== window.location.origin ||
			event.data?.type !== "dynamic-comment-theme"
		) {
			return;
		}
		document.documentElement.classList.toggle("dark", Boolean(event.data.dark));
		document.documentElement.dataset.theme = event.data.dark ? "dark" : "light";
	});
</script>
