---
import DynamicFeed from "@/features/dynamic/components/DynamicFeed.svelte";
import DynamicItemTemplate from "@/features/dynamic/components/DynamicItemTemplate.astro";
import { dynamicConfig } from "@/features/dynamic/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/shared/config/siteConfig";
import I18nKey from "@/shared/i18n/i18nKey";
import { i18n } from "@/shared/i18n/translation";
import { commentApiConfig } from "@/shared/lib/comments/config";
import "@/shared/styles/common.css";
import "@/features/dynamic/styles/dynamic.css";
import { url } from "@/shared/lib/seo/url";

if (!siteConfig.pages.dynamic) {
	return Astro.redirect("/404/");
}

const title = dynamicConfig.title || i18n(I18nKey.dynamic);
const description =
	dynamicConfig.description || i18n(I18nKey.dynamicDescription);
const itemsPerPage = Math.max(1, dynamicConfig.itemsPerPage ?? 10);
// 评论区是抽屉里那套 Telegram 风格聊天界面（消息来自自建评论接口），不再依赖
// 第三方评论服务。两个开关都要打开：dynamicConfig.showComment 是站点层面的展示
// 开关，commentApiConfig.enable 是接口层的总闸 —— 接口关掉时留一颗点开只会看到
// 「评论功能已关闭」的按钮，不如不显示
const showComments =
	dynamicConfig.showComment !== false && commentApiConfig.enable;
const dataUrl = dynamicConfig.apiUrl?.startsWith("http")
	? dynamicConfig.apiUrl
	: url(dynamicConfig.apiUrl || "/api/dynamic.json");
const memos = dynamicConfig.memos;
---

<MainGridLayout title={title} description={description}>
	<section class="page-shell">
		<div>
			{/* 页头只剩三项统计：动态 / 获赞 / 评论。
			   数字由 DynamicFeed 在全量数据到位后写入（获赞含访客自己点的赞） */}
			<ul class="page-hero-stats card-base">
				<li class="page-hero-stat">
					<span class="page-hero-stat-value" data-dynamic-stat="posts">0</span>
					<span class="page-hero-stat-label">{i18n(I18nKey.dynamic)}</span>
				</li>
				<li class="page-hero-stat">
					<span class="page-hero-stat-value" data-dynamic-stat="likes">0</span>
					<span class="page-hero-stat-label">{i18n(I18nKey.dynamicLikes)}</span>
				</li>
				<li class="page-hero-stat">
					<span class="page-hero-stat-value" data-dynamic-stat="comments">0</span>
					<span class="page-hero-stat-label">{i18n(I18nKey.dynamicComments)}</span>
				</li>
			</ul>

			<DynamicFeed
				client:load
				source={dataUrl}
				{itemsPerPage}
				showComments={showComments}
				commentEmptyText={i18n(I18nKey.commentNotConfigured)}
				failedText={i18n(I18nKey.dynamicLoadFailed)}
				emptyText={i18n(I18nKey.dynamicEmpty)}
				noResultsText={i18n(I18nKey.dynamicNoResults)}
				loadingText={i18n(I18nKey.dynamicLoading)}
				allYearsText={i18n(I18nKey.dynamicAllYears)}
				{memos}
			/>

			<DynamicItemTemplate />
		</div>
	</section>
</MainGridLayout>
