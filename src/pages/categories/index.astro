---
import { Icon } from "astro-icon/components";
import CategoryRoseChart from "@/components/misc/CategoryRoseChart.svelte";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList } from "@/utils/content-utils";

const categories = await getCategoryList();

const chartItems = categories.map((category) => ({
	name: category.name.trim(),
	count: category.count,
}));
---

<MainGridLayout
    title={i18n(I18nKey.categories)}
    description={i18n(I18nKey.allCategories)}
>
    <!-- 分类统计玫瑰图 -->
    {chartItems.length > 0 && (
        <div class="mb-4">
            <CategoryRoseChart client:visible items={chartItems} />
        </div>
    )}

    <!-- 全部分类 -->
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="flex flex-wrap gap-2.5">
                {categories.map((c) => (
                    <a href={c.url}
                       class="tag-item group inline-flex items-center gap-1.5
                              text-sm font-medium px-3 py-1.5 transition-all duration-200"
                    >
                        <span>
                            {c.name.trim()}
                        </span>
                        <span class="tag-count-badge text-xs font-bold px-1.5
                                     min-w-[1.5rem] text-center">
                            {c.count}
                        </span>
                    </a>
                ))}
            </div>
        </div>
    </div>

    <!-- 空状态 -->
    {
        categories.length === 0 && (
            <div class="card-base px-8 py-12 text-center">
                <Icon
                    name="material-symbols:folder-off"
                    class="text-5xl text-30 mx-auto mb-4"
                />
                <p class="text-30">{i18n(I18nKey.noData)}</p>
            </div>
        )
    }
</MainGridLayout>
