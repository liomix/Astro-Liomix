---
/**
 * 标签篇数柱状图（标签页顶部）
 * 纯 CSS 绘制，无第三方图表库：柱子按 count 占刻度比例定位，最高/最低各常显一个数值气泡，
 * 其余柱子 hover 时显示气泡；虚线为网格与平均值参考线
 */
interface ChartItem {
	name: string;
	count: number;
	href: string;
}

interface Props {
	items: ChartItem[];
	title: string;
	averageLabel: string;
}

const { items, title, averageLabel } = Astro.props;

const counts = items.map((item) => item.count);
const peak = counts.length > 0 ? Math.max(...counts) : 1;

// 取「刻度数 ≤ 5」的最小步长，刻度值保持整数好看
const stepCandidates = [1, 2, 3, 5, 10, 15, 20, 30, 50, 100];
const step =
	stepCandidates.find((candidate) => Math.ceil(peak / candidate) <= 5) ??
	stepCandidates[stepCandidates.length - 1];
const maxTick = Math.max(Math.ceil(peak / step) * step, step);
const ticks = Array.from(
	{ length: Math.round(maxTick / step) + 1 },
	(_, index) => index * step,
);

// 气泡只常显「一个最高 + 一个最低」（同 ECharts markPoint 的 max/min 语义），避免并列值挤成一排
const peakIndex = counts.indexOf(peak);
const lowIndex = counts.indexOf(Math.min(...counts));

const total = counts.reduce((sum, count) => sum + count, 0);
const average = items.length > 0 ? total / items.length : 0;
const averageText =
	Number.isInteger(average) ? String(average) : average.toFixed(1);

const ratio = (value: number) => `${(value / maxTick) * 100}%`;
---

<div class="tag-chart card-base">
	<div class="tag-chart-head">
		<span class="tag-chart-title">{title}</span>
	</div>

	<div class="tag-chart-body">
		<div class="tag-chart-plot">
			<div class="tag-chart-y" aria-hidden="true">
				{
					ticks.map((tick) => (
						<span class="tag-chart-y-label" style={`bottom:${ratio(tick)}`}>
							{tick}
						</span>
					))
				}
			</div>

			<div class="tag-chart-grids" aria-hidden="true">
				{ticks.map((tick) => <span class="tag-chart-grid" style={`bottom:${ratio(tick)}`} />)}
				<div class="tag-chart-avg" style={`bottom:${ratio(average)}`}>
					<span class="tag-chart-avg-label">{averageLabel} {averageText}</span>
				</div>
			</div>

			<div class="tag-chart-bars" role="list">
				{
					items.map((item, index) => {
						const showBubble = index === peakIndex || index === lowIndex;
						return (
							<a
								class="tag-chart-col"
								href={item.href}
								role="listitem"
								style={`--bar-h:${ratio(item.count)}`}
								data-bubble={showBubble ? "always" : undefined}
								title={`${item.name} · ${item.count}`}
							>
								<span class="tag-chart-track">
									<span class="tag-chart-bar" />
									<span class="tag-chart-bubble">{item.count}</span>
								</span>
								<span class="tag-chart-name">{item.name}</span>
							</a>
						);
					})
				}
			</div>
		</div>
	</div>
</div>

<style>
	.tag-chart {
		/* plot-top 留给最高柱的气泡，plot-right 留给平均值标签，都是不画网格的留白 */
		--chart-h: 12.5rem;
		--plot-top: 1.75rem;
		--plot-right: 3.9rem;
		/* 刻度/标签/平均线文字色：--deep-text 在暗色下仍是深色，这里按主题显式翻转 */
		--chart-axis: rgba(0, 0, 0, 0.42);
		--chart-name: rgba(0, 0, 0, 0.55);
		--chart-avg: rgba(0, 0, 0, 0.5);
		position: relative;
		padding: 1.25rem 1.5rem 1rem;
		background:
			radial-gradient(
				120% 130% at 0% 0%,
				color-mix(in oklch, var(--primary) 10%, transparent),
				transparent 62%
			),
			var(--card-bg);
		border: 1px solid color-mix(in oklch, var(--primary) 12%, transparent);
	}

	:global(.dark) .tag-chart {
		--chart-axis: rgba(255, 255, 255, 0.45);
		--chart-name: rgba(255, 255, 255, 0.58);
		--chart-avg: rgba(255, 255, 255, 0.55);
	}

	.tag-chart-head {
		display: flex;
		align-items: center;
		margin-bottom: 0.5rem;
	}

	.tag-chart-title {
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1;
		padding: 0.375rem 0.75rem;
		border-radius: var(--radius-full);
		color: var(--btn-content);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}

	.tag-chart-body {
		position: relative;
		padding-left: 1.75rem;
	}

	/* Y 轴刻度与网格线同一套 bottom 百分比，贴着绘图区左侧留白 */
	.tag-chart-y {
		position: absolute;
		top: var(--plot-top);
		bottom: 0;
		right: 100%;
		width: 1.75rem;
		pointer-events: none;
	}

	.tag-chart-y-label {
		position: absolute;
		right: 0.5rem;
		transform: translateY(50%);
		font-size: 0.6875rem;
		line-height: 1;
		color: var(--chart-axis);
		font-variant-numeric: tabular-nums;
	}

	/* 绘图区：高度 = 顶部气泡留白 + 柱体高度；标签行靠 margin-bottom 留在下方 */
	.tag-chart-plot {
		position: relative;
		height: calc(var(--plot-top) + var(--chart-h));
		margin-bottom: 2.4rem;
	}

	.tag-chart-grids {
		position: absolute;
		inset: var(--plot-top) 0 0 0;
		pointer-events: none;
	}

	.tag-chart-grid {
		position: absolute;
		left: 0;
		right: 0;
		height: 0;
		border-top: 1px dashed color-mix(in oklch, var(--primary) 22%, transparent);
	}

	/* 平均值参考线：比网格线明显一档，标签落在右侧留白里，不压柱子 */
	.tag-chart-avg {
		position: absolute;
		left: 0;
		right: 0;
		height: 0;
		/* 压在柱子之上（ECharts markLine 同层语义），网格线仍留在柱子后面 */
		z-index: 3;
		border-top: 1px dashed color-mix(in oklch, var(--primary) 55%, transparent);
	}

	.tag-chart-avg-label {
		position: absolute;
		right: 0.125rem;
		bottom: 0.125rem;
		font-size: 0.6875rem;
		line-height: 1.3;
		white-space: nowrap;
		text-align: right;
		color: var(--chart-avg);
		font-variant-numeric: tabular-nums;
	}

	.tag-chart-bars {
		position: absolute;
		inset: var(--plot-top) var(--plot-right) 0 0;
		display: flex;
		align-items: flex-end;
		gap: 0.25rem;
	}

	.tag-chart-col {
		position: relative;
		display: flex;
		flex: 1 1 0;
		flex-direction: column;
		justify-content: flex-end;
		height: 100%;
		min-width: 0;
		text-decoration: none;
	}

	.tag-chart-track {
		position: relative;
		display: flex;
		flex: 1 1 auto;
		align-items: flex-end;
		justify-content: center;
		min-height: 0;
	}

	.tag-chart-bar {
		width: min(1.5rem, 76%);
		height: var(--bar-h);
		border-radius: 0.4rem 0.4rem 2px 2px;
		background: linear-gradient(
			180deg,
			color-mix(in oklch, var(--primary) 42%, var(--card-bg)),
			var(--primary)
		);
		transition:
			filter 0.2s ease,
			background 0.2s ease;
	}

	.tag-chart-col:hover .tag-chart-bar,
	.tag-chart-col:focus-visible .tag-chart-bar {
		background: linear-gradient(
			180deg,
			color-mix(in oklch, var(--primary) 86%, var(--card-bg)),
			color-mix(in oklch, var(--primary) 78%, black)
		);
	}

	/* 数值气泡：最高/最低常显，其余 hover 出现 */
	.tag-chart-bubble {
		position: absolute;
		bottom: calc(var(--bar-h) + 0.4rem);
		left: 50%;
		translate: -50% 0;
		padding: 0.0625rem 0.375rem;
		font-size: 0.6875rem;
		font-weight: 600;
		line-height: 1.35;
		font-variant-numeric: tabular-nums;
		color: var(--card-bg);
		background: var(--btn-content);
		border-radius: var(--radius-md);
		box-shadow: 0 2px 6px -2px color-mix(in oklch, var(--btn-content) 60%, transparent);
		white-space: nowrap;
		opacity: 0;
		transition: opacity 0.18s ease;
		pointer-events: none;
	}

	.tag-chart-bubble::after {
		content: "";
		position: absolute;
		top: 100%;
		left: 50%;
		translate: -50% 0;
		border: 3px solid transparent;
		border-top-color: var(--btn-content);
	}

	.tag-chart-col[data-bubble="always"] .tag-chart-bubble,
	.tag-chart-col:hover .tag-chart-bubble,
	.tag-chart-col:focus-visible .tag-chart-bubble {
		opacity: 1;
	}

	/* 标签名挂在锚点下方（仍属于锚点，hover 整列都能点亮柱子） */
	.tag-chart-name {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		margin-top: 0.5rem;
		padding-inline: 0.125rem;
		font-size: 0.6875rem;
		line-height: 1.2;
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--chart-name);
		transition: color 0.18s ease;
	}

	.tag-chart-col:hover .tag-chart-name,
	.tag-chart-col:focus-visible .tag-chart-name {
		color: var(--primary);
	}

	@media (max-width: 767px) {
		.tag-chart {
			--chart-h: 9.5rem;
			--plot-right: 2.6rem;
			padding: 1rem 0.875rem 0.75rem;
		}
		.tag-chart-body {
			padding-left: 1.25rem;
		}
		.tag-chart-y {
			width: 1.25rem;
		}
		.tag-chart-y-label {
			right: 0.25rem;
			font-size: 0.625rem;
		}
		.tag-chart-bar {
			width: min(1.125rem, 80%);
		}
		.tag-chart-bars {
			gap: 0.125rem;
		}
		.tag-chart-name {
			font-size: 0.5625rem;
		}
		.tag-chart-avg-label {
			font-size: 0.5625rem;
		}
	}
</style>
