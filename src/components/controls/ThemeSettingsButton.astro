---
import FloatingButton from "@/components/common/FloatingButton.astro";
---

<FloatingButton
  id="display-settings-floating"
  icon="material-symbols:palette-outline"
  ariaLabel="主题设置"
  onclick="__toggleThemeSettingsFloating()"
/>

<script>
  type WindowWithSettingsToggle = Window & {
    __toggleThemeSettingsFloating?: () => void;
  };

  const settingsWindow = window as WindowWithSettingsToggle;
  const PANEL_ID = "display-setting";
  const TRIGGER_ID = "display-settings-floating";
  // 面板与按钮之间的空隙、距离视口边缘的最小留白
  const PANEL_GAP = 12;
  const VIEWPORT_MARGIN = 8;

  // 面板在 <body> 下、固定定位：右边缘与按钮右边缘对齐，底部落在按钮上方，向上展开。
  // 悬浮按钮数量会随页面变化（TOC/沉浸阅读/返回顶部等），所以按按钮实际 rect 算，不写死。
  function positionThemePanel(): void {
    const panel = document.getElementById(PANEL_ID);
    const trigger = document.getElementById(TRIGGER_ID);
    if (!panel || !trigger) return;

    const rect = trigger.getBoundingClientRect();
    // 按钮被隐藏（收起/不可见）时保留上次位置，避免面板跳到左上角
    if (rect.width === 0 && rect.height === 0) return;

    const viewportWidth =
      document.documentElement.clientWidth || window.innerWidth;
    const viewportHeight = window.innerHeight;

    panel.style.right = `${Math.max(VIEWPORT_MARGIN, viewportWidth - rect.right)}px`;
    panel.style.bottom = `${Math.max(VIEWPORT_MARGIN, viewportHeight - rect.top + PANEL_GAP)}px`;
    panel.style.left = "auto";
    panel.style.top = "auto";

    // 面板高于按钮上方的可用空间时压缩高度（内容区自己滚动）
    const available = rect.top - PANEL_GAP - VIEWPORT_MARGIN * 2;
    panel.style.maxHeight = `${Math.max(
      160,
      Math.min(available, viewportHeight - VIEWPORT_MARGIN * 2),
    )}px`;
  }

  // 打开/关闭主题设置面板（#display-setting，组件挂载后会把面板移到 <body> 下）；
  // 只切 class，面板的 inert / aria-expanded 由 floating-panel-utils 观察 class 变化后同步。
  if (!settingsWindow.__toggleThemeSettingsFloating) {
    settingsWindow.__toggleThemeSettingsFloating = () => {
      const panel = document.getElementById(PANEL_ID);
      if (!panel) return;
      // 打开前先对准按钮当前位置
      if (panel.classList.contains("float-panel-closed")) positionThemePanel();
      panel.classList.toggle("float-panel-closed");
    };

    // 窗口尺寸/缩放变化时，已打开的面板跟着按钮重新贴合
    window.addEventListener("resize", () => {
      const panel = document.getElementById(PANEL_ID);
      if (panel && !panel.classList.contains("float-panel-closed")) {
        positionThemePanel();
      }
    });
  }
</script>
