---
import { Icon } from "astro-icon/components";
import { displaySettingsConfig, musicPlayerConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

// 只有对应面板真的会渲染时才给出入口，避免点进去空无一物
const hasThemeSettings = displaySettingsConfig.enable;
const hasPlaybackSettings =
	musicPlayerConfig.showInNavbar === true ||
	musicPlayerConfig.showInSidebar !== false;
---

<div
  id="settings-menu"
  class="float-panel settings-menu float-panel-closed"
  data-floating-panel
  data-floating-panel-trigger="settings-floating"
  inert
  aria-hidden="true"
>
  <div class="settings-menu-head">
    <Icon name="material-symbols:tune-rounded" class="settings-menu-head-icon" aria-hidden="true" />
    <span>{i18n(I18nKey.settings)}</span>
  </div>

  {hasThemeSettings && (
    <button
      type="button"
      class="settings-menu-item"
      onclick="__settingsOpenPanel('display-setting')"
    >
      <span class="settings-menu-item-icon">
        <Icon name="material-symbols:palette-outline" aria-hidden="true" />
      </span>
      <span class="settings-menu-item-label">{i18n(I18nKey.settingsTheme)}</span>
      <Icon name="material-symbols:chevron-right-rounded" class="settings-menu-item-chevron" aria-hidden="true" />
    </button>
  )}

  {hasPlaybackSettings && (
    <button
      type="button"
      class="settings-menu-item"
      onclick="__settingsOpenPanel('playback-setting')"
    >
      <span class="settings-menu-item-icon">
        <Icon name="material-symbols:headphones-rounded" aria-hidden="true" />
      </span>
      <span class="settings-menu-item-label">{i18n(I18nKey.settingsPlayback)}</span>
      <Icon name="material-symbols:chevron-right-rounded" class="settings-menu-item-chevron" aria-hidden="true" />
    </button>
  )}
</div>

<script>
  // 面板相对视口定位：挂到 <body> 下，避免被布局里的 transform / pointer-events 影响
  const menu = document.getElementById("settings-menu");
  if (menu && menu.parentElement !== document.body) {
    document.body.appendChild(menu);
  }
</script>

<style>
  #settings-menu {
    position: fixed;
    right: 1rem;
    bottom: 5.25rem;
    left: auto;
    top: auto;
    z-index: 1100;
    width: 15.5rem;
    max-width: calc(100vw - 2rem);
    padding: 0.375rem;
    pointer-events: auto;
  }

  .settings-menu-head {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.625rem 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: inherit;
    opacity: 0.6;
  }

  .settings-menu-head-icon {
    font-size: 1rem;
  }

  .settings-menu-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.5rem 0.625rem;
    border-radius: 0.75rem;
    text-align: left;
    transition: background-color 0.18s var(--ease-standard);
  }

  .settings-menu-item:hover {
    background-color: var(--btn-plain-bg-hover);
  }

  .settings-menu-item-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 0.625rem;
    font-size: 1.15rem;
    color: var(--primary);
    background-color: color-mix(in oklch, var(--primary) 12%, transparent);
    transition: background-color 0.18s var(--ease-standard);
  }

  .settings-menu-item:hover .settings-menu-item-icon {
    background-color: color-mix(in oklch, var(--primary) 20%, transparent);
  }

  .settings-menu-item-label {
    flex: 1;
    min-width: 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: oklch(0.2 0.02 var(--hue));
  }

  :global(.dark) .settings-menu-item-label {
    color: oklch(0.96 0.02 var(--hue));
  }

  .settings-menu-item-chevron {
    flex-shrink: 0;
    font-size: 1.1rem;
    color: inherit;
    opacity: 0.45;
    transition:
      opacity 0.18s var(--ease-standard),
      transform 0.18s var(--ease-standard);
  }

  .settings-menu-item:hover .settings-menu-item-chevron {
    opacity: 0.9;
    transform: translateX(2px);
  }
</style>
