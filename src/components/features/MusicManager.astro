---
import { musicPlayerConfig } from "@/config/musicConfig";
import { siteConfig } from "@/config/siteConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

const config = musicPlayerConfig;

const isFullUrl = (path: string) => /^https?:\/\//.test(path);

// 缺省封面：没配、或配置里写了空串时，用一张内置的唱片图兜底
const DEFAULT_COVER = "/assets/music/cover/default.svg";
const defaultCover = url(
	config.defaultCover && config.defaultCover !== ""
		? config.defaultCover
		: DEFAULT_COVER,
);

const localPlaylist =
	config.mode === "local" && config.local?.playlist
		? config.local.playlist.map((song) => {
				return {
					name: song.name,
					artist: song.artist,
					url: isFullUrl(song.url) ? song.url : url(song.url),
					// 曲目自己没写 cover 就用缺省封面；同时标记「可以去文件里找内嵌封面」，
					// 找到后由 manager 覆盖成 blob URL（见下方 resolveEmbeddedCover）
					pic: song.cover
						? isFullUrl(song.cover)
							? song.cover
							: url(song.cover)
						: defaultCover,
					embeddedCover: !song.cover,
					lrc: song.lrc
						? isFullUrl(song.lrc)
							? song.lrc
							: url(song.lrc)
						: undefined,
				};
			})
		: [];

const managerConfigStr = JSON.stringify({
	siteTitle: siteConfig.title,
	mode: config.mode,
	meting: config.meting,
	localPlaylist: localPlaylist,
	defaultCover: defaultCover,
	volume: config.volume ?? 0.7,
	playMode: config.playMode ?? "list",
	autoPlay: config.autoPlay === true,
	showLyrics: config.showLyrics ?? true,
	i18n: {
		noPlaying: i18n(I18nKey.musicNoPlaying),
		lyrics: i18n(I18nKey.musicLyrics),
		volume: i18n(I18nKey.musicVolume),
		playMode: i18n(I18nKey.musicPlayMode),
		prev: i18n(I18nKey.musicPrev),
		next: i18n(I18nKey.musicNext),
		playlist: i18n(I18nKey.musicPlaylist),
		noLyrics: i18n(I18nKey.musicNoLyrics),
		loadingLyrics: i18n(I18nKey.musicLoadingLyrics),
		failedLyrics: i18n(I18nKey.musicFailedLyrics),
		noSongs: i18n(I18nKey.musicNoSongs),
		error: i18n(I18nKey.musicError),
		play: i18n(I18nKey.musicPlay),
		pause: i18n(I18nKey.musicPause),
		progress: i18n(I18nKey.musicProgress),
		noCover: i18n(I18nKey.musicNoCover),
	},
});
---

<script is:inline data-swup-ignore-script define:vars={{ managerConfigStr }}>
(function () {
    // Singleton guard – only create once
    if (window.__fireflyMusic) return;

    var config = JSON.parse(managerConfigStr);

    // ── Helpers ──────────────────────────────────────────────
    function formatTime(seconds) {
        if (!seconds || isNaN(seconds)) return '0:00';
        var min = Math.floor(seconds / 60);
        var sec = Math.floor(seconds % 60);
        return min + ':' + (sec < 10 ? '0' : '') + sec;
    }

    function parseLRC(lrc) {
        if (!lrc) return [];
        var lines = lrc.split('\n');
        var result = [];
        var timeReg = /\[(\d{2}):(\d{2})\.(\d{2,3})\]/g;
        lines.forEach(function (line) {
            var matches = Array.from(line.matchAll(timeReg));
            if (matches.length > 0) {
                var text = line.replace(timeReg, '').trim();
                if (text) {
                    matches.forEach(function (match) {
                        var m = parseInt(match[1]);
                        var s = parseInt(match[2]);
                        var ms = parseInt(match[3]);
                        var time = m * 60 + s + ms / (match[3].length === 3 ? 1000 : 100);
                        result.push({ time: time, text: text });
                    });
                }
            }
        });
        return result.sort(function (a, b) { return a.time - b.time; });
    }

    // ── Audio element (persistent, attached to body) ────────
    var audio = document.createElement('audio');
    audio.crossOrigin = 'anonymous';
    audio.style.display = 'none';
    audio.preload = 'none'; // 阻止浏览器预加载和自动恢复播放
    document.body.appendChild(audio);
    audio.pause(); // 确保不自动播放

    // ── State ────────────────────────────────────────────────
    var loadVersion = 0; // incremented on each loadTrack to discard stale play() results
    var state = {
        playlist: [],
        currentIndex: 0,
        isPlaying: false,
        playMode: 0, // 0: list, 1: one, 2: random
        volume: localStorage.getItem('music-player-volume') !== null
            ? parseFloat(localStorage.getItem('music-player-volume'))
            : (config.volume || 0.7),
        isMuted: false,
        // 播放速度：设置面板选过的值会记住，浏览器刷新后仍生效
        playbackRate: (function () {
            var stored = parseFloat(localStorage.getItem('music-player-rate'));
            return !isNaN(stored) && stored >= 0.5 && stored <= 2 ? stored : 1;
        })(),
        lyrics: [],
        currentLrcIndex: -1,
        initialized: false,
        initializing: false,
        error: null
    };

    // 播放模式：优先用「播放设置」面板记住的值，其次回落到配置默认
    var storedPlayMode = parseInt(localStorage.getItem('music-player-playmode'), 10);
    if (!isNaN(storedPlayMode) && storedPlayMode >= 0 && storedPlayMode <= 2) {
        state.playMode = storedPlayMode;
    } else if (config.playMode === 'random') state.playMode = 2;
    else if (config.playMode === 'one') state.playMode = 1;
    else state.playMode = 0;

    // 进入站点自动播放：同样先看「播放设置」面板存的选择（"1"/"0"），没有才用配置
    var autoPlayEnabled = (function () {
        var stored = null;
        try {
            stored = localStorage.getItem('music-player-autoplay');
        } catch (e) {
            // 隐私模式读不到就按配置来
        }
        if (stored === '1') return true;
        if (stored === '0') return false;
        return config.autoPlay === true;
    })();

    // ── 播放进度记忆 ─────────────────────────────────────────
    // 只存一条「上次听到哪」：哪首 + 第几秒。进站时据此恢复曲目与位置，
    // 关掉页面再回来不会从 0:00 重来。
    var PROGRESS_KEY = 'music-player-progress';
    var RESUME_MIN_SECONDS = 3; // 不足 3 秒没意义，直接从头
    var RESUME_END_GAP = 3; // 距结尾不足 3 秒当作听完，下次从头开始
    var SAVE_INTERVAL = 4000; // timeupdate 落盘节流

    function readStoredProgress() {
        try {
            var raw = localStorage.getItem(PROGRESS_KEY);
            if (!raw) return null;
            var data = JSON.parse(raw);
            if (!data || typeof data.time !== 'number' || !isFinite(data.time) || data.time < 0) return null;
            return data;
        } catch (e) {
            return null; // 隐私模式 / 脏数据
        }
    }

    // 进站时读一次做快照：只用于本次首次加载，之后各曲目一律从头
    var storedProgress = readStoredProgress();
    // 待恢复的位置：loadTrack 时按曲目匹配，元数据到了再 seek
    var pendingResume = null;
    // 当前 audio 里装着的那首（切歌瞬间 currentIndex 已经变了，存进度要用它）
    var activeTrack = null;

    function trackKey(track) {
        if (!track) return '';
        return track.url || (track.name || '') + '|' + (track.artist || '');
    }

    function isSameTrack(saved, track) {
        if (!saved || !track) return false;
        if (saved.key && saved.key === trackKey(track)) return true;
        // 歌单接口偶尔会换域名/签名，URL 对不上时退回「歌名 + 歌手」
        return !!saved.name && saved.name === (track.name || '') && (saved.artist || '') === (track.artist || '');
    }

    function saveProgress(timeOverride) {
        var track = activeTrack;
        if (!track) return;
        var dur = audio.duration;
        if (!isFinite(dur) || dur <= 0) return;
        var time = typeof timeOverride === 'number' ? timeOverride : audio.currentTime;
        if (!isFinite(time) || time < 0) return;
        if (time > dur - RESUME_END_GAP) time = 0; // 快听完了，下次从头
        try {
            localStorage.setItem(PROGRESS_KEY, JSON.stringify({
                key: trackKey(track),
                name: track.name || '',
                artist: track.artist || '',
                time: Math.round(time * 10) / 10,
                duration: Math.round(dur),
                updatedAt: Date.now()
            }));
        } catch (e) {
            /* 配额满 / 隐私模式：忽略即可，不打扰播放 */
        }
    }

    var lastProgressSave = 0;
    function saveProgressThrottled() {
        var now = Date.now();
        if (now - lastProgressSave < SAVE_INTERVAL) return;
        lastProgressSave = now;
        saveProgress();
    }

    // 关标签页 / 切到后台时补一次，别只靠 timeupdate 的节流
    window.addEventListener('pagehide', function () { saveProgress(); });
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') saveProgress();
    });

    // 浏览器会拦截带声音的自动播放，而且没有任何前端手段能真正绕开：
    // 唯一放行的是「静音自动播放」。所以被拦时退一步——先静音把进度跑起来，
    // 用户第一次点/按时（浏览器认定有用户激活）再自动把声音打开。
    var siteAutoplayAttempt = false;
    var mutedAutoplay = false;
    var autoplayGestureArmed = false;

    // 静音键自己会处理「开/关声音」，首次交互的兜底别去抢（否则刚开又被按回去）
    var AUTOPLAY_SKIP_SELECTOR = '.btn-mute, [data-np-mute]';

    function onAutoplayGesture(event) {
        var target = event.target;
        if (target && target.closest && target.closest(AUTOPLAY_SKIP_SELECTOR)) {
            disarmAutoplayGesture();
            return;
        }
        disarmAutoplayGesture();

        if (mutedAutoplay) {
            // 就在手势这一拍里改 muted，浏览器才认可（Safari 尤为严格）
            mutedAutoplay = false;
            audio.muted = false;
            state.isMuted = false;
            emit('fm:volume', { volume: state.volume, isMuted: false });
            emit('fm:autoplay-muted', { muted: false });
            if (audio.paused) {
                audio.play().catch(function () {
                    // 打不开就等用户自己点播放
                });
            }
            return;
        }

        // 连静音自动播放都没起来：趁这次用户激活，直接出声补播
        if (audio.paused && state.playlist.length > 0) {
            audio.play().then(function () {
                emitPlayState(true, true);
            }).catch(function () {
                // 还是不行就等用户自己点播放
            });
        }
    }

    function armAutoplayGesture() {
        if (autoplayGestureArmed) return;
        autoplayGestureArmed = true;
        ['pointerdown', 'touchstart', 'keydown'].forEach(function (name) {
            document.addEventListener(name, onAutoplayGesture, true);
        });
    }

    function disarmAutoplayGesture() {
        if (!autoplayGestureArmed) return;
        autoplayGestureArmed = false;
        ['pointerdown', 'touchstart', 'keydown'].forEach(function (name) {
            document.removeEventListener(name, onAutoplayGesture, true);
        });
    }

    /** 带声音被拦后的退路：静音起播，等首次交互再开声音 */
    function startMutedAutoplay(ver) {
        if (ver !== loadVersion) return;
        audio.muted = true;
        audio.play().then(function () {
            if (ver !== loadVersion) return;
            mutedAutoplay = true;
            state.isMuted = true;
            emitPlayState(true, true);
            emit('fm:volume', { volume: state.volume, isMuted: true });
            emit('fm:autoplay-muted', { muted: true });
            armAutoplayGesture();
        }).catch(function () {
            // 连静音都被拦（iOS 低电量模式、省流模式等）→ 只能等用户点
            audio.muted = false;
            emitPlayState(false, true);
            armAutoplayGesture();
        });
    }

    /** 用户点播放 / 拖音量 / 点静音，都算主动接管，静音兜底立即作废 */
    function takeOverMutedAutoplay() {
        if (!mutedAutoplay) return;
        mutedAutoplay = false;
        audio.muted = false;
        state.isMuted = false;
        emit('fm:volume', { volume: state.volume, isMuted: false });
        emit('fm:autoplay-muted', { muted: false });
    }

    // ── Event helpers ────────────────────────────────────────
    function emit(name, detail) {
        window.dispatchEvent(new CustomEvent(name, { detail: detail || {} }));
    }

    // ── Media Session & Play State helpers ───────────────────
    function getAbsoluteUrl(url) {
        if (!url) return "";
        try {
            return new URL(url, window.location.href).href;
        } catch (e) {
            return url;
        }
    }

    function updateMediaSessionPlaybackState(playbackState) {
        if ("mediaSession" in navigator) {
            try {
                navigator.mediaSession.playbackState = playbackState;
            } catch (e) {
                // Ignore
            }
        }
    }

    function updateMediaSessionMetadata(track) {
        if (!("mediaSession" in navigator) || !window.MediaMetadata) return;
        if (!track) {
            navigator.mediaSession.metadata = null;
            return;
        }
        var artwork = [];
        if (track.pic) {
            var picUrl = getAbsoluteUrl(track.pic);
            artwork = [
                { src: picUrl, sizes: "96x96" },
                { src: picUrl, sizes: "128x128" },
                { src: picUrl, sizes: "192x192" },
                { src: picUrl, sizes: "256x256" },
                { src: picUrl, sizes: "384x384" },
                { src: picUrl, sizes: "512x512" }
            ];
        }
        try {
            navigator.mediaSession.metadata = new MediaMetadata({
                title: track.name || "",
                artist: track.artist || "",
                album: config.siteTitle || "Firefly Music",
                artwork: artwork
            });
        } catch (e) {
            console.warn("Failed to set MediaMetadata:", e);
        }
    }

    var lastPositionUpdate = 0;
    function updateMediaSessionPositionState(force) {
        if (!("mediaSession" in navigator) || !("setPositionState" in navigator.mediaSession)) return;
        var now = Date.now();
        if (!force && now - lastPositionUpdate < 1000) return;
        lastPositionUpdate = now;
        if (audio.duration && !isNaN(audio.duration) && isFinite(audio.duration) && audio.duration > 0) {
            try {
                navigator.mediaSession.setPositionState({
                    duration: audio.duration,
                    playbackRate: audio.playbackRate || 1,
                    position: Math.min(Math.max(0, audio.currentTime), audio.duration)
                });
            } catch (e) {
                // Ignore
            }
        }
    }

    function emitPlayState(isPlaying, force) {
        if (!force && state.isPlaying === isPlaying) return;
        state.isPlaying = isPlaying;
        if (isPlaying) {
            state.error = null;
            updateMediaSessionPlaybackState("playing");
        } else {
            updateMediaSessionPlaybackState("paused");
        }
        updateMediaSessionPositionState(true);
        emit("fm:play-state", { isPlaying: isPlaying });
    }

    function setupMediaSession() {
        if (!("mediaSession" in navigator)) return;
        if (!state.playlist || state.playlist.length === 0) return;

        var actions = [
            ["play", function () {
                if (!state.playlist || state.playlist.length === 0) return;
                if (audio.paused) {
                    audio.play().catch(function (e) {
                        if (e.name === "AbortError") return;
                        console.warn("Playback failed:", e);
                    });
                }
            }],
            ["pause", function () {
                if (!audio.paused) {
                    audio.pause();
                }
            }],
            ["previoustrack", function () {
                playPrev();
            }],
            ["nexttrack", function () {
                playNext(false);
            }],
            ["seekto", function (details) {
                if (details && details.seekTime !== undefined && details.seekTime !== null && !isNaN(details.seekTime)) {
                    seekToTime(details.seekTime);
                }
            }],
            ["seekbackward", function (details) {
                var offset = (details && details.seekOffset) || 10;
                seekToTime(audio.currentTime - offset);
            }],
            ["seekforward", function (details) {
                var offset = (details && details.seekOffset) || 10;
                seekToTime(audio.currentTime + offset);
            }],
            ["stop", function () {
                audio.pause();
                audio.currentTime = 0;
            }]
        ];

        actions.forEach(function (pair) {
            try {
                navigator.mediaSession.setActionHandler(pair[0], pair[1]);
            } catch (e) {
                // Ignore unsupported actions in current browser
            }
        });
    }

    // ── Meting fetch ─────────────────────────────────────────
    async function fetchMetingData() {
        if (!config.meting) return;
        var m = config.meting;
        var apis = [m.api].concat(m.fallbackApis || []);

        for (var i = 0; i < apis.length; i++) {
            var baseApi = apis[i];
            if (!baseApi) continue;
            try {
                var fetchUrl = baseApi
                    .replace(':server', m.server)
                    .replace(':type', m.type)
                    .replace(':id', m.id)
                    .replace(':r', Math.random());
                if (m.auth) fetchUrl += '&auth=' + m.auth;

                var res = await fetch(fetchUrl);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                var data = await res.json();

                if (Array.isArray(data) && data.length > 0) {
                    state.playlist = data.map(function (item) {
                        return {
                            name: item.title || item.name || 'Unknown',
                            artist: item.author || item.artist || 'Unknown',
                            url: item.url,
                            pic: item.pic || item.cover || config.defaultCover || '',
                            lrc: item.lrc
                        };
                    });
                    return;
                }
            } catch (e) {
                console.warn('Meting API failed for ' + baseApi, e);
            }
        }
        throw new Error('All Meting APIs failed');
    }

    // ── Lyrics ───────────────────────────────────────────────
    function loadLyrics(track) {
        state.lyrics = [];
        state.currentLrcIndex = -1;

        if (!track.lrc) {
            emit('fm:lyrics', { lyrics: [], status: 'none' });
            return;
        }

        var isLrcUrl = /^(https?:)?\/\//.test(track.lrc)
            || track.lrc.startsWith('/')
            || /\.(lrc|txt)(\?|#|$)/i.test(track.lrc);

        if (isLrcUrl) {
            emit('fm:lyrics', { lyrics: [], status: 'loading' });
            fetch(track.lrc)
                .then(function (r) { return r.text(); })
                .then(function (text) {
                    state.lyrics = parseLRC(text);
                    emit('fm:lyrics', { lyrics: state.lyrics, status: 'loaded' });
                })
                .catch(function () {
                    state.lyrics = [];
                    emit('fm:lyrics', { lyrics: [], status: 'failed' });
                });
        } else {
            state.lyrics = parseLRC(track.lrc);
            emit('fm:lyrics', { lyrics: state.lyrics, status: state.lyrics.length > 0 ? 'loaded' : 'none' });
        }
    }

    var currentTrackUrls = [];
    var currentTrackUrlIndex = 0;
    var errorSkipTimeout = null;

    function tryPlayCurrentTrackUrl(autoPlay, ver) {
        if (ver !== loadVersion) return;
        var playUrl = currentTrackUrls[currentTrackUrlIndex];
        audio.src = playUrl;

        if (autoPlay) {
            audio.play().then(function () {
                if (ver !== loadVersion) return; // stale, discard
                siteAutoplayAttempt = false;
                emitPlayState(true, true);
            }).catch(function (e) {
                if (ver !== loadVersion) return; // stale, discard
                if (e.name === 'AbortError') return; // interrupted by new load
                console.warn('Autoplay blocked:', e);
                emitPlayState(false, true);
                // 进站自动播放被浏览器拦下 → 退一步用静音起播，首次交互再开声音
                if (siteAutoplayAttempt) {
                    siteAutoplayAttempt = false;
                    startMutedAutoplay(ver);
                }
            });
        } else {
            emitPlayState(false, true);
        }
    }

    // ── Track loading ────────────────────────────────────────
    function loadTrack(index, autoPlay) {
        if (index < 0 || index >= state.playlist.length) return;
        if (!autoPlay) siteAutoplayAttempt = false;
        // 换曲前先把当前这首的进度落盘，避免暂停后直接关闭页面丢位置
        saveProgress();
        state.currentIndex = index;
        var track = state.playlist[index];
        var ver = ++loadVersion;
        activeTrack = track;
        lastProgressSave = 0; // 新歌的第一拍就落盘，别等满 4 秒

        // 只有进站后的首次加载才恢复位置；之后手动切歌一律从头
        pendingResume = storedProgress && isSameTrack(storedProgress, track) ? storedProgress : null;
        // 有位置要恢复时先取元数据，好在出声前就跳到位
        audio.preload = pendingResume ? 'metadata' : 'none';

        if (errorSkipTimeout) {
            clearTimeout(errorSkipTimeout);
            errorSkipTimeout = null;
        }

        currentTrackUrls = [track.url];
        currentTrackUrlIndex = 0;

        var matchId = track.url.match(/[?&]id=([^&]+)/);
        var matchServer = track.url.match(/[?&]server=([^&]+)/);
        if (matchId && matchServer && config.meting && config.meting.fallbackApis) {
            config.meting.fallbackApis.forEach(function (fallback) {
                var fallbackUrl = fallback
                    .replace(':server', matchServer[1])
                    .replace(':type', 'url')
                    .replace(':id', matchId[1]);
                if (currentTrackUrls.indexOf(fallbackUrl) === -1) {
                    currentTrackUrls.push(fallbackUrl);
                }
            });
        }

        loadLyrics(track);

        updateMediaSessionMetadata(track);

        emit('fm:track', { index: index, track: track, autoPlay: !!autoPlay });

        // 曲目没写 cover 时，去音频文件里找内嵌封面（异步，找到了再补发一次 fm:track）
        resolveEmbeddedCover(index);

        tryPlayCurrentTrackUrl(autoPlay, ver);
    }

    // ── 内嵌封面 ─────────────────────────────────────────────
    // <audio> 只解声音，拿不到封面；真正解析文件头的是 utils/audio-cover，
    // 由文件末尾的模块脚本挂到 window.__ffCover 上（内联脚本 import 不了）。
    var coverJobs = {};
    var coverWaitBound = false;
    function resolveEmbeddedCover(index) {
        var track = state.playlist[index];
        if (!track || !track.embeddedCover || coverJobs[index]) return;
        var read = window.__ffCover;
        if (typeof read !== 'function') {
            // 模块脚本还没执行（defer），等 load 之后再补一次
            if (!coverWaitBound) {
                coverWaitBound = true;
                window.addEventListener('load', function () {
                    resolveEmbeddedCover(state.currentIndex);
                });
            }
            return;
        }
        coverJobs[index] = true;
        Promise.resolve(read(track.url)).then(function (pic) {
            if (typeof pic !== 'string' || !pic) return;
            track.pic = pic;
            track.embeddedCover = false;
            if (index === state.currentIndex) {
                updateMediaSessionMetadata(track);
                emit('fm:track', { index: index, track: track, autoPlay: false });
            }
        }).catch(function () {
            coverJobs[index] = false;
        });
    }

    // ── Playback controls ────────────────────────────────────
    function togglePlay() {
        if (!state.playlist || state.playlist.length === 0) return;
        siteAutoplayAttempt = false; // 用户自己点了，不再走补播
        if (audio.paused) {
            // 点播放本身就是用户激活，静音兜底可以直接开声音
            takeOverMutedAutoplay();
            audio.play().then(function () {
                emitPlayState(true);
            }).catch(function (e) {
                if (e.name === 'AbortError') return;
                console.warn('Playback failed:', e);
            });
        } else {
            audio.pause();
            emitPlayState(false);
        }
    }

    function playNext(auto) {
        if (state.playlist.length === 0) return;
        if (!auto) takeOverMutedAutoplay(); // 手动切歌＝用户激活，顺手开声音
        if (state.playMode === 1 && auto) {
            audio.currentTime = 0;
            audio.play().catch(function (e) {
                if (e.name === 'AbortError') return;
                console.warn('Playback failed:', e);
            });
            return;
        }
        var nextIndex;
        if (state.playMode === 2) {
            nextIndex = Math.floor(Math.random() * state.playlist.length);
        } else {
            nextIndex = (state.currentIndex + 1) % state.playlist.length;
        }
        loadTrack(nextIndex, true);
    }

    function playPrev() {
        if (state.playlist.length === 0) return;
        takeOverMutedAutoplay(); // 手动上一首＝用户激活，顺手开声音
        var prevIndex;
        if (state.playMode === 2) {
            prevIndex = Math.floor(Math.random() * state.playlist.length);
        } else {
            prevIndex = (state.currentIndex - 1 + state.playlist.length) % state.playlist.length;
        }
        loadTrack(prevIndex, true);
    }

    function setPlayMode(mode) {
        mode = Math.max(0, Math.min(2, mode | 0));
        state.playMode = mode;
        // 播放设置面板选完要能记住，否则刷新后回到配置默认值
        try { localStorage.setItem('music-player-playmode', String(mode)); } catch (e) { /* ignore */ }
        emit('fm:mode', { playMode: mode });
    }

    function cyclePlayMode() {
        setPlayMode((state.playMode + 1) % 3);
    }

    function setVolume(val) {
        val = Math.max(0, Math.min(1, val));
        state.volume = val;
        state.isMuted = false;
        mutedAutoplay = false;
        audio.volume = val;
        audio.muted = false;
        localStorage.setItem('music-player-volume', val.toString());
        emit('fm:volume', { volume: val, isMuted: false });
    }

    function toggleMute() {
        state.isMuted = !state.isMuted;
        audio.muted = state.isMuted;
        if (!state.isMuted) mutedAutoplay = false;
        emit('fm:volume', { volume: state.volume, isMuted: state.isMuted });
    }

    function setPlaybackRate(rate) {
        rate = Math.round(Math.max(0.5, Math.min(2, Number(rate) || 1)) * 100) / 100;
        state.playbackRate = rate;
        audio.playbackRate = rate;
        // 与播放模式、音量一致：选了就记住
        try { localStorage.setItem('music-player-rate', String(rate)); } catch (e) { /* ignore */ }
        emit('fm:rate', { playbackRate: rate });
    }

    function seek(percent) {
        if (!audio.duration) return;
        audio.currentTime = Math.max(0, Math.min(1, percent)) * audio.duration;
        updateMediaSessionPositionState(true);
    }

    function seekToTime(time) {
        if (!audio.duration) return;
        audio.currentTime = Math.max(0, Math.min(time, audio.duration));
        updateMediaSessionPositionState(true);
    }

    function playTrackByIndex(index) {
        takeOverMutedAutoplay(); // 列表里点歌＝用户激活，顺手开声音
        if (index === state.currentIndex && !audio.paused) {
            togglePlay();
        } else {
            loadTrack(index, true);
        }
    }

    // ── Audio events → broadcast ─────────────────────────────
    audio.addEventListener('play', function () {
        emitPlayState(true, true);
    });

    audio.addEventListener('pause', function () {
        saveProgress(); // 暂停即落盘：关页面时就是这一秒
        emitPlayState(false, true);
    });

    audio.addEventListener('volumechange', function () {
        state.volume = audio.volume;
        state.isMuted = audio.muted;
        emit('fm:volume', { volume: state.volume, isMuted: state.isMuted });
    });

    // 进度广播：timeupdate 和「恢复进度后」共用
    function emitTimeProgress() {
        var ct = audio.currentTime;
        var dur = audio.duration;
        if (isNaN(dur)) return;
        emit('fm:time', {
            currentTime: ct,
            duration: dur,
            progress: (ct / dur) * 100,
            currentTimeStr: formatTime(ct),
            durationStr: formatTime(dur)
        });
    }

    audio.addEventListener('loadedmetadata', function () {
        // 上次听到的位置：等元数据到了才设得上 currentTime
        if (pendingResume) {
            var dur = audio.duration;
            var target = pendingResume.time;
            pendingResume = null;
            storedProgress = null; // 恢复过一次就作废，本次会话内切歌不再回跳
            if (isFinite(dur) && dur > 0 && target > dur - RESUME_END_GAP) target = 0;
            if (target >= RESUME_MIN_SECONDS && (!isFinite(dur) || target < dur)) {
                try {
                    audio.currentTime = target;
                    // seek 后立刻把时间推给卡片/进度条，别等下一次 timeupdate
                    emitTimeProgress();
                } catch (e) {
                    /* 元数据异常就算了，从头播 */
                }
            }
        }
        updateMediaSessionPositionState(true);
    });

    audio.addEventListener('seeked', function () {
        saveProgress();
        updateMediaSessionPositionState(true);
    });

    audio.addEventListener('timeupdate', function () {
        if (isNaN(audio.duration)) return;
        var ct = audio.currentTime;
        emitTimeProgress();
        saveProgressThrottled();

        updateMediaSessionPositionState(false);

        // Lyrics sync
        if (state.lyrics.length > 0) {
            var idx = -1;
            for (var i = 0; i < state.lyrics.length; i++) {
                if (ct >= state.lyrics[i].time) idx = i;
                else break;
            }
            if (idx !== state.currentLrcIndex) {
                state.currentLrcIndex = idx;
                emit('fm:lrc-index', { index: idx });
            }
        }
    });

    audio.addEventListener('ended', function () {
        saveProgress(); // currentTime 已在结尾 → 存成 0，下次从头
        playNext(true);
    });

    audio.addEventListener('error', function () {
        emitPlayState(false, true);
        var ver = loadVersion;
        if (currentTrackUrlIndex < currentTrackUrls.length - 1) {
            currentTrackUrlIndex++;
            console.warn('Playback failed, trying fallback URL: ' + currentTrackUrls[currentTrackUrlIndex]);
            tryPlayCurrentTrackUrl(true, ver);
        } else {
            state.error = 'Audio playback error';
            emit('fm:error', { message: '播放失败，即将自动跳过...' });

            if (errorSkipTimeout) clearTimeout(errorSkipTimeout);
            errorSkipTimeout = setTimeout(function () {
                if (ver === loadVersion) {
                    playNext(true);
                }
            }, 2000);
        }
    });

    // ── Init (idempotent) ────────────────────────────────────
    async function init() {
        if (state.initialized || state.initializing) return;
        state.initializing = true;

        try {
            if (config.mode === 'meting' && config.meting) {
                await fetchMetingData();
            } else if (config.mode === 'local') {
                state.playlist = config.localPlaylist || [];
            }

            if (state.playlist.length > 0) {
                // Apply volume
                audio.volume = state.volume;
                // Apply playback rate（换曲不会重置 audio 元素，这里初始化一次即可）
                audio.playbackRate = state.playbackRate;

                // 上次听到哪首就从哪首继续；找不到对应曲目再按播放模式取起始曲
                var startIndex = -1;
                if (storedProgress) {
                    for (var si = 0; si < state.playlist.length; si++) {
                        if (isSameTrack(storedProgress, state.playlist[si])) {
                            startIndex = si;
                            break;
                        }
                    }
                }
                if (startIndex < 0) {
                    startIndex = state.playMode === 2
                        ? Math.floor(Math.random() * state.playlist.length)
                        : 0;
                }

                state.initialized = true;

                emit('fm:init', {
                    playlist: state.playlist,
                    playMode: state.playMode,
                    volume: state.volume,
                    isMuted: state.isMuted,
                    playbackRate: state.playbackRate
                });

                // 进站自动播放：标记来源，被浏览器拦截时由 tryPlayCurrentTrackUrl 挂补播
                siteAutoplayAttempt = autoPlayEnabled;
                loadTrack(startIndex, autoPlayEnabled);
                setupMediaSession();
            } else {
                state.initialized = true;
                emit('fm:init', {
                    playlist: [],
                    playMode: state.playMode,
                    volume: state.volume,
                    isMuted: state.isMuted,
                    playbackRate: state.playbackRate
                });
                emit('fm:error', { message: config.i18n.noSongs });
            }
        } catch (e) {
            console.error('Music Manager init error:', e);
            state.initialized = true;
            emit('fm:init', {
                playlist: [],
                playMode: state.playMode,
                volume: state.volume,
                isMuted: state.isMuted,
                playbackRate: state.playbackRate
            });
            emit('fm:error', { message: config.i18n.error });
        } finally {
            state.initializing = false;
        }
    }

    // ── Public API ───────────────────────────────────────────
    window.__fireflyMusic = {
        init: init,
        getState: function () {
            var track = state.playlist[state.currentIndex] || null;
            var isPlaying = !audio.paused;
            state.isPlaying = isPlaying;
            return {
                playlist: state.playlist,
                currentIndex: state.currentIndex,
                track: track,
                isPlaying: isPlaying,
                playMode: state.playMode,
                volume: state.volume,
                isMuted: state.isMuted,
                playbackRate: state.playbackRate,
                currentTime: audio.currentTime,
                duration: audio.duration || 0,
                progress: audio.duration ? (audio.currentTime / audio.duration) * 100 : 0,
                currentTimeStr: formatTime(audio.currentTime),
                durationStr: formatTime(audio.duration),
                lyrics: state.lyrics,
                currentLrcIndex: state.currentLrcIndex,
                initialized: state.initialized,
                error: state.error,
                config: config
            };
        },
        togglePlay: togglePlay,
        playNext: function () { playNext(false); },
        playPrev: playPrev,
        cyclePlayMode: cyclePlayMode,
        setPlayMode: setPlayMode,
        setVolume: setVolume,
        toggleMute: toggleMute,
        setPlaybackRate: setPlaybackRate,
        seek: seek,
        seekToTime: seekToTime,
        playTrackByIndex: playTrackByIndex,
        loadTrack: loadTrack
    };

    // 开了「进入站点自动播放」但侧栏播放器没挂载（sidebarConfig 里关掉了 music 组件）时，
    // 没有任何组件会触发 init —— 这里补一次，否则开关等于没打开
    if (autoPlayEnabled) {
        var bootAutoPlay = function () {
            setTimeout(function () { init(); }, 0);
        };
        if (document.readyState === 'complete') bootAutoPlay();
        else window.addEventListener('load', bootAutoPlay, { once: true });
    }
})();
</script>

<script>
	import { readEmbeddedCover } from "@/utils/audio-cover";

	// 上面的内联脚本没法 import，把解析函数挂到 window 上交给它用。
	// 模块脚本是 defer 的，内联脚本里会做「没就绪就等 load」的兜底。
	(window as unknown as { __ffCover?: typeof readEmbeddedCover }).__ffCover =
		readEmbeddedCover;
</script>
