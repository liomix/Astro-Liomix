---
/**
 * 骨架屏的最小单元：一块会呼吸的灰色占位
 * ---------------------------------------------------------------------------
 * 只负责「一块」：宽、高、圆角、要不要圆。骨骼的形状（聊天气泡、列表卡片、
 * 文章段落）由使用它的组件拼，别在这里写业务 class。
 *
 * 命名不加前后缀：`skeleton` 这两个字就是这块占位的名字（块），`--circle` 是修饰类，
 * 尺寸走 `--skeleton-width|height|radius` 变量，不在模板里写死像素。
 *
 * 配色跟着主题走：底色是「当前文字色」掺进当前面板色，所以深色模式下自动变深，
 * 不用再写一份 `.dark` 规则。`prefers-reduced-motion` 下不闪，只留静态灰块。
 *
 * 样式放在 `styles/components/skeleton.css`（全局）：Svelte 岛（导航搜索、
 * 动态流）也要用同一套类名，而作用域样式带 `[data-astro-cid-*]`，那边匹配不到。
 */
import "@/styles/components/skeleton.css";

interface Props {
	/** 任意 CSS 长度；默认撑满容器 */
	width?: string;
	height?: string;
	/** 圆角；传 9999px 就是胶囊 */
	radius?: string;
	/** 圆形（头像、图标位） */
	circle?: boolean;
	class?: string;
}

const {
	width = "100%",
	height = "0.85rem",
	radius = "0.45rem",
	circle = false,
	class: className,
} = Astro.props;
---

<span
	class:list={["skeleton", circle && "skeleton--circle", className]}
	style={`--skeleton-width:${width};--skeleton-height:${height};--skeleton-radius:${circle ? "50%" : radius}`}
	aria-hidden="true"></span>
