---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import Welcome from "@/components/widget/Welcome.astro";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 了解更多：整块文字区域可点击跳转
const showLink = Boolean(config.link && config.link.enable !== false);
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
<WidgetLayout
  name={config.title || i18n(I18nKey.announcement)}
  showTitle={showTitle}
  id="announcement"
  class={className}
  style={style}
>
  {
    showLink && config.link ? (
      <a
        href={config.link.url}
        target={config.link.external ? "_blank" : "_self"}
        rel={config.link.external ? "noopener noreferrer" : undefined}
        class="announcement-body text-neutral-600 dark:text-neutral-300"
        aria-label={config.content ? undefined : config.link.text}
      >
        {config.content}
      </a>
    ) : (
      <div class="announcement-body announcement-body-static text-neutral-600 dark:text-neutral-300">
        {config.content}
      </div>
    )
  }

  <!-- 访客欢迎信息（位于文字区容器下方） -->
  <Welcome />
</WidgetLayout>

<style>
  /* 文字区容器：整块可点击跳转到完整公告 */
  .announcement-body {
    display: block;
    line-height: 1.75;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 0.18s ease;
  }

  .announcement-body-static {
    cursor: default;
  }

  a.announcement-body:hover {
    color: var(--primary);
  }

  a.announcement-body:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }
</style>
