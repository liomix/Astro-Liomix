---
import { Icon } from "astro-icon/components";
import AvatarImage from "@/components/common/AvatarImage.astro";
import { profileConfig } from "@/config/profileConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { avatarMotionOverride } from "@/utils/avatar-utils";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;

// 头像形状：circle 时裁成正圆并居中，rect 保持主题默认的圆角矩形铺满宽度
const isCircleAvatar = (profileConfig.avatarShape ?? "rect") === "circle";

// 卡片底部的三列统计：文章 / 标签 / 分类（原站点统计卡片中的前三项），点击跳到对应列表页
const showStats = profileConfig.showStats ?? true;
const profileStats = showStats
	? [
			{
				id: "posts",
				label: i18n(I18nKey.siteStatsPostCount),
				value: (await getSortedPosts()).length,
				href: url("/archive/"),
			},
			{
				id: "tags",
				label: i18n(I18nKey.siteStatsTagCount),
				value: (await getTagList()).length,
				href: url("/tags/"),
			},
			{
				id: "categories",
				label: i18n(I18nKey.siteStatsCategoryCount),
				value: (await getCategoryList()).length,
				href: url("/categories/"),
			},
		]
	: [];
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class:list={[
      "group block relative overflow-hidden active:scale-95",
      isCircleAvatar
        ? "mx-auto mt-1 mb-3 w-24 lg:w-28 rounded-full"
        : "mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3 max-w-48 lg:max-w-none rounded-xl",
    ]}
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon
        name="fa7-regular:address-card"
        class:list={[
          "transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white",
          isCircleAvatar ? "text-3xl" : "text-5xl",
        ]}
      />
    </div>
    <AvatarImage
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class={`profile-avatar-image ${isCircleAvatar ? "w-full aspect-square" : "mx-auto lg:w-full h-full lg:mt-0"}`}
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
      animated={avatarMotionOverride()}
      poster={profileConfig.avatarPoster}
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div class="text-center text-neutral-400 mb-1 transition">
      {profileConfig.bio}
    </div>

    {/* 三列统计：文章 / 标签 / 分类 */}
    {showStats && (
      <div class="profile-stats">
        {profileStats.map((stat) => (
          <a class="profile-stat" data-stat-id={`profile-${stat.id}`} href={stat.href}>
            <span class="profile-stat-value text-90">{stat.value}</span>
            <span class="profile-stat-label text-50">{stat.label}</span>
          </a>
        ))}
      </div>
    )}

        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {profileConfig.links.length > 1 && profileConfig.links.map(item =>
                    {
                    const showName = item.showName;
                    const className = showName 
                        ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95" 
                        : "btn-regular rounded-lg h-10 w-10 active:scale-90";

                    if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank" class={className}>
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                    }
                    }
            )}
            {profileConfig.links.length == 1 && (function(item){
                if (item.url.startsWith("mailto:")) {
                        const encodedEmail = encodeMailto(item.url);
                        return <a rel="me" aria-label={item.name} href="#" data-encoded-email={encodedEmail} onclick={MAILTO_ONCLICK_SCRIPT},
                                    class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                            <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                            {item.name}
                        </a>
                    } else {
                        return <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                                            class="btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95">
                                <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                                {item.name}
                            </a>
                    }
            })(profileConfig.links[0])}
        </div>
  </div>
</div>

<style>
  .profile-stats {
    display: flex;
    align-items: stretch;
    margin: 0.6rem 0 0.8rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--line-divider);
    border-bottom: 1px solid var(--line-divider);
  }

  .profile-stat {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.0625rem;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .profile-stat:hover {
    background: color-mix(in oklch, var(--primary) 8%, transparent);
  }

  .profile-stat:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* 列间细分隔线，只占两行文字左右的高度 */
  .profile-stat + .profile-stat::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 1px;
    height: 1.5rem;
    background: var(--line-divider);
    transform: translateY(-50%);
  }

  .profile-stat-value {
    font-size: 1.25rem;
    line-height: 1.625rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition: color 0.15s ease;
  }

  .profile-stat-label {
    font-size: 0.6875rem;
    line-height: 0.875rem;
    letter-spacing: 0.08em;
    transition: color 0.15s ease;
  }

  .profile-stat:hover .profile-stat-value,
  .profile-stat:hover .profile-stat-label {
    color: var(--primary);
  }
</style>
