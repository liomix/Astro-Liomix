---
import { Icon } from "astro-icon/components";
import AvatarImage from "@/components/common/AvatarImage.astro";
import { profileConfig } from "@/config/profileConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { avatarMotionOverride } from "@/utils/avatar-utils";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";
import { encodeMailto, MAILTO_ONCLICK_SCRIPT } from "@/utils/email-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;

// 头像形状：circle 时裁成正圆并居中，rect 保持主题默认的圆角矩形铺满宽度
const isCircleAvatar = (profileConfig.avatarShape ?? "rect") === "circle";

// 卡片底部的三列统计：文章 / 标签 / 分类（原站点统计卡片中的前三项），点击跳到对应列表页
const showStats = profileConfig.showStats ?? true;
const profileStats = showStats
	? [
			{
				id: "posts",
				label: i18n(I18nKey.siteStatsPostCount),
				value: (await getSortedPosts()).length,
				href: url("/archive/"),
			},
			{
				id: "tags",
				label: i18n(I18nKey.siteStatsTagCount),
				value: (await getTagList()).length,
				href: url("/tags/"),
			},
			{
				id: "categories",
				label: i18n(I18nKey.siteStatsCategoryCount),
				value: (await getCategoryList()).length,
				href: url("/categories/"),
			},
		]
	: [];

// 「Go to Github」按钮：优先取 profileConfig 里的 GitHub 链接，配置缺失时用固定地址兜底
const githubUrl =
	profileConfig.links.find((item) => item.name === "GitHub")?.url ??
	"https://github.com/liomix";
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class:list={[
      "group block relative overflow-hidden active:scale-95",
      isCircleAvatar
        ? "mx-auto mt-1 mb-3 w-24 lg:w-28 rounded-full"
        : "mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3 max-w-48 lg:max-w-none rounded-xl",
    ]}
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon
        name="fa7-regular:address-card"
        class:list={[
          "transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white",
          isCircleAvatar ? "text-3xl" : "text-5xl",
        ]}
      />
    </div>
    <AvatarImage
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class={`profile-avatar-image ${isCircleAvatar ? "w-full aspect-square" : "mx-auto lg:w-full h-full lg:mt-0"}`}
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
      animated={avatarMotionOverride()}
      poster={profileConfig.avatarPoster}
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="profile-bio text-center text-neutral-400 mb-1 transition"
      data-profile-bio
    >
      {profileConfig.bio}
    </div>

    {/* 三列统计：文章 / 标签 / 分类 */}
    {showStats && (
      <div class="profile-stats">
        {profileStats.map((stat) => (
          <a class="profile-stat" data-stat-id={`profile-${stat.id}`} href={stat.href}>
            <span class="profile-stat-value text-90">{stat.value}</span>
            <span class="profile-stat-label text-50">{stat.label}</span>
          </a>
        ))}
      </div>
    )}

    {/* GitHub 入口按钮：字母波浪 + 图标微放大 */}
    <div class="profile-send">
      <a
        class="send-button"
        aria-label="Go to Github"
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer me"
      >
        <div class="state">
          <div class="icon">
            <svg
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
            </svg>
          </div>
          <p>
            <span style="--i:0">G</span>
            <span style="--i:1">o</span>
            <span style="--i:2">&nbsp;</span>
            <span style="--i:3">t</span>
            <span style="--i:4">o</span>
            <span style="--i:5">&nbsp;</span>
            <span style="--i:6">G</span>
            <span style="--i:7">i</span>
            <span style="--i:8">t</span>
            <span style="--i:9">h</span>
            <span style="--i:10">u</span>
            <span style="--i:11">b</span>
          </p>
        </div>
      </a>
    </div>

        <ul class="profile-socials">
          {profileConfig.links.map((item) => {
            const isMail = item.url.startsWith("mailto:");
            return (
              <li class="icon-content">
                <a
                  class="social-link"
                  href={isMail ? "#" : item.url}
                  aria-label={item.name}
                  data-social={item.name.toLowerCase()}
                  data-encoded-email={isMail ? encodeMailto(item.url) : undefined}
                  onclick={isMail ? MAILTO_ONCLICK_SCRIPT : undefined}
                  target={isMail ? undefined : "_blank"}
                  rel="me noopener noreferrer"
                >
                  <span class="filled"></span>
                  <Icon name={item.icon} class="social-icon" />
                </a>
                <span class="tooltip">{item.name}</span>
              </li>
            );
          })}
        </ul>
  </div>
</div>

<style>
  /* 简介固定单行：宽度不够时由脚本等比缩小字号，不换行也不省略 */
  .profile-bio {
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .profile-stats {
    display: flex;
    align-items: stretch;
    margin: 0.6rem 0 0.8rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--line-divider);
    border-bottom: 1px solid var(--line-divider);
  }

  .profile-stat {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.0625rem;
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .profile-stat:hover {
    background: color-mix(in oklch, var(--primary) 8%, transparent);
  }

  .profile-stat:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  /* 列间细分隔线，只占两行文字左右的高度 */
  .profile-stat + .profile-stat::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 1px;
    height: 1.5rem;
    background: var(--line-divider);
    transform: translateY(-50%);
  }

  .profile-stat-value {
    font-size: 1.25rem;
    line-height: 1.625rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    transition: color 0.15s ease;
  }

  .profile-stat-label {
    font-size: 0.6875rem;
    line-height: 0.875rem;
    letter-spacing: 0.08em;
    transition: color 0.15s ease;
  }

  .profile-stat:hover .profile-stat-value,
  .profile-stat:hover .profile-stat-label {
    color: var(--primary);
  }

  /* ── Send Message 按钮 ──
     扁平风格：外观对齐站内 .btn-regular（共用按钮色变量，自动跟随亮暗），
     只保留字母波浪与纸飞机飞出动效。
     keyframes 一律带 send- 前缀，避免和 CoverImage 的 spin 等全局动画重名。 */
  /* ── GitHub 入口按钮 ──
     扁平风格，外观沿用站内 .btn-regular 的按钮色变量（自动跟随亮暗）。
     动效只保留「字母逐个落下 + 悬停波浪 + 图标微放大」。
     keyframes 一律带 send- 前缀，避免和 CoverImage 的 spin 等全局动画重名。 */
  .profile-send {
    display: flex;
    margin: 0 0 0.75rem;
  }

  .profile-send .send-button {
    --send-primary: var(--primary);

    color: inherit;
    cursor: pointer;
    border-radius: 0.75rem;
    border: none;
    background: var(--btn-regular-bg);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
    width: 100%;
    min-width: 0;
    padding: 0;
    height: 3.5rem;
    font-family: "Galano Grotesque", Poppins, Montserrat, sans-serif;
    font-style: normal;
    font-size: 1rem;
    font-weight: 600;
    outline: none;
  }

  .profile-send .send-button:hover {
    background: var(--btn-regular-bg-hover);
    color: var(--primary);
  }

  .profile-send .send-button:active {
    background: var(--btn-regular-bg-active);
  }

  .profile-send .send-button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .profile-send .state {
    padding-left: 29px;
    display: flex;
    position: relative;
  }

  .profile-send .state p {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .profile-send .state .icon {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    margin: auto;
    transform: scale(1.25);
    transition: transform 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .profile-send .state .icon svg {
    overflow: visible;
  }

  .profile-send .send-button:hover .state .icon {
    transform: scale(1.4);
  }

  /* 字母逐个落下 / 悬停波浪 */
  .profile-send .state p span {
    display: block;
    opacity: 0;
    animation: send-slide-down 0.8s ease forwards calc(var(--i) * 0.03s);
  }

  .profile-send .send-button:hover p span {
    opacity: 1;
    animation: send-wave 0.5s ease forwards calc(var(--i) * 0.02s);
  }

  @keyframes send-wave {
    30% {
      opacity: 1;
      transform: translateY(4px) translateX(0) rotate(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-3px) translateX(0) rotate(0);
      color: var(--send-primary);
    }
    100% {
      opacity: 1;
      transform: translateY(0) translateX(0) rotate(0);
    }
  }

  @keyframes send-slide-down {
    0% {
      opacity: 0;
      transform: translateY(-20px) translateX(5px) rotate(-90deg);
      color: var(--send-primary);
      filter: blur(5px);
    }
    30% {
      opacity: 1;
      transform: translateY(4px) translateX(0) rotate(0);
      filter: blur(0);
    }
    50% {
      opacity: 1;
      transform: translateY(-3px) translateX(0) rotate(0);
    }
    100% {
      opacity: 1;
      transform: translateY(0) translateX(0) rotate(0);
    }
  }

  /* 减少动态偏好 */
  @media (prefers-reduced-motion: reduce) {
    .profile-send .send-button,
    .profile-send .state .icon {
      transition: none;
    }
  }

  /* ── 社交图标栏：圆形按钮 + 由下往上的品牌色填充 + 悬浮 tooltip ── */
  .profile-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
    padding: 0;
    list-style: none;
  }

  .profile-socials .icon-content {
    position: relative;
    z-index: 1;
    display: flex;
  }

  .profile-socials .icon-content:hover {
    z-index: 10;
  }

  /* tooltip 用 opacity + transform 控制显隐：不用 visibility 过渡，
     也不依赖 top 位移，hover 一定出得来 */
  .profile-socials .icon-content .tooltip {
    position: absolute;
    bottom: calc(100% + 0.375rem);
    left: 50%;
    transform: translate(-50%, 0.25rem);
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--primary);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    z-index: 10;
  }

  .profile-socials .icon-content:hover .tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .profile-socials .icon-content .social-link {
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--btn-content);
    background-color: var(--btn-regular-bg);
    transition: all 0.3s ease-in-out;
  }

  .profile-socials .icon-content .social-link:hover {
    color: #fff;
  }

  .profile-socials .icon-content .social-link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .profile-socials .icon-content .filled {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0;
    background-color: var(--primary);
    transition: all 0.3s ease-in-out;
  }

  .profile-socials .icon-content .social-link:hover .filled {
    height: 100%;
  }

  /* Icon 组件渲染的 svg 不带本组件的 scoped 标记，必须用 :global 才选得中 */
  .profile-socials .icon-content :global(.social-icon) {
    position: relative;
    z-index: 1;
    width: 1.25rem;
    height: 1.25rem;
  }

  /* 品牌色：填充层与 tooltip 同色 */
  .profile-socials .icon-content .social-link[data-social="discord"] .filled,
  .profile-socials .icon-content
    .social-link[data-social="discord"]
    ~ .tooltip {
    background-color: #5865f2;
  }

  .profile-socials .icon-content .social-link[data-social="instagram"] .filled,
  .profile-socials .icon-content
    .social-link[data-social="instagram"]
    ~ .tooltip {
    background: linear-gradient(
      45deg,
      #405de6,
      #5b51db,
      #b33ab4,
      #c135b4,
      #e1306c,
      #fd1f1f
    );
  }

  .profile-socials .icon-content .social-link[data-social="tiktok"] .filled,
  .profile-socials .icon-content .social-link[data-social="tiktok"] ~ .tooltip {
    background: linear-gradient(45deg, #25f4ee, #fe2c55);
  }

  .profile-socials .icon-content .social-link[data-social="email"] .filled,
  .profile-socials .icon-content .social-link[data-social="email"] ~ .tooltip {
    background-color: #ea4335;
  }
</style>

<script>
  /**
   * 简介保持一行：先按原始字号量，溢出了就按「可用宽 / 需要宽」等比缩字号。
   * 文字缩放近似线性，迭代几次即可收敛；最小 10px，避免极端窄屏缩成看不清的蚂蚁字。
   */
  const MIN_FONT_SIZE = 10;

  function fitProfileBio(): void {
    document
      .querySelectorAll<HTMLElement>("[data-profile-bio]")
      .forEach((el) => {
        el.style.fontSize = "";
        if (el.clientWidth <= 0 || el.scrollWidth <= el.clientWidth + 0.5)
          return;

        let size = Number.parseFloat(getComputedStyle(el).fontSize);
        for (let i = 0; i < 3; i++) {
          const ratio = el.clientWidth / el.scrollWidth;
          if (!Number.isFinite(ratio) || ratio >= 1) break;
          size = Math.max(MIN_FONT_SIZE, size * ratio);
          el.style.fontSize = `${size}px`;
        }
      });
  }

  let fitFrame = 0;
  function scheduleFit(): void {
    if (fitFrame) return;
    fitFrame = requestAnimationFrame(() => {
      fitFrame = 0;
      fitProfileBio();
    });
  }

  scheduleFit();
  document.addEventListener("astro:page-load", scheduleFit);
  window.addEventListener("resize", scheduleFit);
  // 字体加载完宽度会变，需要重新量一次
  if (document.fonts?.ready) void document.fonts.ready.then(scheduleFit);
</script>
