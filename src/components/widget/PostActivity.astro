---
/**
 * 年度发文热力图 + 当月文章列表
 * 从日历卡片（Calendar.astro）下半部分拆出，嵌到站点统计卡片里复用
 * 注意：SiteStats 会同时渲染在桌面侧栏与移动端底部，故用 class 查询而非 id
 */
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

// 热力图格子的悬浮提示模板
const heatmapWeekTemplate = i18n(I18nKey.calendarHeatmapWeek);

const calendarDataUrl = url("/api/allPostMeta.json");
const postUrlPrefix = url("/posts/");
---

<div class="post-activity" data-post-activity>
  <div class="pa-months">
    {Array.from({ length: 12 }, (_, i) => (
      <span class="text-50">{i + 1}</span>
    ))}
  </div>
  <div class="pa-heatmap"></div>

  <div class="pa-divider"></div>

  <div class="pa-list custom-scrollbar"></div>
</div>

<style>
  .post-activity {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line-divider);
  }

  .pa-months {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.1875rem;
    margin-bottom: 0.3125rem;
  }

  .pa-months span {
    font-size: 0.5625rem;
    line-height: 1;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .pa-heatmap {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 0.1875rem;
  }

  :global(.pa-cell) {
    aspect-ratio: 1;
    min-width: 0;
    border-radius: 2px;
    background: var(--btn-plain-bg-hover);
  }

  .pa-divider {
    margin: 0.625rem 0 0.375rem;
    border-top: 1px solid var(--line-divider);
  }

  .pa-list {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    max-height: 10.5rem;
    overflow-y: auto;
  }

  :global(.pa-post) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.8125rem;
    line-height: 1.25rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  :global(.pa-post:hover) {
    background: var(--btn-plain-bg-hover);
    color: var(--primary);
  }

  :global(.pa-post-title) {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.pa-post-date) {
    flex: none;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }
</style>

<script is:inline define:vars={{ calendarDataUrl, postUrlPrefix, heatmapWeekTemplate }}>
  const PA_OPACITY = [0, 0.45, 0.65, 0.85, 1];

  function buildHeatmapHtml(posts) {
    const year = new Date().getFullYear();
    // heatmapData[month][week] = 文章数
    const heatmapData = Array.from({ length: 12 }, () => [0, 0, 0, 0]);
    posts.forEach((post) => {
      const date = new Date(post.published);
      if (Number.isNaN(date.getTime()) || date.getFullYear() !== year) return;
      const week = Math.min(Math.floor((date.getDate() - 1) / 7), 3);
      heatmapData[date.getMonth()][week] += 1;
    });

    let html = "";
    for (let week = 0; week < 4; week++) {
      for (let month = 0; month < 12; month++) {
        const count = heatmapData[month][week];
        const tooltip = heatmapWeekTemplate
          .replace("{month}", month + 1)
          .replace("{week}", week + 1)
          .replace("{count}", count);
        const style =
          count === 0
            ? ""
            : `background: var(--primary); opacity: ${PA_OPACITY[Math.min(count, 4)]};`;
        html += `<div class="pa-cell" style="${style}" title="${tooltip}"></div>`;
      }
    }
    return html;
  }

  function buildPostsHtml(posts) {
    const now = new Date();
    return posts
      .filter((post) => {
        const date = new Date(post.published);
        return (
          !Number.isNaN(date.getTime()) &&
          date.getFullYear() === now.getFullYear() &&
          date.getMonth() === now.getMonth()
        );
      })
      .sort((a, b) => new Date(b.published) - new Date(a.published))
      .map((post) => {
        const date = new Date(post.published);
        return `<a class="pa-post" href="${postUrlPrefix}${post.id}/">
          <span class="pa-post-title text-75">${post.title}</span>
          <span class="pa-post-date">${date.getMonth() + 1}-${date.getDate()}</span>
        </a>`;
      })
      .join("");
  }

  async function initPostActivity() {
    const roots = document.querySelectorAll("[data-post-activity]");
    if (!roots.length) return;

    try {
      let posts = window.__allPostMetaCache;
      if (!posts) {
        const response = await fetch(calendarDataUrl);
        posts = await response.json();
        window.__allPostMetaCache = posts;
      }

      const heatmapHtml = buildHeatmapHtml(posts);
      const postsHtml = buildPostsHtml(posts);
      roots.forEach((root) => {
        const heatmap = root.querySelector(".pa-heatmap");
        const list = root.querySelector(".pa-list");
        if (heatmap) heatmap.innerHTML = heatmapHtml;
        if (list) list.innerHTML = postsHtml;
      });
    } catch (error) {
      console.error("Failed to load post activity data", error);
    }
  }

  initPostActivity();

  // Swup 切页后重新渲染（只注册一次）
  if (!window.__postActivityInit) {
    window.__postActivityInit = true;
    document.addEventListener("swup:contentReplaced", () => {
      setTimeout(initPostActivity, 100);
    });
  }
</script>
