---
import { getImage } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import DynamicSidebar from "@/components/widget/DynamicSidebar.svelte";
import { dynamicConfig, profileConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import {
	avatarMotionOverride,
	isDynamicAvatar,
	resolveRawAvatarUrl,
} from "@/utils/avatar-utils";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const configuredLimit = widgetConfig?.specificConfig?.dynamic?.limit ?? 3;
const limit = Math.max(1, Math.floor(configuredLimit));

const apiUrl = dynamicConfig.apiUrl?.startsWith("http")
	? dynamicConfig.apiUrl
	: url(dynamicConfig.apiUrl || "/api/dynamic.json");
const memos = dynamicConfig.memos;

const profileUrl = url(dynamicConfig.profileUrl || "/about/");

// 弹窗条目需要头像的最终 URL，这里把本地资源先交给 Astro 生成一次
async function resolveAvatar(src: string): Promise<string> {
	if (!src) return "";
	// 动图/视频必须直出原始文件，getImage 只会保留第一帧
	if (avatarMotionOverride() ?? isDynamicAvatar(src)) {
		return resolveRawAvatarUrl(src);
	}
	if (
		src.startsWith("/") ||
		src.startsWith("http://") ||
		src.startsWith("https://") ||
		src.startsWith("data:")
	) {
		return url(src);
	}
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif}",
		{ import: "default" },
	);
	const key = path.normalize(path.join("../../", src)).replace(/\\/g, "/");
	const loader = files[key];
	if (!loader) return "";
	try {
		const image = await loader();
		return (await getImage({ src: image, width: 96, format: "webp" })).src;
	} catch {
		return "";
	}
}

const avatarUrl = await resolveAvatar(profileConfig.avatar || "");
// 视频头像在弹窗里用 <video> 渲染，封面先顶上避免闪一下空白
const avatarPosterUrl = profileConfig.avatarPoster
	? resolveRawAvatarUrl(profileConfig.avatarPoster)
	: "";
---

{
	siteConfig.pages.dynamic && (
		<WidgetLayout
			name={i18n(I18nKey.latestDynamics)}
			showTitle={showTitle}
			id="latest-dynamics"
			class={className}
			style={style}
		>
			<DynamicSidebar
				client:visible
				apiUrl={apiUrl}
				limit={limit}
				{memos}
				profileName={profileConfig.name}
				{profileUrl}
				{avatarUrl}
				avatarPosterUrl={avatarPosterUrl}
			/>
		</WidgetLayout>
	)
}
