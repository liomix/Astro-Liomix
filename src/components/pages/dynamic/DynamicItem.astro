---
import { type CollectionEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import DynamicActions from "@/components/pages/dynamic/DynamicActions.astro";
import DynamicGallery from "@/components/pages/dynamic/DynamicGallery.astro";
import DynamicInlineComments from "@/components/pages/dynamic/DynamicInlineComments.astro";
import { dynamicConfig, profileConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatDynamicDate } from "@/utils/date-utils";
import { dynamicAnchor } from "@/utils/dynamic-utils";
import { url } from "@/utils/url-utils";

interface Props {
	entry: CollectionEntry<"dynamic">;
	detailUrl?: string;
	showInlineComments?: boolean;
	commentPath?: string;
}

const {
	entry,
	detailUrl,
	showInlineComments = false,
	commentPath,
} = Astro.props;
const { Content } = await render(entry);
const anchorId = dynamicAnchor(entry.id);
const published = formatDynamicDate(entry.data.published);
const permalink = detailUrl || `#${anchorId}`;
const profileLabel = i18n(I18nKey.dynamicProfile).replace(
	"{name}",
	profileConfig.name,
);
const profileUrl = url(dynamicConfig.profileUrl || "/about/");
---

<dynamic-entry
	id={anchorId}
	class="page-entry card-base"
	data-dynamic-entry
	data-like-id={entry.id}
	data-year={entry.data.published.getUTCFullYear()}
>
	<article aria-labelledby={`${anchorId}-author`}>
		<header class="page-entry-header">
			<a href={profileUrl} class="page-avatar" aria-label={profileLabel}>
				<ImageWrapper
					src={profileConfig.avatar || ""}
					alt={profileConfig.name}
					widths={[112]}
					sizes="56px"
					loading="lazy"
				/>
			</a>
			<div class="page-identity">
				<a href={profileUrl} class="page-author" aria-label={profileLabel}>
					<strong id={`${anchorId}-author`}>{profileConfig.name}</strong>
				</a>
				{entry.data.pinned && (
					<span class="page-pinned-badge">
						<Icon name="material-symbols:push-pin" class="size-3" />
						{i18n(I18nKey.pinned)}
					</span>
				)}
			</div>
		</header>

		<div id={`${anchorId}-content`} class="page-content custom-md">
			<Content />
		</div>
		<DynamicGallery sourceId={`${anchorId}-content`} />

		<footer class="page-footer">
			<a class="page-time" href={permalink} data-dynamic-permalink>
				<time datetime={entry.data.published.toISOString()}>
					{published}
				</time>
			</a>
			<DynamicActions />
		</footer>

		{showInlineComments && commentPath && (
			<DynamicInlineComments
				src={`/dynamic/comments/?path=${encodeURIComponent(commentPath)}`}
				showToggle={false}
			/>
		)}
	</article>
</dynamic-entry>
