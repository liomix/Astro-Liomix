---
/**
 * Telegram 风格聊天界面（评论抽屉的内容页）
 * ---------------------------------------------------------------------------
 * 按 Telegram Android 客户端的私聊页复刻：
 *   气泡 17px 圆角 + 靠发送者一侧的 6px 小角（源码 SharedConfig.bubbleRadius = 17，
 *   近侧角 Math.min(6, bubbleRadius)）；对方白/深灰气泡靠左、自己浅绿/蓝气泡靠右；
 *   时间贴在气泡右下角（不放已读回执的双勾）；底部是输入栏，右侧纸飞机
 *   （空输入时灰、有文字才点亮成蓝色）。表情面板按 Telegram 的 emoji 键盘做，
 *   底部一排分类 tab 切换不同类型的表情。
 *
 * 群聊式头像：对方消息左侧跟一个首字母彩圆（Telegram 没有用户头像时的默认画法），
 * 连发多条只在最后一条下方露头像、只在第一条上方显示昵称 —— 和 Telegram 分组规则一致。
 *
 * 所有消息（示例消息和自己发出去的）都按 GitHub Flavored Markdown 解析
 * （粗体、斜体、删除线、行内代码 / 代码块、列表、引用、链接、表格、换行），
 * 解析结果先过一遍标签白名单再塞进气泡，避免脚本注入。
 * 代码块会补一条「语言 + 复制」的顶栏：marked 只吐标准的 <pre><code class="language-x">，
 * 顶栏和复制按钮在消毒之后由 DOM 拼（见 decorateCodeBlocks），白名单不用为 button 开口子。
 * 输入框是会自动长高的 textarea：Enter 发送、Shift+Enter 换行，方便写多行 Markdown。
 *
 * 消息目前是内置示例（静态站没有后端），发送只是本地追加一条气泡，不落库。
 * 以后接真实评论数据时，只要把 messages 换成接口返回即可。
 */
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	/** 消息数据来源标识（当前仅用于 data 属性，方便以后接接口） */
	path?: string;
	/** 默认昵称：访客还没设置过身份时，顶栏与弹窗先填这个值 */
	name?: string;
	/** 默认邮箱：同上，来自站点配置里的 Email 链接 */
	contact?: string;
	/** 关闭按钮的无障碍文案 */
	closeLabel?: string;
}

const {
	path = "/dynamic/",
	name = "",
	contact = "",
	closeLabel = "Close",
} = Astro.props;

/** 没有头像图时用首字母彩圆，和 Telegram 无头像账号的画法一致 */
const initial = (name.trim().slice(0, 1) || "?").toUpperCase();

interface ChatMessage {
	/** in = 对方（来访者）/ out = 自己 */
	side: "in" | "out";
	/** 对方昵称；out 消息不需要 */
	author?: string;
	/** 头像色调，对应 .tg-avatar--0…3 的渐变 */
	tone?: number;
	text: string;
	/** 相对当前时间的分钟偏移，脚本会换算成 HH:mm */
	offset: number;
}

const messages: ChatMessage[] = [
	{
		side: "in",
		author: "阿柴",
		tone: 0,
		text: "你这篇写缓存的我看两遍了，四层兜底那段讲得真清楚 👍",
		offset: -11,
	},
	{
		side: "out",
		text: "谢谢！主要是踩坑踩出来的，被限流那次印象太深了",
		offset: -10,
	},
	{
		side: "in",
		author: "阿柴",
		tone: 0,
		text: "后来那个 `WEREAD_COOLDOWN` 你设了多久？",
		offset: -8,
	},
	{
		side: "out",
		text: "**15 分钟**。触发一次就全局停手，宁可少抓几次也别把 `Key` 玩废",
		offset: -7,
	},
	{
		side: "in",
		author: "木子",
		tone: 1,
		text: "稳，这套我抄走了",
		offset: -6,
	},
	{
		side: "in",
		author: "木子",
		tone: 1,
		text: "我那边先这么写的：\n\n```ts\nconst ttl = 15 * 60_000;\n```\n\n反正被限流以后，*少抓几次* 比什么都强。",
		offset: -5,
	},
];

/** 同一个人连续发言时，只有第一条显示昵称、最后一条露头像（Telegram 的分组规则） */
const rows = messages.map((message, index) => {
	const prev = messages[index - 1];
	const next = messages[index + 1];
	const samePrev = message.side === "in" && prev?.side === "in" && prev.author === message.author;
	const sameNext = message.side === "in" && next?.side === "in" && next.author === message.author;
	return {
		...message,
		showAuthor: message.side === "in" && !samePrev,
		showAvatar: message.side === "in" && !sameNext,
		initial: (message.author || "?").slice(0, 1),
	};
});

/**
 * 表情面板按 Telegram 的 emoji 键盘分栏：底部一排分类 tab，点哪个显示哪一类。
 * 图标用单色描边 SVG（Telegram 的 tab 就是单色线稿，不是彩色 emoji）。
 * 没有「旗帜」一栏 —— 里面全是国家/地区旗帜，站内不适合出现。
 */
interface EmojiCategory {
	id: string;
	label: string;
	/** tab 图标（svg 子节点，样式由 .tg-emoji-tab-icon 统一描边） */
	icon: string;
	emojis: string[];
}

const emojiCategories: EmojiCategory[] = [
	{
		id: "smileys",
		label: i18n(I18nKey.commentChatCatSmileys),
		icon: '<circle cx="12" cy="12" r="8.6"/><path d="M8.6 14.3a4.2 4.2 0 0 0 6.8 0"/><circle cx="9.2" cy="10" r="0.9" fill="currentColor" stroke="none"/><circle cx="14.8" cy="10" r="0.9" fill="currentColor" stroke="none"/>',
		emojis: [
			"😀", "😃", "😄", "😁", "😆", "😅", "😂", "🤣",
			"😊", "😇", "🙂", "🙃", "😉", "😌", "😍", "🥰",
			"😘", "😋", "😛", "😜", "🤪", "🤨", "🧐", "🤓",
			"😎", "🥳", "😏", "😒", "🙄", "😴", "🥲", "😭",
		],
	},
	{
		id: "animals",
		label: i18n(I18nKey.commentChatCatAnimals),
		icon: '<circle cx="7" cy="9.6" r="1.6"/><circle cx="11" cy="8.2" r="1.6"/><circle cx="15.4" cy="9" r="1.6"/><circle cx="12.2" cy="15.6" r="3.1"/><circle cx="18" cy="12.6" r="1.5"/>',
		emojis: [
			"🐶", "🐱", "🐭", "🐹", "🐰", "🦊", "🐻", "🐼",
			"🐨", "🐯", "🦁", "🐮", "🐷", "🐸", "🐵", "🙈",
			"🐔", "🐧", "🐦", "🦆", "🦉", "🦄", "🐝", "🦋",
			"🐌", "🐞", "🐢", "🐍", "🐙", "🦀", "🐳", "🐬",
		],
	},
	{
		id: "food",
		label: i18n(I18nKey.commentChatCatFood),
		icon: '<path d="M6.4 9.2h9.2v5.2a4 4 0 0 1-4 4h-1.2a4 4 0 0 1-4-4z"/><path d="M15.6 10.4h1.5a2.4 2.4 0 0 1 0 4.8h-1.5"/><path d="M5.4 20.4h11"/>',
		emojis: [
			"🍎", "🍊", "🍋", "🍌", "🍉", "🍇", "🍓", "🍒",
			"🥑", "🍅", "🌽", "🥕", "🍞", "🧀", "🍳", "🥓",
			"🍔", "🍟", "🍕", "🌭", "🍜", "🍣", "🍰", "🍩",
			"☕", "🍵", "🧋", "🍺", "🍷", "🥂", "🍫", "🍿",
		],
	},
	{
		id: "activity",
		label: i18n(I18nKey.commentChatCatActivity),
		icon: '<circle cx="12" cy="12" r="8.4"/><path d="M12 3.6c3 2.4 3 14.4 0 16.8M3.6 12h16.8"/>',
		emojis: [
			"⚽", "🏀", "🏈", "⚾", "🎾", "🏐", "🏓", "🏸",
			"🥊", "🎯", "🎳", "🎮", "🎲", "🧩", "🎨", "🎬",
			"🎤", "🎧", "🎸", "🎹", "🥁", "🎺", "🏆", "🥇",
			"🎉", "🎊", "🎈", "🎁", "🎂", "🎪", "🎡", "🎠",
		],
	},
	{
		id: "travel",
		label: i18n(I18nKey.commentChatCatTravel),
		icon: '<path d="M3.4 20.4 21 12 3.4 3.6l3.1 7.2 9 1.2-9 1.2z"/>',
		emojis: [
			"🚗", "🚕", "🚙", "🚌", "🚎", "🏎️", "🚓", "🚑",
			"🚒", "🚐", "🚚", "🚜", "🛴", "🚲", "🛵", "🏍️",
			"✈️", "🚀", "🛸", "🚁", "⛵", "🚤", "🚂", "🚄",
			"🗺️", "🗽", "🗼", "🏰", "🏖️", "🏔️", "🌋", "🌈",
		],
	},
	{
		id: "objects",
		label: i18n(I18nKey.commentChatCatObjects),
		icon: '<path d="M9.4 17.6h5.2"/><path d="M10.2 20.2h3.6"/><path d="M12 3.4a5.8 5.8 0 0 1 3.4 10.5v1.2a1.4 1.4 0 0 1-1.4 1.4h-4a1.4 1.4 0 0 1-1.4-1.4v-1.2A5.8 5.8 0 0 1 12 3.4Z"/>',
		emojis: [
			"💡", "🔦", "🕯️", "💻", "🖥️", "⌨️", "🖱️", "📱",
			"📷", "🎥", "📺", "📻", "⏰", "⏳", "🔋", "🔌",
			"📦", "📫", "📝", "✏️", "📌", "📎", "🔖", "📚",
			"💰", "💳", "🔑", "🔨", "🛠️", "🧲", "🧪", "🔬",
		],
	},
	{
		id: "symbols",
		label: i18n(I18nKey.commentChatCatSymbols),
		icon: '<path d="M12 20.2 4.9 13.1a4.6 4.6 0 0 1 6.5-6.5l.6.6.6-.6a4.6 4.6 0 0 1 6.5 6.5Z"/>',
		emojis: [
			"❤️", "🧡", "💛", "💚", "💙", "💜", "🖤", "🤍",
			"💔", "💕", "💖", "💗", "💘", "💝", "✨", "⭐",
			"🌟", "💫", "⚡", "🔥", "💥", "💦", "🌀", "☀️",
			"🌙", "☁️", "❄️", "✅", "❌", "❓", "❗", "💯",
		],
	},
];
---

<div
	class="tg-chat"
	data-tg-chat
	data-tg-path={path}
	data-tg-label-copy={i18n(I18nKey.commentChatCopy)}
	data-tg-label-copied={i18n(I18nKey.commentChatCopied)}
	data-tg-label-code={i18n(I18nKey.commentChatCode)}
	data-tg-default-name={name}
	data-tg-default-email={contact}
	data-tg-ci-sub-empty={i18n(I18nKey.commentInfoSubEmpty)}
	data-tg-ci-name-required={i18n(I18nKey.commentInfoNameRequired)}
	data-tg-ci-email-invalid={i18n(I18nKey.commentInfoEmailInvalid)}
	data-identity-ready="false"
>
	{/* 壁纸画在聊天页自己身上：顶栏、消息区、输入栏同处一个文档，
	    顶栏与输入栏的 backdrop-filter 直接采样它 —— 不需要任何跨文档技巧 */}
	<div class="tg-wallpaper" data-tg-wallpaper aria-hidden="true"></div>

	<header class="tg-head">
		{/* 顶栏整块就是「我的评论身份」入口：点开是 CommentInfoPop。
		    头像/昵称/邮箱由脚本按 localStorage 里存的身份覆盖这里的初始值，
		    初始值取站点配置（昵称 + Email 链接），这样没设置过的访客也不是一片空白 */}
		<button
			type="button"
			class="tg-head-id"
			data-ci-open
			aria-haspopup="dialog"
			aria-label={i18n(I18nKey.commentInfoOpen)}
		>
			<span
				class="tg-head-avatar"
				data-ci-head-avatar
				data-has-image="false"
				aria-hidden="true"
			>
				<img data-avatar-img alt="" decoding="async" hidden />
				<span data-avatar-initial>{initial}</span>
			</span>
			<span class="tg-head-text">
				<span class="tg-head-title" data-ci-head-name>{name}</span>
				<span class="tg-head-sub" data-ci-head-sub>{contact}</span>
			</span>
			<span class="tg-head-edit" aria-hidden="true">
				<svg viewBox="0 0 24 24" focusable="false">
					{/* 铅笔 + 笔杆分界线：线稿比原来那支实心笔更轻，小尺寸下轮廓也不会糊成一团 */}
					<path
						d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
					<path
						d="M15 5l4 4"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
					/>
				</svg>
			</span>
		</button>
		{
			/* 关闭按钮常驻 DOM，只在「装在抽屉里」时显示：
			   这一页是预渲染的静态路由，查询参数到不了服务端，
			   显隐由 CommentLayout 在首屏前打的 html[data-embedded] 标记决定 */
			<button
				type="button"
				class="tg-head-close"
				data-tg-close
				title={closeLabel}
				aria-label={closeLabel}
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path
						d="M6 6 18 18M18 6 6 18"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					/>
				</svg>
			</button>
		}
	</header>

	<div class="tg-scroll" data-tg-scroll>
		<div class="tg-day"><span>{i18n(I18nKey.commentChatToday)}</span></div>

		{
			rows.map((row) => (
				<div
					class:list={[
						"tg-row",
						row.side === "in" ? "tg-row--in" : "tg-row--out",
						row.side === "in" && row.showAvatar && "tg-row--tail",
					]}
				>
					{/* 只有一组连发的最后一条才露头像；其余各条靠 padding-left 留空位，
					   不能把头像留在 DOM 里 —— 它仍占着 flex 宽度，会和 padding 叠一起把气泡挤到右边 */}
					{row.side === "in" && row.showAvatar && (
						<span
							class={`tg-avatar tg-avatar--${row.tone ?? 0}`}
							aria-hidden="true"
						>
							{row.initial}
						</span>
					)}
					<div class="tg-col">
						{row.showAuthor && (
							<span class={`tg-author tg-author--${row.tone ?? 0}`}>
								{row.author}
							</span>
						)}
						<div class="tg-bubble">
							<div class="tg-text tg-text--md" data-tg-markdown>{row.text}</div>
							<span class="tg-meta">
								<span class="tg-time" data-tg-time data-tg-offset={row.offset} />
							</span>
						</div>
					</div>
				</div>
			))
		}
	</div>

	<div class="tg-bottom">
		<div class="tg-emoji-panel" data-tg-emoji-panel hidden>
			<div class="tg-emoji-body" data-tg-emoji-body>
				{
					emojiCategories.map((category, index) => (
						<div
							class="tg-emoji-grid"
							id={`tg-emoji-cat-${category.id}`}
							data-tg-emoji-cat={category.id}
							hidden={index !== 0}
						>
							{category.emojis.map((emoji) => (
								<button
									type="button"
									class="tg-emoji-item"
									data-tg-emoji-insert
									aria-label={emoji}
								>
									{emoji}
								</button>
							))}
						</div>
					))
				}
			</div>

			<div class="tg-emoji-tabs" role="tablist">
				{
					emojiCategories.map((category, index) => (
						<button
							type="button"
							class="tg-emoji-tab"
							role="tab"
							data-tg-emoji-tab={category.id}
							aria-selected={index === 0 ? "true" : "false"}
							aria-controls={`tg-emoji-cat-${category.id}`}
							title={category.label}
							aria-label={category.label}
						>
							<svg
								class="tg-emoji-tab-icon"
								viewBox="0 0 24 24"
								aria-hidden="true"
								set:html={category.icon}
							/>
						</button>
					))
				}
			</div>
		</div>

		<form class="tg-composer" data-tg-composer>
			<button
				type="button"
				class="tg-tool"
				data-tg-attach
				title={i18n(I18nKey.commentChatAttach)}
				aria-label={i18n(I18nKey.commentChatAttach)}
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M20.4 11.3 12 19.7a5.6 5.6 0 0 1-7.9-7.9l8.6-8.6a3.7 3.7 0 0 1 5.3 5.3l-8.5 8.5a1.9 1.9 0 0 1-2.6-2.6l7.6-7.6"
					/>
				</svg>
			</button>

			<div class="tg-input-wrap">
				<textarea
					class="tg-input"
					name="message"
					rows="1"
					autocomplete="off"
					writingsuggestions="false"
					placeholder={i18n(I18nKey.commentChatPlaceholder)}
					aria-label={i18n(I18nKey.commentChatPlaceholder)}
					data-tg-input></textarea>
				<button
					type="button"
					class="tg-emoji"
					data-tg-emoji
					aria-expanded="false"
					title={i18n(I18nKey.commentChatEmoji)}
					aria-label={i18n(I18nKey.commentChatEmoji)}
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="8.6"></circle>
						<path d="M8.6 14.3a4.2 4.2 0 0 0 6.8 0"></path>
						<circle cx="9.2" cy="10" r="0.9" fill="currentColor" stroke="none"
						></circle>
						<circle cx="14.8" cy="10" r="0.9" fill="currentColor" stroke="none"
						></circle>
					</svg>
				</button>
			</div>

			<button class="tg-send" type="submit" aria-label={i18n(I18nKey.commentChatSend)} data-tg-send>
				<svg class="tg-send-plane" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M3.4 20.4 21 12 3.4 3.6l3.1 7.2 9 1.2-9 1.2z" fill="currentColor" />
				</svg>
			</button>

			<input
				type="file"
				accept="image/*"
				class="tg-file"
				data-tg-file
				tabindex="-1"
				aria-hidden="true"
			/>

			{/* 身份没填完时这层盖住整条输入栏，点它直接打开 CommentInfoPop。
			    用覆盖层而不是逐个控件绑事件：textarea 被 disabled 之后根本不派发
			    点击事件，包一层最省事，表情 / 附件 / 发送也一并挡住 */}
			<button
				type="button"
				class="tg-composer-lock"
				data-ci-open
				aria-haspopup="dialog"
			>
				{i18n(I18nKey.commentInfoLocked)}
			</button>
		</form>
	</div>

	{/* CommentInfoPop：评论信息弹窗。铺满整个聊天页（.tg-chat 是 position: relative），
	    和顶栏、输入栏同处一个文档，主题变量直接可用，不涉及任何跨 iframe 通信 */}
	<div class="ci-pop" data-ci-pop hidden>
		<div class="ci-mask" data-ci-mask></div>
		<div
			class="ci-card"
			role="dialog"
			aria-modal="true"
			aria-labelledby="comment-info-title"
		>
			<div class="ci-head">
				<span class="ci-title" id="comment-info-title">
					{i18n(I18nKey.commentInfoTitle)}
				</span>
				<button
					type="button"
					class="ci-close"
					data-ci-close
					aria-label={i18n(I18nKey.tabClose)}
					title={i18n(I18nKey.tabClose)}
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							d="M6 6 18 18M18 6 6 18"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
						/>
					</svg>
				</button>
			</div>

			<div class="ci-body">
				{/* 头像单独一行、居中：它是这张卡片的视觉主体，说明文字已经去掉 */}
				<div class="ci-avatar-row">
					<span class="ci-avatar" data-ci-avatar data-has-image="false">
						<img data-avatar-img alt="" decoding="async" hidden />
						<span data-avatar-initial>?</span>
					</span>
				</div>

				<label class="ci-field">
					<span class="ci-label">{i18n(I18nKey.commentInfoName)}</span>
					<input
						class="ci-input"
						type="text"
						name="comment-name"
						maxlength="24"
						autocomplete="nickname"
						data-ci-name
						placeholder={i18n(I18nKey.commentInfoNamePlaceholder)}
					/>
				</label>

				<label class="ci-field">
					<span class="ci-label">{i18n(I18nKey.commentInfoEmail)}</span>
					<input
						class="ci-input"
						type="email"
						name="comment-email"
						maxlength="64"
						autocomplete="email"
						data-ci-email
						placeholder={i18n(I18nKey.commentInfoEmailPlaceholder)}
					/>
				</label>

				<p class="ci-error" data-ci-error hidden></p>
			</div>

			<div class="ci-foot">
				<button type="button" class="ci-btn" data-ci-cancel>
					{i18n(I18nKey.commentInfoCancel)}
				</button>
				<button type="button" class="ci-btn ci-btn--primary" data-ci-save>
					{i18n(I18nKey.commentInfoSave)}
				</button>
			</div>
		</div>
	</div>
</div>

<!-- 自己发出去的气泡模板，脚本克隆用 -->
<template data-tg-out-template>
	<div class="tg-row tg-row--out">
		<div class="tg-col">
			<div class="tg-bubble">
				<div class="tg-text tg-text--md"></div>
				<span class="tg-meta">
					<span class="tg-time"></span>
				</span>
			</div>
		</div>
	</div>
</template>

<script>
	import { initCommentInfo } from "@/components/pages/dynamic/comment-info";
	import { mountChatWallpaper } from "@/components/pages/dynamic/comment-wallpaper";
	import { Marked } from "marked";

	const pad = (value: number) => String(value).padStart(2, "0");

	function stamp(offsetMinutes: number): string {
		const date = new Date(Date.now() + offsetMinutes * 60_000);
		return `${pad(date.getHours())}:${pad(date.getMinutes())}`;
	}

	/* ---------------- Markdown ---------------- */

	/** 只建一次实例：GFM（表格 / 删除线 / 自动链接）+ 单换行也算换行 */
	const md = new Marked({ gfm: true, breaks: true });

	/** 语言标识 → 顶栏显示名；表里没有的原样显示，没写语言的用「代码」兜底 */
	const LANG_NAMES: Record<string, string> = {
		js: "JavaScript",
		javascript: "JavaScript",
		ts: "TypeScript",
		typescript: "TypeScript",
		jsx: "JSX",
		tsx: "TSX",
		py: "Python",
		python: "Python",
		sh: "Shell",
		bash: "Bash",
		zsh: "Zsh",
		shell: "Shell",
		powershell: "PowerShell",
		ps1: "PowerShell",
		json: "JSON",
		jsonc: "JSON",
		html: "HTML",
		xml: "XML",
		svg: "SVG",
		css: "CSS",
		scss: "SCSS",
		less: "Less",
		md: "Markdown",
		markdown: "Markdown",
		yml: "YAML",
		yaml: "YAML",
		toml: "TOML",
		ini: "INI",
		sql: "SQL",
		go: "Go",
		golang: "Go",
		rust: "Rust",
		rs: "Rust",
		java: "Java",
		kt: "Kotlin",
		kotlin: "Kotlin",
		swift: "Swift",
		c: "C",
		cpp: "C++",
		cs: "C#",
		csharp: "C#",
		php: "PHP",
		rb: "Ruby",
		ruby: "Ruby",
		lua: "Lua",
		diff: "Diff",
		patch: "Diff",
		dockerfile: "Dockerfile",
		makefile: "Makefile",
		vue: "Vue",
		svelte: "Svelte",
		astro: "Astro",
		graphql: "GraphQL",
		gql: "GraphQL",
		text: "",
		plaintext: "",
	};
	/** 气泡里允许出现的标签，marked 的其余输出一律处理掉 */
	const SAFE_TAGS = new Set([
		"P",
		"BR",
		"STRONG",
		"EM",
		"DEL",
		"CODE",
		"PRE",
		"A",
		"UL",
		"OL",
		"LI",
		"BLOCKQUOTE",
		"H1",
		"H2",
		"H3",
		"H4",
		"H5",
		"H6",
		"HR",
		"TABLE",
		"THEAD",
		"TBODY",
		"TR",
		"TH",
		"TD",
		"IMG",
	]);

	/** 这些标签连内容一起丢掉，不只是拆壳（否则脚本正文会当成文字留在气泡里） */
	const DROP_TAGS = new Set([
		"SCRIPT",
		"STYLE",
		"IFRAME",
		"OBJECT",
		"EMBED",
		"FORM",
		"INPUT",
		"TEXTAREA",
		"SELECT",
		"BUTTON",
		"LINK",
		"META",
		"BASE",
		"SVG",
		"MATH",
	]);

	/**
	 * 用浏览器自己的解析器过一遍白名单，比正则可靠：
	 * 先把 HTML 塞进 template（不执行、不加载资源），再逐个节点判断。
	 * 不认识的标签拆壳保留文字；危险标签整段删除；属性只留必要的那几个。
	 */
	function sanitizeHtml(html: string): string {
		const template = document.createElement("template");
		template.innerHTML = html;

		const walk = (parent: Node) => {
			for (const child of Array.from(parent.childNodes)) {
				if (child.nodeType === Node.COMMENT_NODE) {
					child.remove();
					continue;
				}
				if (child.nodeType !== Node.ELEMENT_NODE) continue;

				const el = child as Element;
				const tag = el.tagName.toUpperCase();

				if (DROP_TAGS.has(tag)) {
					el.remove();
					continue;
				}

				// 先净化里面的内容，再把外壳拆掉（拆完文字直接挂在父节点上）
				walk(el);
				if (!SAFE_TAGS.has(tag)) {
					el.replaceWith(...Array.from(el.childNodes));
					continue;
				}

				for (const attr of Array.from(el.attributes)) {
					const name = attr.name.toLowerCase();
					const keep =
						(tag === "A" && (name === "href" || name === "title")) ||
						(tag === "IMG" && (name === "src" || name === "alt" || name === "title")) ||
						(tag === "CODE" && name === "class") ||
						(tag === "TH" && name === "align") ||
						(tag === "TD" && name === "align");
					if (!keep) el.removeAttribute(attr.name);
				}

				if (tag === "A") {
					const href = el.getAttribute("href") ?? "";
					// 只放行 http(s) / mailto / 站内锚点，javascript: 之类直接摘掉链接
					if (!/^(?:https?:|mailto:|#|\/)/i.test(href)) {
						el.removeAttribute("href");
					}
					el.setAttribute("target", "_blank");
					el.setAttribute("rel", "noopener noreferrer nofollow");
				}

				// 图片只认 http(s) 和站内地址；地址不合法就连图带标签一起删掉，
				// 不留一个破图占位。外链图不发送 Referer，也不阻塞首屏。
				if (tag === "IMG") {
					const src = el.getAttribute("src") ?? "";
					if (!/^(?:https?:\/\/|\/[^/])/i.test(src)) {
						el.remove();
						continue;
					}
					el.setAttribute("loading", "lazy");
					el.setAttribute("decoding", "async");
					el.setAttribute("referrerpolicy", "no-referrer");
				}
			}
		};

		walk(template.content);
		return template.innerHTML;
	}

	/** 把 Markdown 渲染成可安全插入气泡的 HTML */
	function renderMarkdown(text: string): string {
		return sanitizeHtml(md.parse(text) as string);
	}

	/** 代码块顶栏要用的三条文案，由 Astro 那边按语言渲染好传进来 */
	interface CodeLabels {
		copy: string;
		copied: string;
		code: string;
	}

	/**
	 * 给代码块补一条「语言 + 复制」的顶栏。
	 * 这一步放在消毒之后：白名单要是放行 button，注入面就跟着变大，
	 * 索性让 marked 只吐标准的 <pre><code class="language-x">，按钮由我们自己拼。
	 */
	function decorateCodeBlocks(root: HTMLElement, labels: CodeLabels): void {
		for (const pre of root.querySelectorAll("pre")) {
			const code = pre.querySelector("code");
			if (!code) continue;

			const lang = (
				code.className.match(/language-([\w+#.-]+)/)?.[1] ?? ""
			).toLowerCase();

			const block = document.createElement("div");
			block.className = "tg-code";

			const head = document.createElement("div");
			head.className = "tg-code-head";

			const name = document.createElement("span");
			name.className = "tg-code-lang";
			name.textContent = LANG_NAMES[lang] ?? (lang || labels.code);

			const copy = document.createElement("button");
			copy.type = "button";
			copy.className = "tg-code-copy";
			copy.dataset.tgCopy = "";
			copy.textContent = labels.copy;

			head.append(name, copy);
			pre.replaceWith(block);
			block.append(head, pre);
		}
	}

	/** 渲染一段 Markdown 到气泡里：解析 → 消毒 → 补代码块顶栏 */
	function setMarkdown(target: HTMLElement, text: string, labels: CodeLabels): void {
		target.innerHTML = renderMarkdown(text);
		decorateCodeBlocks(target, labels);
	}

	/** 复制文本：优先 Clipboard API，拿不到权限（老浏览器 / 非安全上下文）就退回 execCommand */
	async function copyText(text: string): Promise<boolean> {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			const area = document.createElement("textarea");
			area.value = text;
			area.setAttribute("readonly", "");
			area.style.cssText = "position:fixed;top:0;left:-9999px;opacity:0";
			document.body.append(area);
			area.select();
			const ok = document.execCommand("copy");
			area.remove();
			return ok;
		}
	}

	function init() {
		const chat = document.querySelector<HTMLElement>("[data-tg-chat]");
		if (!chat) return;

		// 壁纸垫在最底层：顶栏与输入栏的毛玻璃都从它上面采样
		mountChatWallpaper(chat);

		// 评论身份（昵称 / 邮箱 / 头像）与弹窗：放在其余初始化之前，
		// 它会决定输入栏是不是锁着，晚了会先闪一下「可以输入」的状态
		initCommentInfo(chat);

		// 这一页是预渲染的静态路由，构建期拿不到 ?path=，只能在这里按地址栏补一次
		const pathParam = new URLSearchParams(window.location.search).get("path");
		if (pathParam) chat.dataset.tgPath = pathParam;

		const scroller = chat.querySelector<HTMLElement>("[data-tg-scroll]");
		const form = chat.querySelector<HTMLFormElement>("[data-tg-composer]");
		const input = chat.querySelector<HTMLTextAreaElement>("[data-tg-input]");
		const emojiButton = chat.querySelector<HTMLButtonElement>("[data-tg-emoji]");
		const emojiPanel = chat.querySelector<HTMLElement>("[data-tg-emoji-panel]");
		const attachButton = chat.querySelector<HTMLButtonElement>("[data-tg-attach]");
		const fileInput = chat.querySelector<HTMLInputElement>("[data-tg-file]");
		const template = document.querySelector<HTMLTemplateElement>(
			"[data-tg-out-template]",
		);
		if (!scroller || !form || !input || !template) return;

		// 示例消息的时间按“刚刚发生的对话”倒推，硬编码的 21:04 半夜看会很怪
		chat.querySelectorAll<HTMLElement>("[data-tg-offset]").forEach((node) => {
			node.textContent = stamp(Number(node.dataset.tgOffset) || 0);
		});

		// 代码块顶栏的文案由服务端按当前语言渲染，避免在客户端再引一套 i18n
		const labels: CodeLabels = {
			copy: chat.dataset.tgLabelCopy || "Copy",
			copied: chat.dataset.tgLabelCopied || "Copied",
			code: chat.dataset.tgLabelCode || "Code",
		};

		// 示例消息的正文同样按 Markdown 解析：SSR 出来的只是原文，
		// 这里先读 textContent 再覆盖，原文不会被当成 HTML 二次转义
		chat.querySelectorAll<HTMLElement>("[data-tg-markdown]").forEach((node) => {
			setMarkdown(node, node.textContent ?? "", labels);
		});

		// 复制按钮用事件委托：消息是后插进来的，不能逐条绑
		chat.addEventListener("click", (event) => {
			const target = event.target as Element | null;
			const button = target?.closest<HTMLButtonElement>("[data-tg-copy]");
			if (!button) return;
			const code = button.closest(".tg-code")?.querySelector("code");
			if (!code) return;

			const source = (code.textContent ?? "").replace(/\s+$/, "");
			void copyText(source).then((ok) => {
				if (!ok) return;
				button.textContent = labels.copied;
				button.dataset.copied = "true";
				window.setTimeout(() => {
					button.textContent = labels.copy;
					button.dataset.copied = "false";
				}, 1600);
			});
		});

		const toBottom = () => {
			scroller.scrollTop = scroller.scrollHeight;
		};
		toBottom();

		// 空输入时纸飞机是灰的、有内容才点亮成蓝色
		const syncSend = () => {
			chat.dataset.hasText = input.value.trim() ? "true" : "false";
		};

		// textarea 会随内容长高（上限交给 CSS 的 max-height，超出后内部滚动）
		const resizeInput = () => {
			input.style.height = "auto";
			input.style.height = `${input.scrollHeight}px`;
		};

		input.addEventListener("input", () => {
			syncSend();
			resizeInput();
		});

		// Enter 发送、Shift+Enter 换行 —— textarea 默认会把 Enter 当换行，得拦下来
		input.addEventListener("keydown", (event) => {
			if (event.key !== "Enter" || event.shiftKey || event.isComposing) return;
			event.preventDefault();
			form.requestSubmit();
		});

		syncSend();
		resizeInput();

		/* ---------------- 表情面板 ---------------- */

		const setEmojiOpen = (open: boolean) => {
			if (!emojiPanel || !emojiButton) return;
			emojiPanel.hidden = !open;
			emojiButton.setAttribute("aria-expanded", open ? "true" : "false");
			chat.dataset.emojiOpen = open ? "true" : "false";
			if (open) toBottom();
		};

		const closeEmoji = () => setEmojiOpen(false);

		emojiButton?.addEventListener("click", () => {
			setEmojiOpen(Boolean(emojiPanel?.hidden));
		});

		// 分类 tab：点哪个就露出对应那一类，其余收起（Telegram emoji 键盘的行为）
		const emojiBody = chat.querySelector<HTMLElement>("[data-tg-emoji-body]");
		const emojiTabs = Array.from(
			chat.querySelectorAll<HTMLElement>("[data-tg-emoji-tab]"),
		);
		const emojiGrids = Array.from(
			chat.querySelectorAll<HTMLElement>("[data-tg-emoji-cat]"),
		);

		const selectCategory = (id: string) => {
			for (const tab of emojiTabs) {
				tab.setAttribute(
					"aria-selected",
					tab.dataset.tgEmojiTab === id ? "true" : "false",
				);
			}
			for (const grid of emojiGrids) {
				grid.hidden = grid.dataset.tgEmojiCat !== id;
			}
			// 换分类时回到该类的顶部，否则会停在上一类的滚动位置
			if (emojiBody) emojiBody.scrollTop = 0;
		};

		for (const tab of emojiTabs) {
			tab.addEventListener("click", () => {
				const id = tab.dataset.tgEmojiTab;
				if (id) selectCategory(id);
			});
		}

		// 点表情插入到光标处（和 Telegram 一样贴光标，不是无脑追加到末尾），
		// 面板保持打开，可以连着点几个
		chat.querySelectorAll<HTMLElement>("[data-tg-emoji-insert]").forEach((item) => {
			item.addEventListener("click", () => {
				const emoji = item.textContent?.trim() ?? "";
				if (!emoji) return;
				const start = input.selectionStart ?? input.value.length;
				const end = input.selectionEnd ?? start;
				input.value = input.value.slice(0, start) + emoji + input.value.slice(end);
				const caret = start + emoji.length;
				input.focus({ preventScroll: true });
				input.setSelectionRange(caret, caret);
				syncSend();
			});
		});

		document.addEventListener("pointerdown", (event) => {
			if (!emojiPanel || emojiPanel.hidden) return;
			const target = event.target as Node | null;
			if (!target) return;
			if (
				emojiPanel.contains(target) ||
				emojiButton?.contains(target) ||
				attachButton?.contains(target)
			) {
				return;
			}
			closeEmoji();
		});

		// Esc：面板开着就先收面板，已经收起了就把「关抽屉」交给父窗口
		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return;
			if (emojiPanel && !emojiPanel.hidden) {
				closeEmoji();
				return;
			}
			requestClose();
		});

		// ---------------- 发送图片 ----------------

		const appendPhoto = (file: File) => {
			const row = (template.content.cloneNode(true) as DocumentFragment)
				.firstElementChild as HTMLElement | null;
			if (!row) return;
			const text = row.querySelector<HTMLElement>(".tg-text");
			const bubble = row.querySelector<HTMLElement>(".tg-bubble");
			const time = row.querySelector<HTMLElement>(".tg-time");
			if (text && bubble) {
				const photo = document.createElement("img");
				photo.className = "tg-photo";
				photo.alt = file.name;
				photo.src = URL.createObjectURL(file);
				// 图加载完就能释放 blob，不必等页面关掉
				photo.addEventListener(
					"load",
					() => URL.revokeObjectURL(photo.src),
					{ once: true },
				);
				text.replaceWith(photo);
				bubble.classList.add("tg-bubble--photo");
			}
			if (time) time.textContent = stamp(0);

			scroller.append(row);
			requestAnimationFrame(toBottom);
		};

		attachButton?.addEventListener("click", () => fileInput?.click());
		fileInput?.addEventListener("change", () => {
			const file = fileInput.files?.[0];
			if (!file) return;
			appendPhoto(file);
			// 清空才能连续选同一张图
			fileInput.value = "";
		});

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			const text = input.value.trim();
			if (!text) return;

			const row = (template.content.cloneNode(true) as DocumentFragment)
				.firstElementChild as HTMLElement | null;
			if (!row) return;
			const body = row.querySelector<HTMLElement>(".tg-text");
			const time = row.querySelector<HTMLElement>(".tg-time");
			if (body) {
				// 模板里的 .tg-text 已经带 tg-text--md，直接按 Markdown 渲染进去
				setMarkdown(body, text, labels);
			}
			if (time) time.textContent = stamp(0);

			scroller.append(row);
			input.value = "";
			syncSend();
			resizeInput();
			closeEmoji();
			// 等浏览器完成一次布局再滚，否则新气泡高度还算不出来
			requestAnimationFrame(toBottom);
			input.focus({ preventScroll: true });
		});
	}

	/* ---------------- 与评论抽屉（父窗口）的桥 ---------------- */

	/**
	 * 抽屉的收起只能由父窗口做（几何、焦点、触发按钮都在那边），
	 * 这里只把「想关」传出去。独立访问这个页面时没有父窗口，什么也不做。
	 */
	function requestClose(): void {
		if (window.parent === window) return;
		window.parent.postMessage(
			{ type: "dynamic-comment-close" },
			window.location.origin,
		);
	}

	// 关闭按钮只在抽屉里渲染（embedded），独立访问时这个查询是空的
	document
		.querySelector<HTMLElement>("[data-tg-close]")
		?.addEventListener("click", requestClose);

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init, { once: true });
	} else {
		init();
	}
</script>
