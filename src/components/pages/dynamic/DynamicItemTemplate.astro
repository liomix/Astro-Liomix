---
import { Icon } from "astro-icon/components";
import "@/styles/markdown.css";
import "@/styles/markdown-extend.styl";
import AvatarImage from "@/components/common/AvatarImage.astro";
import DynamicActions from "@/components/pages/dynamic/DynamicActions.astro";
import DynamicGallery from "@/components/pages/dynamic/DynamicGallery.astro";
import DynamicInlineComments from "@/components/pages/dynamic/DynamicInlineComments.astro";
import { dynamicConfig, profileConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { avatarMotionOverride } from "@/utils/avatar-utils";
import { url } from "@/utils/url-utils";

const profileLabel = i18n(I18nKey.dynamicProfile).replace(
	"{name}",
	profileConfig.name,
);
const profileUrl = url(dynamicConfig.profileUrl || "/");
---

<template data-dynamic-item-template>
	<dynamic-entry class="page-entry card-base" data-dynamic-entry>
		<article>
			<header class="page-entry-header">
				<a href={profileUrl} class="page-avatar" aria-label={profileLabel}>
					<AvatarImage
						src={profileConfig.avatar || ""}
						alt={profileConfig.name}
						widths={[112]}
						sizes="56px"
						loading="lazy"
						fadeIn={false}
						animated={avatarMotionOverride()}
						poster={profileConfig.avatarPoster}
					/>
				</a>
				<div class="page-identity">
					<a href={profileUrl} class="page-author" aria-label={profileLabel}>
						<strong data-dynamic-author>{profileConfig.name}</strong>
					</a>
					<span class="page-pinned-badge" data-dynamic-pinned hidden>
						<Icon name="material-symbols:push-pin" class="size-3" />
						{i18n(I18nKey.pinned)}
					</span>
				</div>
			</header>

			<div class="page-content custom-md" data-dynamic-content></div>
			<DynamicGallery sourceId="dynamic-template-content" />

			<footer class="page-footer">
				<a class="page-time" data-dynamic-permalink>
					<time data-dynamic-time></time>
				</a>
				<DynamicActions />
			</footer>

			<DynamicInlineComments src="" showToggle={false} />
		</article>
	</dynamic-entry>
</template>
