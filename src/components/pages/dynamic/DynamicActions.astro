---
import CommentButton from "@/components/common/CommentButton.astro";
import LikeButton from "@/components/common/LikeButton.astro";

/**
 * 动态卡片底部操作条：点赞 / 评论
 * 交互逻辑统一在 dynamic-actions.ts 里通过事件委托处理；
 * 两个图标都是 <dynamic-lottie-icon>（点赞爱心 / 评论气泡），
 * 元素本身在 dynamic-lottie-icon.ts 里注册，页面、模板克隆、侧栏弹窗共用。
 * 数字由 formatCompactNumber 统一格式化（万级缩写成 1.6w）。
 */

interface Props {
	/** 点赞基数（数据源里带的初始值，访客自己那一票另算） */
	likes?: number;
	/** 评论数（本站没接评论服务时就是 0） */
	comments?: number;
}

// 动态流是模板克隆出来的，基数由 DynamicFeed 事后写到按钮上；
// 静态渲染的条目（详情页）直接把值交给这里
const { likes = 0, comments = 0 } = Astro.props;
---

<div class="atom-actions">
	<LikeButton count={likes} />
	<CommentButton drawer count={comments} />
</div>


