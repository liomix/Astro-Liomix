---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

/**
 * 动态卡片底部操作条：点赞 / 评论
 * 交互逻辑统一在 dynamic-actions.ts 里通过事件委托处理
 */

const likeLabel = i18n(I18nKey.dynamicLike);
const commentLabel = i18n(I18nKey.dynamicComment);
---

<div class="dynamic-actions">
	<button
		type="button"
		class="dynamic-action"
		data-dynamic-like
		aria-pressed="false"
		aria-label={likeLabel}
		title={likeLabel}
	>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path
				d="M2 20h2c.55 0 1-.45 1-1v-9c0-.55-.45-1-1-1H2v11zm19.83-7.12c.11-.25.17-.52.17-.8V11c0-1.1-.9-2-2-2h-5.5l.92-4.65c.05-.22.02-.46-.08-.66-.23-.45-.52-.86-.88-1.22L14 2 7.59 8.41C7.21 8.79 7 9.3 7 9.83v7.84C7 18.95 8.05 20 9.34 20h8.11c.7 0 1.36-.37 1.72-.97l2.66-6.15z"
			></path>
		</svg>
	</button>

	<button
		type="button"
		class="dynamic-action"
		data-dynamic-comment
		aria-label={commentLabel}
		title={commentLabel}
	>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z" />
		</svg>
	</button>
</div>

<style>
	.dynamic-actions {
		display: flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.125rem;
	}

	.dynamic-action {
		display: inline-flex;
		width: 2.25rem;
		height: 2.25rem;
		align-items: center;
		justify-content: center;
		border: 0;
		border-radius: 9999px;
		background: transparent;
		color: var(--content-meta);
		cursor: pointer;
		transition: color 0.16s ease, background-color 0.16s ease;
	}

	.dynamic-action svg {
		width: 1.35rem;
		height: 1.35rem;
		fill: currentColor;
	}

	.dynamic-action:hover {
		background: var(--btn-regular-bg);
		color: var(--primary);
	}

	.dynamic-action:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 1px;
	}

	.dynamic-action.is-active {
		color: var(--primary);
	}
</style>
