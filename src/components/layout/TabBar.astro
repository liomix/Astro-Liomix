---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";

const homeUrl = url("/");

// 文案通过 JSON 交给客户端脚本，避免在 ts 里再引一遍 i18n
const labels = {
	close: i18n(I18nKey.tabClose),
	refresh: i18n(I18nKey.tabRefresh),
	closeCurrent: i18n(I18nKey.tabCloseCurrent),
	closeOthers: i18n(I18nKey.tabCloseOthers),
	closeAll: i18n(I18nKey.tabCloseAll),
	closeLeft: i18n(I18nKey.tabCloseLeft),
	closeRight: i18n(I18nKey.tabCloseRight),
	pin: i18n(I18nKey.tabPin),
	unpin: i18n(I18nKey.tabUnpin),
	untitled: i18n(I18nKey.tabUntitled),
	clear: i18n(I18nKey.tabClear),
};
---

<!-- 多标签导航栏：左侧 home 常驻，中间标签页由脚本渲染，右侧垃圾桶（暂只做 UI） -->
<div
  id="tab-bar"
  class="card-base tab-bar p-3 onload-animation"
  data-home-url={homeUrl}
  aria-label={i18n(I18nKey.tabBarLabel)}
>
  <div class="tab-bar-inner">
    <a
      href={homeUrl}
      class="tab-home focus-ring-inset"
      data-tab-home
      data-home-entry
      aria-label={i18n(I18nKey.home)}
      title={i18n(I18nKey.home)}
    >
      <Icon name="material-symbols:home" />
    </a>

    <div class="tab-divider" aria-hidden="true"></div>

    <div class="tab-scroll-area">
      <div class="tab-strip" role="tablist"></div>
    </div>

    <div class="tab-divider" aria-hidden="true"></div>

    <button
      class="tab-trash focus-ring-inset"
      type="button"
      data-tab-trash
      aria-label={i18n(I18nKey.tabClear)}
      title={i18n(I18nKey.tabClear)}
    >
      <Icon name="material-symbols:delete-outline-rounded" />
    </button>
  </div>
</div>

<div id="tab-menu" class="tab-menu" hidden></div>

<script
  type="application/json"
  id="tab-bar-i18n"
  set:html={JSON.stringify(labels)}
/>

<script>
  import { goHomeFromEntry, initHomeEntryLinks } from "@/utils/home-entry";

  type Tab = { key: string; title: string; pinned: boolean };
  type TabNode = {
    item: HTMLElement;
    link: HTMLAnchorElement;
    close: HTMLButtonElement;
    /** 上次写入的标题，用来跳过无变化的 DOM 写入 */
    title: string;
  };
  type Snapshot = {
    y: number;
    fields: { value: string; checked: boolean }[];
  };
  type MenuEntry = {
    label?: string;
    separator?: boolean;
    disabled?: boolean;
    run?: () => void;
  };

  type TabBarWindow = Window & {
    swup?: { navigate?: (url: string) => void };
    __tabBarInit?: boolean;
  };

  const STORAGE_KEY = "firefly-tabs-v1";
  const CLOSE_SVG =
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>';
  const PIN_SVG =
    '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16 3a1 1 0 0 1 1 1v1h2a1 1 0 0 1 0 2h-.3l-1.2 4.2 1.9 2.5A1 1 0 0 1 18.6 15H13v5.6a1 1 0 0 1-2 0V15H5.4a1 1 0 0 1-.8-1.3l1.9-2.5L5.3 7H5a1 1 0 0 1 0-2h2V4a1 1 0 0 1 1-1h8z"/></svg>';

  const bar = document.getElementById("tab-bar");
  const strip = bar?.querySelector<HTMLElement>(".tab-strip") ?? null;
  const homeBtn = bar?.querySelector<HTMLElement>("[data-tab-home]") ?? null;
  const menu = document.getElementById("tab-menu");

  let labels: Record<string, string> = {};
  try {
    const raw = document.getElementById("tab-bar-i18n")?.textContent;
    if (raw) labels = JSON.parse(raw);
  } catch {
    labels = {};
  }

  function normalizeKey(target: URL): string {
    return `${target.pathname}${target.search}`;
  }

  const HOME_KEY = normalizeKey(
    new URL(bar?.dataset.homeUrl || "/", location.href || "http://localhost/"),
  );

  let tabs: Tab[] = [];
  let activeKey = "";
  /** 每个标签页的滚动位置与表单值快照（只在内存里，刷新即失效） */
  const snapshots = new Map<string, Snapshot>();
  let lastNav = { key: "", at: 0 };
  let suppressClick = false;

  /** key → 已创建的 DOM 节点。切页只做状态/顺序更新，不再整条重建 */
  const tabNodes = new Map<string, TabNode>();
  /** 固定组与普通组之间的竖线，常驻复用 */
  let pinDivider: HTMLElement | null = null;

  function keyOfLocation(): string {
    return normalizeKey(new URL(location.href));
  }

  function readStored(): void {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const data = JSON.parse(raw) as { tabs?: unknown; active?: unknown };
      if (Array.isArray(data.tabs)) {
        tabs = data.tabs
          .filter(
            (item): item is Tab =>
              !!item &&
              typeof (item as Tab).key === "string" &&
              typeof (item as Tab).title === "string",
          )
          .map((item) => ({
            key: item.key,
            title: item.title,
            pinned: !!item.pinned,
          }))
          .filter((item) => item.key !== HOME_KEY);
        // 固定标签恒在最前（存储顺序可能被打乱过）
        tabs = [...tabs.filter((item) => item.pinned), ...tabs.filter((item) => !item.pinned)];
      }
      if (typeof data.active === "string") activeKey = data.active;
    } catch {
      /* 忽略损坏的存储 */
    }
  }

  /**
   * 同一轮事件里可能连续触发多次保存（关闭标签 → 高亮 → 跳转），
   * 用微任务合并成一次 JSON + localStorage 写入，减少同步 IO。
   */
  let saveScheduled = false;
  function save(): void {
    if (saveScheduled) return;
    saveScheduled = true;
    queueMicrotask(() => {
      saveScheduled = false;
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ tabs, active: activeKey }),
        );
      } catch {
        /* 隐私模式下可能抛错 */
      }
    });
  }

  /** 页面标题：优先用主内容里的 h1（带参路由由页面自己填），退回 document.title */
  function pageTitle(): string {
    const h1 = document.querySelector<HTMLElement>(
      "#swup-container > h1, #swup-container h1",
    );
    const fromHeading = h1?.textContent?.trim();
    if (fromHeading) return fromHeading;

    const docTitle = (document.title || "").trim();
    const cut = docTitle.split(/\s*[|｜·—]\s*/)[0]?.trim();
    return cut || labels.untitled || "Untitled";
  }

  /** 创建一个标签节点（每个 key 只建一次，固定/普通共用同一套子节点，靠 CSS 切换形态） */
  function createTabNode(tab: Tab): TabNode {
    const item = document.createElement("div");
    item.className = "tab-item";
    item.dataset.key = tab.key;
    item.draggable = false;
    item.setAttribute("role", "tab");

    const pin = document.createElement("span");
    pin.className = "tab-pin";
    pin.innerHTML = PIN_SVG;
    item.appendChild(pin);

    const link = document.createElement("a");
    link.className = "tab-link";
    link.href = tab.key;
    link.draggable = false;
    item.appendChild(link);

    const close = document.createElement("button");
    close.type = "button";
    close.className = "tab-close";
    close.dataset.tabClose = "";
    close.setAttribute("aria-label", labels.close || "Close");
    close.innerHTML = CLOSE_SVG;
    item.appendChild(close);

    const node: TabNode = { item, link, close, title: "" };
    applyNodeState(node, tab);
    return node;
  }

  /** 只写变化的属性，避免每次渲染都碰一遍 DOM */
  function applyNodeState(node: TabNode, tab: Tab): void {
    if (node.title !== tab.title) {
      node.title = tab.title;
      node.link.textContent = tab.title;
      node.link.title = tab.title;
      node.item.title = tab.title;
    }

    const pinned = tab.pinned;
    if (pinned !== node.item.hasAttribute("data-pinned")) {
      if (pinned) node.item.dataset.pinned = "";
      else node.item.removeAttribute("data-pinned");
    }

    const active = tab.key === activeKey;
    if (active !== node.item.hasAttribute("data-active")) {
      if (active) node.item.dataset.active = "";
      else node.item.removeAttribute("data-active");
    }
  }

  function render(): void {
    if (!strip) return;

    const desired: HTMLElement[] = [];
    let lastPinned = -1;

    for (const tab of tabs) {
      let node = tabNodes.get(tab.key);
      if (node) applyNodeState(node, tab);
      else {
        node = createTabNode(tab);
        tabNodes.set(tab.key, node);
      }
      if (tab.pinned) lastPinned = desired.length;
      desired.push(node.item);
    }

    if (lastPinned >= 0) {
      let divider = pinDivider;
      if (!divider) {
        divider = document.createElement("div");
        divider.className = "tab-pin-divider";
        divider.setAttribute("aria-hidden", "true");
        pinDivider = divider;
      }
      desired.splice(lastPinned + 1, 0, divider);
    }

    // 最小移动：只有位置不对的节点才 insertBefore，全对时零 DOM 操作
    for (let i = 0; i < desired.length; i++) {
      const want = desired[i];
      if (!want) continue;
      const current = strip.children[i];
      if (current !== want) strip.insertBefore(want, current ?? null);
    }
    while (strip.children.length > desired.length) {
      strip.lastElementChild?.remove();
    }

    // 回收已关闭标签的节点与缓存
    if (tabNodes.size !== tabs.length) {
      const alive = new Set(tabs.map((tab) => tab.key));
      for (const [key, node] of tabNodes) {
        if (alive.has(key)) continue;
        node.item.remove();
        tabNodes.delete(key);
      }
    }

    syncHomeState();
  }

  function syncHomeState(): void {
    if (!homeBtn) return;
    const isHome = keyOfLocation() === HOME_KEY;
    if (isHome === homeBtn.hasAttribute("data-active")) return;
    if (isHome) homeBtn.dataset.active = "";
    else homeBtn.removeAttribute("data-active");
  }

  function ensureTab(key: string, title: string): Tab {
    const existing = tabs.find((tab) => tab.key === key);
    if (existing) {
      // 带参路由 / 动态标题：每次进入都刷新名字
      if (title && existing.title !== title) existing.title = title;
      return existing;
    }

    const tab: Tab = {
      key,
      title: title || labels.untitled || "Untitled",
      pinned: false,
    };
    const index = tabs.findIndex((item) => item.key === activeKey);
    if (index < 0) {
      tabs.push(tab);
      return tab;
    }
    // 新标签紧跟当前标签；但当前标签若在固定组里，要落到固定组之后，别插进固定区
    let insertAt = index + 1;
    if (tabs[index]?.pinned) {
      while (tabs[insertAt]?.pinned) insertAt++;
    }
    tabs.splice(insertAt, 0, tab);
    return tab;
  }

  function navigate(key: string): void {
    if (!key) return;
    // 用 key 而不是 location.href 比较，避免 hash 导致误判
    if (key === keyOfLocation()) {
      activeKey = key === HOME_KEY ? "" : key;
      render();
      return;
    }

    // 回首页统一走「回首页入口」逻辑：落到内容区，而不是 hero 顶部
    if (key === HOME_KEY) {
      activeKey = "";
      save();
      render();
      goHomeFromEntry();
      return;
    }

    // 路由去重防抖：短时间内连点同一个目标只跳一次
    const now = Date.now();
    if (key === lastNav.key && now - lastNav.at < 200) return;
    lastNav = { key, at: now };

    // 先高亮，跳转（含网络等待）期间就能看到目标标签被选中
    activeKey = key;
    render();

    const href = new URL(key, location.origin).href;
    const swup = (window as TabBarWindow).swup;
    if (swup?.navigate) swup.navigate(href);
    else location.href = href;
  }

  function currentTabKey(): string {
    return activeKey || HOME_KEY;
  }

  function collectFields(): Snapshot["fields"] {
    const nodes = document.querySelectorAll<
      HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
    >("#swup-container input, #swup-container textarea, #swup-container select");
    return Array.from(nodes)
      .filter((node) => !(node instanceof HTMLInputElement) || node.type !== "file")
      .map((node) => ({
        value: node.value,
        checked: node instanceof HTMLInputElement ? node.checked : false,
      }));
  }

  function applyFields(fields: Snapshot["fields"]): void {
    const nodes = document.querySelectorAll<
      HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
    >("#swup-container input, #swup-container textarea, #swup-container select");
    const usable = Array.from(nodes).filter(
      (node) => !(node instanceof HTMLInputElement) || node.type !== "file",
    );
    if (usable.length !== fields.length) return;

    usable.forEach((node, index) => {
      const field = fields[index];
      if (!field) return;
      node.value = field.value;
      if (node instanceof HTMLInputElement && node.type === "checkbox") {
        node.checked = field.checked;
      }
    });
  }

  /** 切走前保存当前标签的滚动位置与表单输入 */
  function captureSnapshot(): void {
    snapshots.set(currentTabKey(), {
      y: window.scrollY,
      fields: collectFields(),
    });
  }

  /** 切回来时恢复（滚动要晚于 swup 自己的回顶操作） */
  function restoreSnapshot(key: string): void {
    const snap = snapshots.get(key);
    if (!snap) return;
    applyFields(snap.fields);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => window.scrollTo(0, snap.y));
    });
  }

  function onPageView(): void {
    const key = keyOfLocation();

    if (key === HOME_KEY) {
      activeKey = "";
      save();
      render();
      restoreSnapshot(HOME_KEY);
      return;
    }

    ensureTab(key, pageTitle());
    activeKey = key;
    save();
    render();
    restoreSnapshot(key);
  }

  function closeTab(key: string): void {
    const index = tabs.findIndex((tab) => tab.key === key);
    if (index < 0) return;

    const wasActive = key === activeKey;
    tabs.splice(index, 1);
    snapshots.delete(key);

    if (!wasActive) {
      save();
      render();
      return;
    }

    // 关闭当前：优先激活右侧相邻，其次左侧，最后回首页
    const next = tabs[index] ?? tabs[index - 1];
    if (next) {
      activeKey = next.key;
      save();
      render();
      navigate(next.key);
    } else {
      activeKey = "";
      save();
      render();
      navigate(HOME_KEY);
    }
  }

  function closeOthers(key: string): void {
    const kept = tabs.filter((tab) => tab.pinned || tab.key === key);
    for (const tab of tabs) {
      if (!kept.includes(tab)) snapshots.delete(tab.key);
    }
    tabs = kept;
    if (!tabs.some((tab) => tab.key === activeKey)) {
      activeKey = key;
      save();
      render();
      navigate(key);
      return;
    }
    save();
    render();
  }

  function closeAll(): void {
    const kept = tabs.filter((tab) => tab.pinned);
    for (const tab of tabs) {
      if (!kept.includes(tab)) snapshots.delete(tab.key);
    }
    tabs = kept;
    if (!tabs.some((tab) => tab.key === activeKey)) {
      activeKey = "";
      save();
      render();
      if (keyOfLocation() !== HOME_KEY) navigate(HOME_KEY);
      return;
    }
    save();
    render();
  }

  function closeSide(index: number, side: "left" | "right"): void {
    const target = tabs[index];
    if (!target) return;

    const removed =
      side === "left" ? tabs.slice(0, index) : tabs.slice(index + 1);
    const kept = tabs.filter((tab, i) =>
      tab.pinned || (side === "left" ? i >= index : i <= index),
    );
    for (const tab of removed) {
      if (kept.includes(tab)) continue;
      snapshots.delete(tab.key);
    }
    tabs = kept;

    if (!tabs.some((tab) => tab.key === activeKey)) {
      activeKey = target.key;
      save();
      render();
      navigate(target.key);
      return;
    }
    save();
    render();
  }

  function togglePin(key: string): void {
    const tab = tabs.find((item) => item.key === key);
    if (!tab) return;
    tab.pinned = !tab.pinned;
    // 固定标签排到最前（home 之外）
    tabs = [
      ...tabs.filter((item) => item.pinned),
      ...tabs.filter((item) => !item.pinned),
    ];
    save();
    render();
  }

  function refreshTab(key: string): void {
    if (key === keyOfLocation()) {
      location.reload();
      return;
    }
    navigate(key);
  }

  // ── 右键菜单 ────────────────────────────────────────────────
  function hideMenu(): void {
    if (menu) menu.hidden = true;
  }

  function positionMenu(x: number, y: number): void {
    if (!menu) return;
    menu.style.left = "0px";
    menu.style.top = "0px";
    menu.hidden = false;
    const rect = menu.getBoundingClientRect();
    const left = Math.min(x, window.innerWidth - rect.width - 8);
    const top = Math.min(y, window.innerHeight - rect.height - 8);
    menu.style.left = `${Math.max(8, left)}px`;
    menu.style.top = `${Math.max(8, top)}px`;
  }

  function buildMenu(entries: MenuEntry[]): void {
    if (!menu) return;
    const frag = document.createDocumentFragment();
    for (const entry of entries) {
      if (entry.separator) {
        const line = document.createElement("div");
        line.className = "tab-menu-separator";
        frag.appendChild(line);
        continue;
      }
      const button = document.createElement("button");
      button.type = "button";
      button.className = "tab-menu-item";
      button.textContent = entry.label ?? "";
      if (entry.disabled) button.disabled = true;
      button.addEventListener("click", () => {
        hideMenu();
        entry.run?.();
      });
      frag.appendChild(button);
    }
    menu.replaceChildren(frag);
  }

  function openMenu(x: number, y: number, key: string): void {
    const index = tabs.findIndex((tab) => tab.key === key);
    const tab = tabs[index];
    if (!tab) return;

    const leftTargets = tabs.slice(0, index).some((item) => !item.pinned);
    const rightTargets = tabs.slice(index + 1).some((item) => !item.pinned);

    buildMenu([
      { label: labels.refresh, run: () => refreshTab(key) },
      { separator: true },
      { label: labels.closeCurrent, run: () => closeTab(key) },
      { label: labels.closeOthers, run: () => closeOthers(key) },
      {
        label: labels.closeLeft,
        run: () => closeSide(index, "left"),
        disabled: !leftTargets,
      },
      {
        label: labels.closeRight,
        run: () => closeSide(index, "right"),
        disabled: !rightTargets,
      },
      { label: labels.closeAll, run: closeAll },
      { separator: true },
      {
        label: tab.pinned ? labels.unpin : labels.pin,
        run: () => togglePin(key),
      },
    ]);
    positionMenu(x, y);
  }

  /** 拖拽排序：固定组与普通组各自内部排序，不互相跨越 */
  function bindDrag(): void {
    if (!strip) return;

    let drag: {
      el: HTMLElement;
      pointerId: number;
      startX: number;
      startY: number;
      active: boolean;
      /** 拖动期间标签集合固定，按下时取一次就够，别每帧再查 DOM */
      items: HTMLElement[];
      /** 指针相对标签左边界的偏移，拖动时保持这个抓取点跟手 */
      grab: number;
    } | null = null;

    // 一帧只量一次布局：pointermove 高频触发，直接在里面量会疯狂强制重排
    let frame = 0;
    let pendingX = 0;

    // <a> 默认是原生 draggable，长按会触发浏览器拖拽并 pointercancel 掉我们自己的拖拽
    strip.addEventListener("dragstart", (event) => event.preventDefault());

    const sameGroup = (a: Element, pinned: boolean) =>
      a.hasAttribute("data-pinned") === pinned;

    /**
     * FLIP：先量视觉位置 → 取消进行中的动画 → 改 DOM → 量新位置 → 用 WAAPI 补间。
     * 位移差值用「视觉位 - 布局位」，所以连续快速拖动时也能从当前画面接着滑，不会跳。
     * `skip` 是被拖着的那个标签：它由 transform 跟手，不参与补间。
     */
    function reorder(
      items: HTMLElement[],
      skip: HTMLElement | null,
      apply: () => void,
    ): void {
      if (!strip) return;
      const first = items.map((el) => el.getBoundingClientRect());
      for (const el of items) {
        for (const anim of el.getAnimations()) {
          // 只掐 transform 上的补间，别把 hover 的颜色过渡也一起取消掉
          const prop = (anim as CSSTransition).transitionProperty;
          if (prop && prop !== "transform") continue;
          anim.cancel();
        }
      }

      apply();

      items.forEach((el, index) => {
        if (el === skip) return;
        const from = first[index];
        if (!from) return;
        const now = el.getBoundingClientRect();
        const dx = from.left - now.left;
        const dy = from.top - now.top;
        if (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5) return;
        el.animate(
          [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "none" }],
          { duration: 180, easing: "cubic-bezier(0.2, 0, 0, 1)" },
        );
      });
    }

    function moveTo(x: number): void {
      if (!drag || !strip) return;
      const el = drag.el;
      const pinned = el.hasAttribute("data-pinned");
      const siblings = drag.items.filter(
        (item) => item !== el && sameGroup(item, pinned),
      );

      // 用 offsetLeft/offsetWidth 而不是 getBoundingClientRect：
      // 后者含正在跑的补间位移，拿它算中线会在动画期间来回抖。
      const pointer = x - strip.getBoundingClientRect().left;
      // 标签当前应该出现在哪儿：抓取点贴着指针
      const offset = pointer - (el.offsetLeft + drag.grab);
      // 换位判定用「标签视觉中心」，这样抓左边缘还是右边缘手感一致
      const center = el.offsetLeft + el.offsetWidth / 2 + offset;

      if (siblings.length) {
        let ref: HTMLElement | null = null;
        for (const sibling of siblings) {
          if (center < sibling.offsetLeft + sibling.offsetWidth / 2) {
            ref = sibling;
            break;
          }
        }

        if (ref) {
          if (el.nextElementSibling !== ref)
            reorder(drag.items, el, () => strip?.insertBefore(el, ref));
        } else {
          // 落在同组最后一个之后：插到它后面（固定组后面还跟着分隔线，会被顺势推开）
          const last = siblings[siblings.length - 1];
          if (last && last.nextElementSibling !== el)
            reorder(drag.items, el, () => last.after(el));
        }
      }

      // 换位后 offsetLeft 变了，重算一次，让标签始终贴着指针、不闪跳
      el.style.transform = `translate3d(${
        pointer - (el.offsetLeft + drag.grab)
      }px, 0, 0)`;
    }

    function scheduleMove(x: number): void {
      pendingX = x;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        moveTo(pendingX);
      });
    }

    strip.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      const target = event.target as Element | null;
      if (target?.closest("[data-tab-close]")) return;
      const item = target?.closest<HTMLElement>(".tab-item");
      if (!item) return;
      drag = {
        el: item,
        pointerId: event.pointerId,
        startX: event.clientX,
        startY: event.clientY,
        active: false,
        items: Array.from(strip.querySelectorAll<HTMLElement>(".tab-item")),
        grab: event.clientX - item.getBoundingClientRect().left,
      };
      // 这里不能 preventDefault：触屏下取消 pointerdown 会连带吞掉 click。
      // 原生拖拽交给 draggable=false + dragstart 拦截，选中交给 user-select: none。
    });

    window.addEventListener("pointermove", (event) => {
      if (!drag || event.pointerId !== drag.pointerId) return;
      const dx = event.clientX - drag.startX;
      const dy = event.clientY - drag.startY;

      if (!drag.active) {
        // 竖直方向占优时不动，留给页面滚动
        if (Math.abs(dx) < 6 || Math.abs(dx) <= Math.abs(dy)) return;
        drag.active = true;
        drag.el.classList.add("tab-dragging");
        strip.classList.add("tab-sorting");
        document.body.classList.add("tab-dragging-cursor");
        try {
          drag.el.setPointerCapture(drag.pointerId);
        } catch {
          /* 部分环境不支持捕获，靠 window 监听即可 */
        }
      }

      event.preventDefault();
      scheduleMove(event.clientX);
    });

    const finish = (event: PointerEvent) => {
      if (!drag || event.pointerId !== drag.pointerId) return;
      const el = drag.el;
      const active = drag.active;
      drag = null;

      if (frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }

      if (active) {
        // 松手：让标签从指针位置滑回它自己的槽位，别直接瞬移
        const visual = el.getBoundingClientRect();
        el.style.transform = "";
        const dx = visual.left - el.getBoundingClientRect().left;
        if (Math.abs(dx) > 0.5) {
          el.animate(
            [{ transform: `translate(${dx}px, 0)` }, { transform: "none" }],
            { duration: 170, easing: "cubic-bezier(0.2, 0, 0, 1)" },
          );
        }
      } else {
        el.style.transform = "";
      }

      el.classList.remove("tab-dragging");
      strip?.classList.remove("tab-sorting");
      document.body.classList.remove("tab-dragging-cursor");
      try {
        el.releasePointerCapture(event.pointerId);
      } catch {
        /* 已经释放 */
      }

      if (!active) return;

      suppressClick = true;
      window.setTimeout(() => {
        suppressClick = false;
      }, 0);

      const order = Array.from(
        strip?.querySelectorAll<HTMLElement>(".tab-item") ?? [],
      ).map((item) => item.dataset.key ?? "");
      tabs = [...tabs].sort((a, b) => order.indexOf(a.key) - order.indexOf(b.key));
      save();
      // 重新渲染一次，保证固定组在最前、分隔线位置正确
      render();
    };

    window.addEventListener("pointerup", finish);
    window.addEventListener("pointercancel", finish);
  }

  // ── 吸顶状态 ────────────────────────────────────────────────
  // 滚动吸顶由 layout-base.css 的 #tab-bar-wrapper 负责（siteConfig.tabBarSticky 可关闭），
  // 这里只负责在「确实吸住」时打上 is-stuck，好让半透明卡片换成实色底 + 阴影
  let stickyTop = 12;
  let stuckFrame = 0;

  // 关闭吸顶时 wrapper 带 data-sticky="false"，此时不测量、也不切类
  function stickyWrapper(): HTMLElement | null {
    const wrap = bar?.parentElement;
    return wrap && wrap.dataset.sticky !== "false" ? wrap : null;
  }

  function readStickyTop(): void {
    const wrap = stickyWrapper();
    if (!wrap) return;
    const value = Number.parseFloat(getComputedStyle(wrap).top);
    if (Number.isFinite(value)) stickyTop = value;
  }

  function syncStuck(): void {
    const wrap = stickyWrapper();
    if (!wrap) return;
    const stuck = wrap.getBoundingClientRect().top <= stickyTop + 0.5;
    if (stuck !== wrap.classList.contains("is-stuck")) {
      wrap.classList.toggle("is-stuck", stuck);
    }
  }

  function scheduleStuck(): void {
    if (stuckFrame) return;
    stuckFrame = requestAnimationFrame(() => {
      stuckFrame = 0;
      syncStuck();
    });
  }

  // ── 交互绑定 ────────────────────────────────────────────────
  function bindBar(): void {
    if (!strip || !bar) return;

    strip.addEventListener("click", (event) => {
      const target = event.target as Element | null;
      const item = target?.closest<HTMLElement>(".tab-item");
      if (!item) return;

      const key = item.dataset.key ?? "";
      if (target?.closest("[data-tab-close]")) {
        event.preventDefault();
        event.stopPropagation();
        closeTab(key);
        return;
      }

      if (suppressClick) {
        event.preventDefault();
        return;
      }
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      event.preventDefault();
      navigate(key);
    });

    // 中键关闭
    strip.addEventListener("auxclick", (event) => {
      if (event.button !== 1) return;
      const item = (event.target as Element | null)?.closest<HTMLElement>(
        ".tab-item",
      );
      if (!item) return;
      event.preventDefault();
      closeTab(item.dataset.key ?? "");
    });

    strip.addEventListener("contextmenu", (event) => {
      const item = (event.target as Element | null)?.closest<HTMLElement>(
        ".tab-item",
      );
      if (!item) return;
      event.preventDefault();
      openMenu(event.clientX, event.clientY, item.dataset.key ?? "");
    });

    // 关闭菜单
    document.addEventListener("pointerdown", (event) => {
      if (!menu || menu.hidden) return;
      if (event.target instanceof Node && menu.contains(event.target)) return;
      hideMenu();
    });
    window.addEventListener("blur", hideMenu);
    window.addEventListener("resize", hideMenu);

    bindDrag();
  }

  if (bar && strip) {
    // 菜单挂到 body：避免被祖先元素的 transform / overflow 影响 fixed 定位
    if (menu && menu.parentElement !== document.body) {
      document.body.appendChild(menu);
    }

    readStored();
    onPageView();

    if (!(window as TabBarWindow).__tabBarInit) {
      (window as TabBarWindow).__tabBarInit = true;
      bindBar();
      // home 按钮与「分类栏/悬浮按钮」的回首页入口走同一套逻辑（落到内容区而不是 hero 顶部）
      initHomeEntryLinks();

      // 吸顶状态：只切一次类，滚动路径不做布局测量以外的写入；关闭吸顶时不挂监听
      if (bar.parentElement?.dataset.sticky !== "false") {
        readStickyTop();
        syncStuck();
        window.addEventListener("scroll", scheduleStuck, { passive: true });
        window.addEventListener("resize", () => {
          readStickyTop();
          scheduleStuck();
        });
      }

      // 离开页面前保存当前标签的状态（滚动 / 表单），回来时恢复
      document.addEventListener("astro:before-swap", () => {
        hideMenu();
        captureSnapshot();
      });
      document.addEventListener("astro:page-load", () => {
        onPageView();
        readStickyTop();
        scheduleStuck();
      });

      // 没有 swup 时（直链、原生跳转）退化处理
      window.addEventListener("popstate", () => {
        window.setTimeout(onPageView, 0);
      });
    }
  }
</script>

<style>
  .tab-bar {
    margin-bottom: 1rem;
  }
  .tab-bar-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tab-home,
  .tab-trash {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--btn-content) 12%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--btn-content) 6%, transparent);
    color: var(--btn-content);
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .tab-home:hover,
  .tab-trash:hover {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 15%, transparent);
    border-color: color-mix(in srgb, var(--primary) 25%, transparent);
  }
  .tab-home[data-active] {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    border-color: color-mix(in srgb, var(--primary) 28%, transparent);
  }
  .tab-divider {
    flex: 0 0 auto;
    width: 1px;
    align-self: stretch;
    background: var(--line-divider);
    opacity: 0.5;
  }
  .tab-scroll-area {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  /* 标签过多时不横向滚动，而是不断压缩每个标签的宽度 */
  .tab-strip {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    /* 竖向滑动仍然交给页面滚动，横向手势留给我们做拖拽排序 */
    touch-action: pan-y;
  }

  /* 单个标签：参考分类胶囊的浅色底 + 主色文字。
     标签由脚本动态创建，没有 Astro 的 scoped 标记，所以这里必须用 :global */
  :global(.tab-item) {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    flex: 0 1 auto;
    /* 压缩下限：至少还能看见关闭按钮，再挤就只剩个色块了 */
    min-width: 2.6rem;
    padding: 0.3rem 0.35rem 0.3rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--btn-content) 10%, transparent);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--btn-content) 6%, transparent);
    color: var(--btn-content);
    font-size: 0.8125rem;
    line-height: 1.4;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    -webkit-touch-callout: none;
    /* 长按不要出现点击高亮 / 文本选中 / 系统菜单 */
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      opacity 0.15s ease;
  }
  :global(.tab-item),
  :global(.tab-item *) {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    /* 别让 WebKit 生成原生拖拽的灰影 */
    -webkit-user-drag: none;
  }
  :global(.tab-item:hover) {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    border-color: color-mix(in srgb, var(--primary) 22%, transparent);
  }
  :global(.tab-item[data-active]) {
    color: var(--primary);
    font-weight: 600;
    background: color-mix(in srgb, var(--primary) 16%, transparent);
    border-color: color-mix(in srgb, var(--primary) 30%, transparent);
  }
  /* 拖动中的标签会浮在其它标签上方（跟手位移由 JS 写 transform）。
     底色必须是不透明的混合色，否则会透出下面被压住的标签。 */
  :global(.tab-item.tab-dragging) {
    position: relative;
    z-index: 5;
    cursor: grabbing;
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 16%, var(--card-bg));
    border-color: color-mix(in srgb, var(--primary) 38%, transparent);
    /* 用主色而不是黑色投影，避免浅色卡片上显成一团黑影 */
    box-shadow: 0 6px 16px -6px color-mix(in srgb, var(--primary) 40%, transparent);
  }
  /* 拖动期间才提层，平时不加避免白白占用合成层 */
  :global(.tab-strip.tab-sorting .tab-item) {
    will-change: transform;
  }
  :global(.tab-link) {
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    max-width: 11rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: inherit;
    text-decoration: none;
  }
  /* 固定标签：和左侧 home 按钮同尺寸的正方形，只留 pin 图标 */
  :global(.tab-item[data-pinned]) {
    flex: 0 0 auto;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    /* 必须覆写压缩下限，否则会被 min-width: 2.6rem 撑成长方形 */
    min-width: 2.25rem;
    padding: 0;
    border-radius: 0.75rem;
    border-color: color-mix(in srgb, var(--btn-content) 12%, transparent);
  }
  :global(.tab-item[data-pinned]:hover) {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 15%, transparent);
    border-color: color-mix(in srgb, var(--primary) 25%, transparent);
  }
  :global(.tab-item[data-pinned] .tab-link),
  :global(.tab-item[data-pinned] .tab-close) {
    display: none;
  }
  :global(.tab-item[data-pinned] .tab-pin) {
    display: grid;
    font-size: 1.1rem;
    opacity: 0.85;
  }
  :global(.tab-item[data-pinned][data-active]) {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 14%, transparent);
    border-color: color-mix(in srgb, var(--primary) 28%, transparent);
  }
  :global(.tab-item[data-pinned][data-active] .tab-pin),
  :global(.tab-item[data-pinned]:hover .tab-pin) {
    opacity: 1;
  }
  /* 竖线：与 .tab-divider 完全同款（1px、撑满行高、同透明度） */
  :global(.tab-pin-divider) {
    flex: 0 0 auto;
    align-self: stretch;
    width: 1px;
    background: var(--line-divider);
    opacity: 0.5;
  }
  :global(.tab-pin) {
    /* 每个标签节点都带一个 pin，普通标签靠 display 关掉，节点结构才稳定可复用 */
    display: none;
    place-items: center;
    flex: 0 0 auto;
    font-size: 0.75rem;
    opacity: 0.7;
  }
  /* 内联 svg 没有宽高，必须显式给尺寸，否则会按默认 300×150 撑爆布局 */
  :global(.tab-pin svg),
  :global(.tab-close svg) {
    display: block;
    width: 1em;
    height: 1em;
    fill: currentColor;
  }
  :global(.tab-close) {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.15rem;
    height: 1.15rem;
    margin-left: 0.15rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    opacity: 0;
    /* 不可见时不吞点击：否则标签右侧会有一块看不见但能关掉它的热区 */
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      background-color 0.15s ease;
  }
  :global(.tab-item:hover .tab-close),
  :global(.tab-item[data-active] .tab-close) {
    opacity: 0.7;
    pointer-events: auto;
  }
  :global(.tab-close:hover) {
    opacity: 1;
    background: color-mix(in srgb, var(--btn-content) 16%, transparent);
  }

  /* 触屏没有 hover：直接常显，否则永远点不到关闭 */
  @media (hover: none) {
    :global(.tab-close) {
      opacity: 0.6;
      pointer-events: auto;
    }
  }
  :global(body.tab-dragging-cursor) {
    cursor: grabbing;
  }

  /* 右键菜单（节点运行时会挪到 body 下，用 :global 保证跨容器生效） */
  :global(#tab-menu) {
    position: fixed;
    z-index: 1300;
    min-width: 10.5rem;
    padding: 0.3rem;
    border: 1px solid color-mix(in srgb, var(--btn-content) 12%, transparent);
    border-radius: 0.75rem;
    background: var(--card-bg);
    box-shadow: 0 18px 48px -12px rgba(0, 0, 0, 0.35);
    font-size: 0.8125rem;
    color: var(--btn-content);
  }
  :global(#tab-menu[hidden]) {
    display: none;
  }
  :global(#tab-menu .tab-menu-item) {
    display: block;
    width: 100%;
    padding: 0.4rem 0.625rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: inherit;
    font-size: inherit;
    text-align: left;
    cursor: pointer;
  }
  :global(#tab-menu .tab-menu-item:hover:not(:disabled)) {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }
  :global(#tab-menu .tab-menu-item:disabled) {
    opacity: 0.35;
    cursor: default;
  }
  :global(#tab-menu .tab-menu-separator) {
    height: 1px;
    margin: 0.25rem 0.4rem;
    background: var(--line-divider);
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    :global(.tab-item) {
      font-size: 0.75rem;
      padding: 0.25rem 0.3rem 0.25rem 0.55rem;
      min-width: 2.2rem;
    }
    :global(.tab-link) {
      max-width: 7rem;
    }
    :global(.tab-item[data-pinned]) {
      width: 2rem;
      height: 2rem;
      padding: 0;
    }
    .tab-home,
    .tab-trash {
      width: 2rem;
      height: 2rem;
      border-radius: 0.6rem;
    }
  }
</style>
