---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getCategoryUrl, getTagUrl } from "@/utils/url-utils";

export interface Props {
	published: Date;
	updated?: Date;
	category?: string;
	tags?: string[];
	hideUpdateDate?: boolean;
	hideTagsForMobile?: boolean;
	className?: string;
	showPublished?: boolean;
	showCategory?: boolean;
	showTags?: boolean;
	maxTags?: number;
	showNoTags?: boolean;
	/** 覆盖发布日期显示的文案（如相对时间「3分钟前」） */
	publishedText?: string;
	/** 覆盖发布日期前的图标 */
	publishedIcon?: string;
	/** 覆盖分类前的图标 */
	categoryIcon?: string;
	/** 文章 slug；有值时渲染「阅读量」一栏，数值由 analytics/PostViewCounter.astro 回填 */
	viewsId?: string;
	/** 是否显示阅读量（自建统计回填）；评论系统不再承担访问量 */
	showViews?: boolean;
	/** 是否在渲染时上报一次浏览，只有文章详情页该为 true */
	countView?: boolean;
	password?: boolean;
	words?: number;
	minutes?: number;
	showWords?: boolean;
	showReadingTime?: boolean;
	variant?: "default" | "cover";
}

const {
	published,
	updated,
	category,
	tags,
	hideUpdateDate,
	hideTagsForMobile,
	className = "",
	showPublished = true,
	showCategory = true,
	showTags = true,
	maxTags,
	showNoTags = true,
	publishedText,
	publishedIcon = "material-symbols:calendar-today-outline-rounded",
	categoryIcon = "material-symbols:book-2-outline-rounded",
	viewsId,
	showViews = false,
	countView = false,
	words,
	minutes,
	showWords = false,
	showReadingTime = false,
	password,
	variant = "default",
} = Astro.props;

const visibleTags =
	typeof maxTags === "number" ? tags?.slice(0, maxTags) : tags;
---

<div
  class:list={[
    "post-meta-root flex flex-wrap items-center gap-4 gap-x-4 gap-y-2",
    {
      "text-neutral-500 dark:text-neutral-400": variant === "default",
      "post-meta-cover text-white/90": variant === "cover",
    },
    className,
  ]}
>
  {
    showPublished && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon name={publishedIcon} class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium">
          {publishedText ?? formatDateToYYYYMMDD(published)}
        </span>
      </div>
    )
  }

  {
    showPublished &&
      !hideUpdateDate &&
      updated &&
      updated.getTime() !== published.getTime() && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon
              name="material-symbols:edit-calendar-outline-rounded"
              class="text-xl"
            />
          </div>
          <span class="text-50 text-sm font-medium">
            {formatDateToYYYYMMDD(updated)}
          </span>
        </div>
      )
  }

  {
    showCategory && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon name={categoryIcon} class="text-xl" />
        </div>
        <div class="flex flex-row flex-nowrap items-center">
          <a
            href={getCategoryUrl(category || "")}
            aria-label={`View all posts in the ${category || i18n(I18nKey.uncategorized)} category`}
            class="link-lg transition text-50 text-sm font-medium
              hover:text-(--primary) dark:hover:text-(--primary) whitespace-nowrap"
          >
            {category || i18n(I18nKey.uncategorized)}
          </a>
        </div>
      </div>
    )
  }

  {
    showViews && viewsId && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon
            name="material-symbols:visibility-outline-rounded"
            class="text-xl"
          />
        </div>
        <span class="text-50 text-sm font-medium mr-1">
          {i18n(I18nKey.pageViews)}:
        </span>
        <span
          class="text-50 text-sm font-medium"
          data-post-views={viewsId}
          data-post-view-trigger={countView ? viewsId : undefined}
        >
          —
        </span>
      </div>
    )
  }

  {
    showTags && (
      <div
        class:list={[
          "post-meta-tags items-center",
          { flex: !hideTagsForMobile, "hidden md:flex": hideTagsForMobile },
        ]}
      >
        <div class="flex flex-row flex-wrap items-center">
          <div class="meta-icon">
            <Icon name="material-symbols:tag-rounded" class="text-xl" />
          </div>
          {visibleTags &&
            visibleTags.length > 0 &&
            visibleTags.map((tag, i) => (
              <>
                <div
                  class:list={[
                    { hidden: i === 0 },
                    "meta-divider mx-1.5 text-(--meta-divider) text-sm",
                  ]}
                >
                  /
                </div>
                <a
                  href={getTagUrl(tag)}
                  aria-label={`View all posts with the ${tag.trim()} tag`}
                  class="link-lg transition text-50 text-sm font-medium
                    hover:text-(--primary) dark:hover:text-(--primary) whitespace-nowrap"
                >
                  {tag.trim()}
                </a>
              </>
            ))}
          {showNoTags && !(visibleTags && visibleTags.length > 0) && (
            <div class="transition text-50 text-sm font-medium">
              {i18n(I18nKey.noTags)}
            </div>
          )}
        </div>
      </div>
    )
  }

  {
    showWords && typeof words === "number" && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon name="material-symbols:notes-rounded" class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium">
          {words} {i18n(words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
        </span>
      </div>
    )
  }

  {
    showReadingTime && typeof minutes === "number" && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon name="material-symbols:schedule-outline-rounded" class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium">
          {minutes} {i18n(minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
        </span>
      </div>
    )
  }

  {
    password && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon name="material-symbols:lock-outline" class="text-xl" />
        </div>
        <span class="text-50 text-sm font-medium">
          {i18n(I18nKey.postEncrypted)}
        </span>
      </div>
    )
  }
</div>

<style>
  .post-meta-tags {
    min-width: 0;
    max-width: 100%;
  }

  .post-meta-tags .meta-icon {
    flex-shrink: 0;
  }

  .post-meta-cover .text-50,
  .post-meta-cover .meta-divider {
    color: rgb(255 255 255 / 0.9) !important;
  }

  .post-meta-cover .meta-icon {
    width: 1.125rem;
    height: 1.125rem;
    margin-right: 0.375rem;
    background: transparent;
    color: rgb(255 255 255 / 0.9);
  }

  .post-meta-cover .text-sm {
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .post-meta-cover .text-xl {
    font-size: 1rem;
  }

  .post-meta-cover .post-meta-tags {
    min-width: 0;
  }

  .post-meta-cover a:hover {
    color: white !important;
  }

  .post-meta-cover a:hover::before {
    background-color: rgb(255 255 255 / 0.18) !important;
  }

  .post-meta-cover a:active::before {
    background-color: rgb(255 255 255 / 0.26) !important;
  }

  @media (max-width: 767px) {
    .post-meta-tags {
      width: 100%;
      /* 标签换行时图标与首行标签对齐，避免垂直居中漂浮导致变形 */
      align-items: flex-start;
    }
  }
</style>
