	</div>
</template>

<script>
	import {
		initChatContextPop,
		summarizeMarkdown,
		summarizeMarkdownHtml,
	} from "@/components/common/comment/chat-context-pop";
	import { initCommentInfo } from "@/components/common/comment/comment-info";
	import {
		identityKeyOf,
		readOwnComments,
		readOwnIdentities,
		rememberOwnComment,
	} from "@/components/common/comment/comment-own";
	import {
		getCommentUser,
		initialOf,
	} from "@/components/common/comment/comment-user";
	import { mountChatWallpaper } from "@/components/common/comment/comment-wallpaper";
	import {
		apiErrorMessage,
		isAbortedRequest,
		type ApiErrorLabels,
	} from "@/utils/api-error-message";
	import { ApiError } from "@/utils/api-client";
	import { copyText } from "@/utils/clipboard";
	import { createEmptyLottie, registerEmptyLottie } from "@/utils/empty-lottie";
	import {
		type ApiComment,
		type CommentPage,
		fetchComments,
		isCommentApiEnabled,
		postComment,
		slugOfPath,
	} from "@/utils/comment-client";
	import {
		emojiShortcodeExtension,
		emojiTokenOfSrc,
	} from "@/utils/emoji-shortcode";
	import { Marked } from "marked";

	const pad = (value: number) => String(value).padStart(2, "0");

	/** 本地时间 HH:mm：自己刚发的气泡和刷新后拉回来的走同一份格式 */
	const clockOf = (date: Date): string =>
		`${pad(date.getHours())}:${pad(date.getMinutes())}`;

	/** 时间戳是不是今天（本地时区）—— 决定时间要不要带日期 */
	function isToday(iso: string): boolean {
		const date = new Date(iso);
		if (Number.isNaN(date.getTime())) return false;
		const now = new Date();
		return (
			date.getFullYear() === now.getFullYear() &&
			date.getMonth() === now.getMonth() &&
			date.getDate() === now.getDate()
		);
	}

	/**
	 * 后端时间戳（RFC3339）→ 气泡右下角的时间。
	 * 跨天时补上日期：评论可能躺了几天才被审核通过，只显示 HH:mm 会让人以为刚发的。
	 */
	function formatTime(iso: string): string {
		const date = new Date(iso);
		if (Number.isNaN(date.getTime())) return "";
		const clock = clockOf(date);
		return isToday(iso)
			? clock
			: `${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${clock}`;
	}

	/**
	 * 按昵称挑一档头像色调（0–3）。
	 * 后端只回昵称、没有 tone 字段，这里用稳定哈希：同一个名字永远同一种颜色，
	 * 刷新和换设备都不会变，比按列表顺序分配更不容易让人认错人。
	 */
	function toneOf(name: string): number {
		let hash = 0;
		for (const char of name) {
			hash = (hash * 31 + (char.codePointAt(0) ?? 0)) >>> 0;
		}
		return hash % 4;
	}

	/* ---------------- Markdown ---------------- */

	/** 只建一次实例：GFM（表格 / 删除线 / 自动链接）+ 单换行也算换行 */
	const md = new Marked({ gfm: true, breaks: true });

	// 行内表情：正文里存的是短码（`:huoying/hy-1:`），渲染时才翻译成图片。
	// 做成扩展而不是先替换再解析，是为了让代码块和行内代码里的短码原样留着。
	md.use({ extensions: [emojiShortcodeExtension] });

	/** 语言标识 → 顶栏显示名；表里没有的原样显示，没写语言的用「代码」兜底 */
	const LANG_NAMES: Record<string, string> = {
		js: "JavaScript",
		javascript: "JavaScript",
		ts: "TypeScript",
		typescript: "TypeScript",
		jsx: "JSX",
		tsx: "TSX",
		py: "Python",
		python: "Python",
		sh: "Shell",
		bash: "Bash",
		zsh: "Zsh",
		shell: "Shell",
		powershell: "PowerShell",
		ps1: "PowerShell",
		json: "JSON",
		jsonc: "JSON",
		html: "HTML",
		xml: "XML",
		svg: "SVG",
		css: "CSS",
		scss: "SCSS",
		less: "Less",
		md: "Markdown",
		markdown: "Markdown",
		yml: "YAML",
		yaml: "YAML",
		toml: "TOML",
		ini: "INI",
		sql: "SQL",
		go: "Go",
		golang: "Go",
		rust: "Rust",
		rs: "Rust",
		java: "Java",
		kt: "Kotlin",
		kotlin: "Kotlin",
		swift: "Swift",
		c: "C",
		cpp: "C++",
		cs: "C#",
		csharp: "C#",
		php: "PHP",
		rb: "Ruby",
		ruby: "Ruby",
		lua: "Lua",
		diff: "Diff",
		patch: "Diff",
		dockerfile: "Dockerfile",
		makefile: "Makefile",
		vue: "Vue",
		svelte: "Svelte",
		astro: "Astro",
		graphql: "GraphQL",
		gql: "GraphQL",
		text: "",
		plaintext: "",
	};
	/** 气泡里允许出现的标签，marked 的其余输出一律处理掉 */
	const SAFE_TAGS = new Set([
		"P",
		"BR",
		"STRONG",
		"EM",
		"DEL",
		"CODE",
		"PRE",
		"A",
		"UL",
		"OL",
		"LI",
		"BLOCKQUOTE",
		"H1",
		"H2",
		"H3",
		"H4",
		"H5",
		"H6",
		"HR",
		"TABLE",
		"THEAD",
		"TBODY",
		"TR",
		"TH",
		"TD",
		"IMG",
	]);

	/** 这些标签连内容一起丢掉，不只是拆壳（否则脚本正文会当成文字留在气泡里） */
	const DROP_TAGS = new Set([
		"SCRIPT",
		"STYLE",
		"IFRAME",
		"OBJECT",
		"EMBED",
		"FORM",
		"INPUT",
		"TEXTAREA",
		"SELECT",
		"BUTTON",
		"LINK",
		"META",
		"BASE",
		"SVG",
		"MATH",
	]);

	/** IMG 上唯一放行的 class：表情包要按行内小图排版，其余 class 一律丢掉 */
	const IMG_CLASS_WHITELIST = new Set(["tg-emoji-inline"]);

	/**
	 * 用浏览器自己的解析器过一遍白名单，比正则可靠：
	 * 先把 HTML 塞进 template（不执行、不加载资源），再逐个节点判断。
	 * 不认识的标签拆壳保留文字；危险标签整段删除；属性只留必要的那几个。
	 */
	function sanitizeHtml(html: string): string {
		const template = document.createElement("template");
		template.innerHTML = html;

		const walk = (parent: Node) => {
			for (const child of Array.from(parent.childNodes)) {
				if (child.nodeType === Node.COMMENT_NODE) {
					child.remove();
					continue;
				}
				if (child.nodeType !== Node.ELEMENT_NODE) continue;

				const el = child as Element;
				const tag = el.tagName.toUpperCase();

				if (DROP_TAGS.has(tag)) {
					el.remove();
					continue;
				}

				// 先净化里面的内容，再把外壳拆掉（拆完文字直接挂在父节点上）
				walk(el);
				if (!SAFE_TAGS.has(tag)) {
					el.replaceWith(...Array.from(el.childNodes));
					continue;
				}

				for (const attr of Array.from(el.attributes)) {
					const name = attr.name.toLowerCase();
					const keep =
						(tag === "A" && (name === "href" || name === "title")) ||
						(tag === "IMG" && (name === "src" || name === "alt" || name === "title")) ||
						(tag === "IMG" && name === "class") ||
						(tag === "CODE" && name === "class") ||
						(tag === "TH" && name === "align") ||
						(tag === "TD" && name === "align");
					if (!keep) el.removeAttribute(attr.name);
				}

				if (tag === "A") {
					const href = el.getAttribute("href") ?? "";
					// 只放行 http(s) / mailto / 站内锚点，javascript: 之类直接摘掉链接
					if (!/^(?:https?:|mailto:|#|\/)/i.test(href)) {
						el.removeAttribute("href");
					}
					el.setAttribute("target", "_blank");
					el.setAttribute("rel", "noopener noreferrer nofollow");
				}

				// 图片只认 http(s) 和站内地址；地址不合法就连图带标签一起删掉，
				// 不留一个破图占位。外链图不发送 Referer，也不阻塞首屏。
				if (tag === "IMG") {
					// class 只按白名单留 token，别的一律不要（这里只认表情包那一个）
					const tokens = (el.getAttribute("class") ?? "")
						.split(/\s+/)
						.filter((token) => IMG_CLASS_WHITELIST.has(token));
					if (tokens.length > 0) el.setAttribute("class", tokens.join(" "));
					else el.removeAttribute("class");

					const src = el.getAttribute("src") ?? "";
					if (!/^(?:https?:\/\/|\/[^/])/i.test(src)) {
						el.remove();
						continue;
					}
					el.setAttribute("loading", "lazy");
					el.setAttribute("decoding", "async");
					el.setAttribute("referrerpolicy", "no-referrer");
				}
			}
		};

		walk(template.content);
		return template.innerHTML;
	}

	/** 把 Markdown 渲染成可安全插入气泡的 HTML */
	function renderMarkdown(text: string): string {
		return sanitizeHtml(md.parse(text) as string);
	}

	/** 代码块顶栏要用的三条文案，由 Astro 那边按语言渲染好传进来 */
	interface CodeLabels {
		copy: string;
		copied: string;
		code: string;
	}

	/**
	 * 给代码块补一条「语言 + 复制」的顶栏。
	 * 这一步放在消毒之后：白名单要是放行 button，注入面就跟着变大，
	 * 索性让 marked 只吐标准的 <pre><code class="language-x">，按钮由我们自己拼。
	 */
	function decorateCodeBlocks(root: HTMLElement, labels: CodeLabels): void {
		for (const pre of root.querySelectorAll("pre")) {
			const code = pre.querySelector("code");
			if (!code) continue;

			const lang = (
				code.className.match(/language-([\w+#.-]+)/)?.[1] ?? ""
			).toLowerCase();

			const block = document.createElement("div");
			block.className = "tg-code";

			const head = document.createElement("div");
			head.className = "tg-code-head";

			const name = document.createElement("span");
			name.className = "tg-code-lang";
			name.textContent = LANG_NAMES[lang] ?? (lang || labels.code);

			const copy = document.createElement("button");
			copy.type = "button";
			copy.className = "tg-code-copy";
			copy.dataset.tgCopy = "";
			copy.textContent = labels.copy;

			head.append(name, copy);
			pre.replaceWith(block);
			block.append(head, pre);
		}
	}

	/** 渲染一段 Markdown 到气泡里：解析 → 消毒 → 补代码块顶栏 */
	function setMarkdown(target: HTMLElement, text: string, labels: CodeLabels): void {
		target.innerHTML = renderMarkdown(text);
		decorateCodeBlocks(target, labels);
	}

	/**
	 * 空态占位：一张插画 + 一句文案。
	 * 插画是全站统一的那张（utils/empty-lottie），尺寸由 comment.css 的
	 * `[data-tg-state="empty"]` 控制 —— 抽屉里窄、文章页里宽，同一个素材两种大小。
	 */
	function paintEmptyPlaceholder(node: HTMLElement, text: string): void {
		const caption = document.createElement("span");
		caption.textContent = text;
		node.replaceChildren(createEmptyLottie(), caption);
	}

	function init() {
		const chat = document.querySelector<HTMLElement>("[data-tg-chat]");
		if (!chat) return;

		// 空态插画要在这个页面上可用（文章页与抽屉是两份文档，各注册一次）
		registerEmptyLottie();

		// 壁纸垫在最底层：顶栏与输入栏的毛玻璃都从它上面采样
		mountChatWallpaper(chat);

		// 接口被关掉时这一页只剩壁纸：不拉数据、不绑输入栏，也不显示「加载失败」——
		// 那会让人以为服务挂了，而实际上是站点主动关的。输入栏由 CSS 收起，
		// 没有数据源时回复 / 撤回这些动作本来也没有对象
		if (!isCommentApiEnabled()) {
			chat.dataset.tgDisabled = "true";
			const state = chat.querySelector<HTMLElement>("[data-tg-state]");
			if (state) {
				state.dataset.tgState = "empty";
				paintEmptyPlaceholder(state, chat.dataset.tgLabelDisabled || "");
			}
			return;
		}

		// 评论身份（昵称 / 邮箱 / 头像）与弹窗：放在其余初始化之前，
		// 它会决定输入栏是不是锁着，晚了会先闪一下「可以输入」的状态
		initCommentInfo(chat);

		// 这一页是预渲染的静态路由，构建期拿不到 ?path=，只能在这里按地址栏补一次
		const pathParam = new URLSearchParams(window.location.search).get("path");
		if (pathParam) chat.dataset.tgPath = pathParam;

		// 消息右键菜单（ChatContextPop）：复制 / 回复 / 撤回。
		// 必须在 toBottom 之前：初始化会先把已撤回的消息从列表里摘掉，
		// 滚动位置得按最终列表算；也要在 ?path= 落定之后，拉数据用的就是它
		const chatCtx = initChatContextPop(chat);

		const scroller = chat.querySelector<HTMLElement>("[data-tg-scroll]");
		const form = chat.querySelector<HTMLFormElement>("[data-tg-composer]");
		const composer = chat.querySelector<HTMLElement>("[data-tg-input]");
		const emojiButton = chat.querySelector<HTMLButtonElement>("[data-tg-emoji]");
		const emojiPanel = chat.querySelector<HTMLElement>("[data-tg-emoji-panel]");
		const attachButton = chat.querySelector<HTMLButtonElement>("[data-tg-attach]");
		const fileInput = chat.querySelector<HTMLInputElement>("[data-tg-file]");
		const inTemplate = document.querySelector<HTMLTemplateElement>(
			"[data-tg-in-template]",
		);
		const template = document.querySelector<HTMLTemplateElement>(
			"[data-tg-out-template]",
		);
		if (!scroller || !form || !composer || !inTemplate || !template) return;

		// 代码块顶栏与几处状态文案由服务端按当前语言渲染，避免在客户端再引一套 i18n
		const labels: CodeLabels = {
			copy: chat.dataset.tgLabelCopy || "Copy",
			copied: chat.dataset.tgLabelCopied || "Copied",
			code: chat.dataset.tgLabelCode || "Code",
		};

		const textLabels = {
			empty: chat.dataset.tgLabelEmpty || "No comments yet",
			loadFailed: chat.dataset.tgLabelLoadFailed || "Failed to load comments",
			sendFailed: chat.dataset.tgLabelSendFailed || "Failed to send",
			/**
			 * 超时 / 连接中断：请求可能已经在服务端执行成功了，只是响应没回来。
			 * 这时说「发送失败，请重试」会诱导用户再发一条 —— 与「被拒绝」必须分开说。
			 */
			sendUnconfirmed:
				chat.dataset.tgLabelSendUnconfirmed || "Result unconfirmed",
			disabled: chat.dataset.tgLabelDisabled || "Comments are closed",
			/**
			 * 接口失败的兜底文案。后端只给机器可读的 code，用户看到的话由这里决定 ——
			 * 直接把后端的 "Request validation failed" 弹出来，用户只会以为网站坏了。
			 */
			api: {
				network: chat.dataset.tgApiNetwork || "Network error, please try again",
				request: chat.dataset.tgApiRequest || "Some input was rejected",
				server: chat.dataset.tgApiServer || "Service unavailable",
				unknown: chat.dataset.tgApiUnknown || "Something went wrong",
			} satisfies ApiErrorLabels,
		};

		// 复制按钮用事件委托：消息是后插进来的，不能逐条绑
		chat.addEventListener("click", (event) => {
			const target = event.target as Element | null;
			const button = target?.closest<HTMLButtonElement>("[data-tg-copy]");
			if (!button) return;
			const code = button.closest(".tg-code")?.querySelector("code");
			if (!code) return;

			const source = (code.textContent ?? "").replace(/\s+$/, "");
			void copyText(source).then((ok) => {
				if (!ok) return;
				button.textContent = labels.copied;
				button.dataset.copied = "true";
				window.setTimeout(() => {
					button.textContent = labels.copy;
					button.dataset.copied = "false";
				}, 1600);
			});
		});

		const toBottom = () => {
			scroller.scrollTop = scroller.scrollHeight;
		};

		/* ---------------- 评论数据 ---------------- */

		const stateNode = chat.querySelector<HTMLElement>("[data-tg-state]");
		const dayNode = chat.querySelector<HTMLElement>("[data-tg-day]");
		const moreNode = chat.querySelector<HTMLElement>("[data-tg-more]");
		const moreButton = chat.querySelector<HTMLButtonElement>("[data-tg-load-more]");
		// 占位文案是 SSR 渲染的，切过一次状态后就没了 —— 先留一份
		const loadingText = stateNode?.textContent?.trim() ?? "";
		const moreText = moreButton?.textContent?.trim() ?? "";
		const ownIds = readOwnComments();
		/** 每条自己评论发表时用的身份，用来判断「现在还是不是同一个人」 */
		const ownIdentities = readOwnIdentities();
		/** 当前身份：改资料时（commentUserChange）会重新算 */
		let myIdentity = identityKeyOf(getCommentUser());
		/** 老记录里没有身份时用昵称兜底 */
		let myName = (getCommentUser()?.name ?? "").trim();
		/**
		 * 这条评论现在算不算「我的」。
		 *
		 * id 在集合里只说明这台设备发过它；还要发表时的身份和当前身份一致，
		 * 否则把资料从 A 换成 B 之后，A 的气泡会一直赖在右边。
		 * 老记录没存身份，按「就是当前身份」处理，保持原来的行为。
		 */
		const isMine = (comment: ApiComment): boolean => {
			if (!ownIds.has(comment.id)) return false;
			const posted = ownIdentities.get(comment.id);
			if (posted) return posted === myIdentity;
			// 加身份记录之前发的评论：按昵称认。至少改了昵称之后它回到左边，
			// 而不是永远赖在右边 —— 老数据没法知道当时用的是哪个邮箱。
			return (comment.author.name || "").trim() === myName;
		};
		/** 站长的头像与头饰；任一缺失就退回首字母彩圆，不硬画 */
		const ownerAvatarSrc = chat.dataset.tgOwnerAvatar || "";
		const ownerHaloSrc = chat.dataset.tgOwnerHalo || "";
		/** 有视频就用视频，没有就是静态图 */
		const ownerMotionSrc = chat.dataset.tgOwnerMotion || "";

		/**
		 * 站长令牌：只在站长自己的浏览器里存一次。
		 *
		 * 后端拿它和后台配置的值比对，对了才把这条记成站长评论；普通访客用站长邮箱
		 * 评论会被要求输入令牌，输错了就只当访客 —— 所以这不是权限，是一个口令。
		 */
		const OWNER_KEY_STORAGE = "firefly-owner-key";
		const readOwnerKey = (): string => {
			try {
				return localStorage.getItem(OWNER_KEY_STORAGE) ?? "";
			} catch {
				return "";
			}
		};
		const writeOwnerKey = (key: string): void => {
			try {
				localStorage.setItem(OWNER_KEY_STORAGE, key);
			} catch {
				// 隐私模式写不进去：这次能用，刷新后要重新输，不影响发送
			}
		};

		/** 当前线程的 slug：抽屉每换一条动态就递一个新的 path 过来 */
		// 文章页内嵌时 slug 由 SSR 直接给（文章的 slug）；抽屉里才从 path 推算
		let slug =
			chat.dataset.tgSlug || slugOfPath(chat.dataset.tgPath || "/dynamic/");
		/** 并发保护：切动态时上一个请求可能后到，只认最后一次 */
		let loadToken = 0;

		/**
		 * 已加载消息的索引（id → 评论），跨页累积。
		 * 回复的父评论可能落在上一页，只按当前这一页找会漏掉引用块。
		 */
		let byID = new Map<string, ApiComment>();
		/**
		 * 下一页的游标，null 表示已经到底。
		 *
		 * 用游标而不是 offset：翻页期间有人发评论时，offset 会整体错位，
		 * 下一页要么重复一条、要么跳过一条；游标记的是「上一页最后一条」，插多少都不影响。
		 */
		let nextCursor: string | null = null;
		/** 正在进行的请求，换线程时中止它 —— 旧响应回来也不该覆盖新线程 */
		let loadAbort: AbortController | null = null;
		/** 正在补页：防连点，也让按钮有个忙态 */
		let loadingMore = false;

		/**
		 * 换消息区的状态占位。传 null 表示有数据了，直接把占位摘掉 ——
		 * 留着会在最后一条消息下面垫一块空白。
		 */
		const setState = (
			kind: "loading" | "empty" | "failed" | null,
			text?: string,
		) => {
			if (!stateNode) return;
			if (kind === null) {
				stateNode.remove();
				return;
			}
			stateNode.dataset.tgState = kind;
			if (kind === "empty") {
				paintEmptyPlaceholder(stateNode, text ?? "");
			} else {
				stateNode.textContent = kind === "loading" ? loadingText : (text ?? "");
			}
			// 摘掉过的占位要重新挂回消息区（放在最后，永远是列表末尾那一条）
			if (!stateNode.isConnected) scroller.append(stateNode);
		};

		/** 「加载更早」的显隐：没有更早的、或者正在拉，就别让它可点 */
		const syncMore = () => {
			if (!moreNode || !moreButton) return;
			moreNode.hidden = nextCursor === null;
			moreButton.disabled = loadingMore;
			moreNode.dataset.loading = loadingMore ? "true" : "false";
		};

		const clearRows = () => {
			for (const row of Array.from(scroller.querySelectorAll(".tg-row"))) {
				row.remove();
			}
		};

		/** 聊天里「待审核 / 发送失败」那一小截灰字 */
		const setPending = (row: HTMLElement, on: boolean, text?: string) => {
			const mark = row.querySelector<HTMLElement>(".tg-pending");
			if (!mark) return;
			if (text) mark.textContent = text;
			mark.hidden = !on;
		};

		/** 克隆「自己发出去」的气泡模板，填好正文与时间 */
		const buildOutgoing = (
			source: string,
			timeText: string,
			pending = false,
		): HTMLElement | null => {
			const row = (template.content.cloneNode(true) as DocumentFragment)
				.firstElementChild as HTMLElement | null;
			if (!row) return null;
			const body = row.querySelector<HTMLElement>(".tg-text");
			if (body) {
				// 原文留一份给右键「复制」：气泡里是渲染结果，不是 Markdown
				body.dataset.tgSource = source;
				setMarkdown(body, source, labels);
			}
			const time = row.querySelector<HTMLElement>(".tg-time");
			if (time) time.textContent = timeText;
			setPending(row, pending);
			return row;
		};

		/** 渲染一条别人的评论：昵称、头像色调、正文、时间全从接口数据来 */
		const renderIncoming = (comment: ApiComment): HTMLElement | null => {
			const row = (inTemplate.content.cloneNode(true) as DocumentFragment)
				.firstElementChild as HTMLElement | null;
			if (!row) return null;

			const name = comment.author.name || "?";
			const tone = toneOf(name);
			const avatar = row.querySelector<HTMLElement>(".tg-avatar");
			if (avatar) {
				if (comment.author.isOwner && ownerAvatarSrc) {
					// 头饰先入 DOM、头像后入：靠层叠顺序，只露出头顶那圈光环
					avatar.className = "tg-avatar tg-avatar--owner";
					avatar.textContent = "";
					if (ownerHaloSrc) {
						const halo = document.createElement("img");
						halo.className = "tg-owner-halo";
						halo.src = ownerHaloSrc;
						halo.alt = "";
						halo.setAttribute("aria-hidden", "true");
						avatar.append(halo);
					}
					if (ownerMotionSrc) {
						// 静音是自动播放的前提；loop + playsinline 让它像表情一样常驻，
						// poster 兜住「视频首帧还没解出来」的那一瞬间
						const video = document.createElement("video");
						video.className = "tg-owner-face";
						video.src = ownerMotionSrc;
						video.poster = ownerAvatarSrc;
						video.muted = true;
						video.loop = true;
						video.autoplay = true;
						video.playsInline = true;
						video.setAttribute("playsinline", "");
						video.setAttribute("muted", "");
						video.setAttribute("aria-hidden", "true");
						avatar.append(video);
					} else {
						const face = document.createElement("img");
						face.className = "tg-owner-face";
						face.src = ownerAvatarSrc;
						face.alt = name;
						avatar.append(face);
					}
				} else {
					avatar.className = `tg-avatar tg-avatar--${tone}`;
					avatar.textContent = initialOf(name);
				}
			}
			const author = row.querySelector<HTMLElement>(".tg-author");
			if (author) {
				author.className = `tg-author tg-author--${tone}`;
				author.textContent = name;
			}
			const time = row.querySelector<HTMLElement>(".tg-time");
			if (time) time.textContent = formatTime(comment.createdAt);

			const body = row.querySelector<HTMLElement>(".tg-text");
			if (body) {
				body.dataset.tgSource = comment.body;
				setMarkdown(body, comment.body, labels);
			}

			row.dataset.tgMsg = comment.id;
			row.dataset.tgAuthor = name;
			// 引用块的颜色跟着作者走，和头像同一档色调
			row.dataset.tgTone = String(tone);
			// 父评论先记在行上：它可能还在后一页没拉回来，等索引补全了再画引用块
			row.dataset.tgParent = comment.parentId ?? "";
			chatCtx.registerRow(row);
			return row;
		};

		/** 渲染一条自己发过的评论（审核通过后从接口拿回来的那条） */
		const renderOutgoing = (comment: ApiComment): HTMLElement | null => {
			const row = buildOutgoing(
				comment.body,
				formatTime(comment.createdAt),
				false,
			);
			if (!row) return null;
			row.dataset.tgMsg = comment.id;
			row.dataset.tgParent = comment.parentId ?? "";
			chatCtx.registerRow(row);
			return row;
		};

		/**
		 * 把渲染好的行放进消息区。
		 *
		 * 补历史时整批插在第一条消息之前：用一个 fragment 一次性插入，
		 * 逐条 insertBefore 会把顺序反过来。「加载更早」按钮和「今天」分隔线
		 * 都排在消息前面，插在第一条消息之前自然就落在它们之后。
		 */
		const placeRows = (rows: HTMLElement[], prepend: boolean) => {
			if (rows.length === 0) return;
			if (!prepend) {
				for (const row of rows) scroller.append(row);
				return;
			}
			const fragment = document.createDocumentFragment();
			for (const row of rows) fragment.append(row);
			scroller.insertBefore(fragment, scroller.querySelector(".tg-row"));
		};

		/**
		 * 按索引给所有还没画引用块的行补上。
		 *
		 * 一页里找得到父评论的先画；找不到的先空着，等「加载更早」把那一页
		 * 拉回来再统一补一遍 —— 否则用户得刷新才能看到回复关系。
		 * decorate 自己会跳过已经有引用块的行，重复调用是安全的。
		 */
		const decorateReplies = () => {
			for (const row of Array.from(
				scroller.querySelectorAll<HTMLElement>(".tg-row"),
			)) {
				const parentId = row.dataset.tgParent;
				if (!parentId) continue;
				const parent = byID.get(parentId);
				if (!parent) continue;
				chatCtx.decorate(row, {
					id: parent.id,
					name: parent.author.name || "?",
					text: summarizeMarkdown(parent.body),
					html: summarizeMarkdownHtml(parent.body),
				});
			}
		};

		/**
		 * 把一页评论并进列表。
		 *
		 * 后端按时间倒序给，这里翻过来让最旧的在上 —— 聊天读法。
		 * 认得出是自己的（id 在 ownIds 里）放右侧，其余放左侧：接口不回传邮箱，
		 * 没有别的办法区分「我」和「别人」。
		 */
		const mergePage = (page: CommentPage, prepend: boolean) => {
			for (const comment of page.items) byID.set(comment.id, comment);
			nextCursor = page.nextCursor;

			const rows: HTMLElement[] = [];
			for (const comment of page.items.slice().reverse()) {
				const row = isMine(comment)
					? renderOutgoing(comment)
					: renderIncoming(comment);
				if (row) rows.push(row);
			}
			placeRows(rows, prepend);

			decorateReplies();
			chatCtx.relayout();
			syncMore();

			// 「今天」分隔线只在确实全是今天的时候才成立，跨天的评论会露馅。
			// 补了更早的页之后结论可能反转，所以每次合并都按全量重算
			if (dayNode) {
				dayNode.hidden = Array.from(byID.values()).some(
					(comment) => !isToday(comment.createdAt),
				);
			}
		};

		/** 拉当前线程最新的一页并重建列表 */
		const loadComments = async () => {
			const token = ++loadToken;
			// 换线程时把上一个请求掐掉：它的响应即使回来也已经没有意义，
			// 让它继续跑只是白占带宽和服务端资源
			loadAbort?.abort();
			loadAbort = new AbortController();
			clearRows();
			byID = new Map();
			nextCursor = null;
			loadingMore = false;
			syncMore();
			if (dayNode) dayNode.hidden = true;
			setState("loading");

			try {
				const page = await fetchComments(slug, null, loadAbort.signal);
				if (token !== loadToken) return;

				if (page.items.length === 0) {
					setState("empty", textLabels.empty);
					return;
				}
				setState(null);
				mergePage(page, false);
				requestAnimationFrame(toBottom);
			} catch (error) {
				if (token !== loadToken) return;
				// 自己取消的不算失败：下一个线程正在加载，这里报错只会闪一下
				if (isAbortedRequest(error)) return;
				setState("failed", apiErrorMessage(error, textLabels.api));
			}
		};

		/**
		 * 往前补一页更早的评论。
		 *
		 * 新内容插在视口上方，得把滚动位置往上垫回相同的高度，否则整屏会
		 * 突然跳到最后一条已经读过的消息上。失败只让按钮闪一下提示，
		 * 不把整个线程打成「加载失败」—— 已经读到的消息仍然有效。
		 */
		const loadMore = async () => {
			if (nextCursor === null || loadingMore) return;
			const token = loadToken;
			loadingMore = true;
			syncMore();

			const prevHeight = scroller.scrollHeight;
			const prevTop = scroller.scrollTop;

			try {
				const page = await fetchComments(slug, nextCursor, loadAbort?.signal);
				if (token !== loadToken) return;
				mergePage(page, true);
				scroller.scrollTop = prevTop + (scroller.scrollHeight - prevHeight);
			} catch (error) {
				if (token !== loadToken) return;
				if (isAbortedRequest(error)) return;
				if (moreButton) {
					moreButton.textContent = apiErrorMessage(error, textLabels.api);
					window.setTimeout(() => {
						moreButton.textContent = moreText;
					}, 2000);
				}
			} finally {
				// 换线程之后这个 token 已经作废：新线程的 loadingMore 由 loadComments 重置
				if (token === loadToken) {
					loadingMore = false;
					syncMore();
				}
			}
		};

		moreButton?.addEventListener("click", () => void loadMore());

		// 滚到顶就自动补一页：和 Telegram 一样，不用每次去够那个按钮。
		// 只在完全贴顶时触发，否则翻页后补偿出的那点偏移会立刻再触发一次
		scroller.addEventListener(
			"scroll",
			() => {
				if (scroller.scrollTop > 24) return;
				void loadMore();
			},
			{ passive: true },
		);

		// 空输入时纸飞机是灰的、有内容才点亮成蓝色。
		// 「有内容」= 有文字或至少有一张贴纸（贴纸是 <img>，textContent 里看不到）
		const composerHasContent = (): boolean => {
			if (composer.querySelector("img")) return true;
			return (composer.textContent ?? "").replace(/\u00a0/g, " ").trim() !== "";
		};

		const syncSend = () => {
			const has = composerHasContent();
			chat.dataset.hasText = has ? "true" : "false";
			// 占位文案靠这条属性显示（:empty 在只剩一个 <br> 时会失效，不可靠）
			composer.dataset.empty = has ? "false" : "true";
		};

		// 输入框随内容长高（上限交给 CSS 的 max-height，超出后内部滚动）
		const resizeInput = () => {
			composer.style.height = "auto";
			composer.style.height = `${composer.scrollHeight}px`;
		};

		/**
		 * 在当前光标处插入一个节点：文字（表情）、换行（Shift+Enter）、贴纸 <img> 都走这里。
		 * 没有选区或选区在别的元素里时退化成「追加到末尾」，不会把内容插到奇怪的地方。
		 */
		const insertAtCaret = (node: Node) => {
			composer.focus({ preventScroll: true });
			const selection = window.getSelection();
			const range =
				selection && selection.rangeCount > 0 ? selection.getRangeAt(0) : null;

			if (range && composer.contains(range.commonAncestorContainer)) {
				range.deleteContents();
				range.insertNode(node);
			} else {
				composer.append(node);
			}

			// 光标落到新节点之后，接着敲字就接在后面
			const after = document.createRange();
			after.setStartAfter(node);
			after.collapse(true);
			selection?.removeAllRanges();
			selection?.addRange(after);

			syncSend();
			resizeInput();
		};

		/**
		 * 把编辑器内容读回 Markdown 源：文字原样、`<br>` 转换行、表情转成短码。
		 *
		 * 发出去的是**源**，不是渲染结果：表情写成 `:huoying/hy-1:`，由渲染端翻译回
		 * 图片。正文里一旦出现 `<img src=…>`，那条评论就把当时的资源地址焊死了，
		 * 换目录、换 CDN 都会变成破图，而且字数上限会按标签长度扣
		 * （一个标签 77 字符，一个短码 15）。详见 utils/emoji-shortcode.ts。
		 */
		const readComposer = (): string => {
			let out = "";
			const walk = (node: Node) => {
				for (const child of Array.from(node.childNodes)) {
					if (child.nodeType === Node.TEXT_NODE) {
						out += (child.textContent ?? "").replace(/\u00a0/g, " ");
						continue;
					}
					if (child.nodeName === "BR") {
						out += "\n";
						continue;
					}
					if (child instanceof HTMLImageElement) {
						// 插入时就记了短码；没有的话按地址反查一次（老节点、外部脚本插的图）
						const token =
							child.dataset.tgEmojiToken ??
							emojiTokenOfSrc(
								child.dataset.tgEmojiSrc ?? child.getAttribute("src") ?? "",
							);
						// 认不出来的图片不进正文：输入框里只该有表情图，
						// 一张来路不明的图没有对应的文字表达，写进去就是坏数据
						if (token) out += token;
						continue;
					}
					walk(child);
				}
			};
			walk(composer);
			return out;
		};

		composer.addEventListener("input", () => {
			syncSend();
			resizeInput();
		});

		// 粘贴只收纯文本：contenteditable 默认会把剪贴板里的整段 HTML 塞进来，
		// 样式、链接全跟着进来，气泡里的白名单也挡不住这种「先污染再消毒」
		composer.addEventListener("paste", (event) => {
			const text = event.clipboardData?.getData("text/plain");
			if (text == null) return;
			event.preventDefault();
			insertAtCaret(document.createTextNode(text));
		});

		// Enter 发送、Shift+Enter 换行 —— 浏览器的默认行为是插 <div>/<br>，两种都可能，
		// 干脆自己插一个 <br>，读回文本时只需要认这一种
		composer.addEventListener("keydown", (event) => {
			if (event.key !== "Enter" || event.isComposing) return;
			event.preventDefault();
			if (event.shiftKey) {
				insertAtCaret(document.createElement("br"));
				return;
			}
			form.requestSubmit();
		});

		syncSend();
		resizeInput();

		/* ---------------- 表情面板 ---------------- */

		const setEmojiOpen = (open: boolean) => {
			if (!emojiPanel || !emojiButton) return;
			emojiPanel.hidden = !open;
			emojiButton.setAttribute("aria-expanded", open ? "true" : "false");
			chat.dataset.emojiOpen = open ? "true" : "false";
			if (open) toBottom();
		};

		const closeEmoji = () => setEmojiOpen(false);

		// 开始回复时收起表情面板：两者都贴在输入框上，同屏会互相挤
		chat.addEventListener("tg-reply-start", () => closeEmoji());

		emojiButton?.addEventListener("click", () => {
			setEmojiOpen(Boolean(emojiPanel?.hidden));
		});

		// 系列 tab：点哪个就露出哪个表情包系列，其余收起
		// （只有一个系列时组件不渲染 tab 栏，这里的循环自然空转）
		const emojiBody = chat.querySelector<HTMLElement>("[data-tg-emoji-body]");
		const emojiTabs = Array.from(
			chat.querySelectorAll<HTMLElement>("[data-tg-emoji-tab]"),
		);
		const emojiGrids = Array.from(
			chat.querySelectorAll<HTMLElement>("[data-tg-emoji-cat]"),
		);

		const selectCategory = (id: string) => {
			for (const tab of emojiTabs) {
				tab.setAttribute(
					"aria-selected",
					tab.dataset.tgEmojiTab === id ? "true" : "false",
				);
			}
			for (const grid of emojiGrids) {
				grid.hidden = grid.dataset.tgEmojiCat !== id;
			}
			// 换分类时回到该类的顶部，否则会停在上一类的滚动位置
			if (emojiBody) emojiBody.scrollTop = 0;
		};

		for (const tab of emojiTabs) {
			tab.addEventListener("click", () => {
				const id = tab.dataset.tgEmojiTab;
				if (id) selectCategory(id);
			});
		}

		// 点表情包是「插进输入框」，不是直接发出去：
		// 这样它就能和文字排在同一行（图片、文字可以混着写，再一起发出去）
		// 注意选择器是 [data-tg-emoji-src]：输入栏那个开面板的按钮用的是光秃秃的
		// [data-tg-emoji]，两个属性撞名会把「开面板」的点击绑到第一张表情上
		chat.querySelectorAll<HTMLElement>("[data-tg-emoji-src]").forEach((item) => {
			item.addEventListener("mousedown", (event) => event.preventDefault());
			item.addEventListener("click", () => {
				const src = item.dataset.tgEmojiSrc;
				if (!src) return;
				// 短码是写进正文的东西，解析不出来就不插：插进去的图读不回短码，
				// 发出去会变成一条内容缺失的评论
				const token = emojiTokenOfSrc(src);
				if (!token) return;
				const img = document.createElement("img");
				img.className = "tg-emoji-inline";
				img.src = src;
				img.alt = item.dataset.tgEmojiName ?? "";
				// 读回内容时用这两个：src 会被浏览器补成绝对路径，短码不会
				img.dataset.tgEmojiSrc = src;
				img.dataset.tgEmojiToken = token;
				insertAtCaret(img);
			});
		});

		document.addEventListener("pointerdown", (event) => {
			if (!emojiPanel || emojiPanel.hidden) return;
			const target = event.target as Node | null;
			if (!target) return;
			if (
				emojiPanel.contains(target) ||
				emojiButton?.contains(target) ||
				attachButton?.contains(target)
			) {
				return;
			}
			closeEmoji();
		});

		// Esc：面板开着就先收面板，已经收起了就把「关抽屉」交给父窗口
		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return;
			if (emojiPanel && !emojiPanel.hidden) {
				closeEmoji();
				return;
			}
			requestClose();
		});

		// ---------------- 发送图片 ----------------

		const appendPhoto = (file: File) => {
			const row = (template.content.cloneNode(true) as DocumentFragment)
				.firstElementChild as HTMLElement | null;
			if (!row) return;
			const text = row.querySelector<HTMLElement>(".tg-text");
			const bubble = row.querySelector<HTMLElement>(".tg-bubble");
			const time = row.querySelector<HTMLElement>(".tg-time");
			if (text && bubble) {
				const photo = document.createElement("img");
				photo.className = "tg-photo";
				photo.alt = file.name;
				photo.src = URL.createObjectURL(file);
				// 图加载完就能释放 blob，不必等页面关掉
				photo.addEventListener(
					"load",
					() => URL.revokeObjectURL(photo.src),
					{ once: true },
				);
				text.replaceWith(photo);
				bubble.classList.add("tg-bubble--photo");
			}
			if (time) time.textContent = clockOf(new Date());

			chatCtx.registerRow(row);
			scroller.append(row);
			chatCtx.relayout();
			requestAnimationFrame(toBottom);
		};

		// 后端还没有图片上传接口，而 blob: 地址过不了正文的 URL 白名单 ——
		// 放出来只会得到「本地看着发出去了、刷新就没了」的假象。等上传接口上线再放开
		if (attachButton) attachButton.style.display = "none";

		attachButton?.addEventListener("click", () => fileInput?.click());
		fileInput?.addEventListener("change", () => {
			const file = fileInput.files?.[0];
			if (!file) return;
			appendPhoto(file);
			// 清空才能连续选同一张图
			fileInput.value = "";
		});

		// ---------------- 发送消息 ----------------

		/** 发送失败的提示文案：区分「确定失败」与「结果未知」 */
		const sendFailureText = (error: unknown): string => {
			if (isAbortedRequest(error)) return textLabels.sendFailed;
			if (
				error instanceof ApiError &&
				(error.kind === "network" || error.kind === "timeout")
			) {
				return textLabels.sendUnconfirmed;
			}
			return apiErrorMessage(error, textLabels.api);
		};

		/**
		 * 把刚追加的气泡换成后端那一条：换 id、记进 ownIds、按返回的状态决定
		 * 「待审核」怎么显示。失败时不撤回气泡 —— 内容在里面，用户还能右键复制重发。
		 */
		/**
		 * 提交评论；如果后端说「这个邮箱是站长，要令牌」，就问一次再重发。
		 *
		 * 只在收到那个字段级错误时才问，所以普通访客永远看不到这个弹窗 ——
		 * 也就不会知道哪个地址是站长的。
		 */
		const postCommentWithOwnerKey = async (
			author: { name: string; email: string },
			body: string,
			parentId?: string,
		): Promise<ApiComment> => {
			const attempt = (ownerKey: string) =>
				postComment(slug, { author, body, parentId, ownerKey });

			try {
				return await attempt(readOwnerKey());
			} catch (error) {
				const needsKey =
					error instanceof ApiError &&
					error.fieldErrors.some((field) => field.field === "ownerKey");
				if (!needsKey) throw error;

				// 站长专用路径，不做事后翻译：看到这个框的人只有站长自己
				const entered = window.prompt("请输入站长令牌（站长邮箱专用）", "");
				const key = (entered ?? "").trim();
				if (!key) throw error;
				writeOwnerKey(key);
				return attempt(key);
			}
		};

		const submitComment = async (
			row: HTMLElement,
			body: string,
			author: { name: string; email: string },
			parentId?: string,
		) => {
			form.dataset.sending = "true";
			try {
				const created = await postCommentWithOwnerKey(author, body, parentId);
				// 换成后端 id：引用跳转、撤回记录都按它来，刷新后才对得上
				row.dataset.tgMsg = created.id;
				row.dataset.tgParent = created.parentId ?? "";
				// 撤回凭据只有这一次能拿到：连同 id 一起存下来，下次打开还能删
				rememberOwnComment(created.id, created.deleteToken, myIdentity);
				ownIds.add(created.id);
				ownIdentities.set(created.id, myIdentity);
				setPending(row, created.status === "pending");
			} catch (error) {
				row.classList.add("is-failed");
				// 三种失败要分开说：被拒绝（改内容再试）、超时（结果未知，先别重发）、
				// 自己取消（等于没发生）。混成一句「发送失败」会让用户在不该重发时重发
				setPending(row, true, sendFailureText(error));
			} finally {
				form.dataset.sending = "false";
			}
		};

		/**
		 * 换了身份就重画两侧。
		 *
		 * 身份决定的是「哪些气泡算我的」：把资料从 A 换成 B 之后，A 发的要挪到
		 * 左边、B 发的挪到右边。不刷新页面 —— 记录还在，只是左右重新排一次。
		 */
		window.addEventListener("commentUserChange", (event) => {
			const detail = (event as CustomEvent<{ email: string; name: string }>)
				.detail;
			const next = identityKeyOf(detail ?? null);
			if (next === myIdentity) return;
			myIdentity = next;
			myName = (detail?.name ?? "").trim();

			for (const row of Array.from(
				scroller.querySelectorAll<HTMLElement>(".tg-row[data-tg-msg]"),
			)) {
				const id = row.dataset.tgMsg;
				const comment = id ? byID.get(id) : undefined;
				if (!id || !comment) continue;
				const wantOut = isMine(comment);
				if ((row.dataset.tgSide === "out") === wantOut) continue;
				const replacement = wantOut
					? renderOutgoing(comment)
					: renderIncoming(comment);
				if (replacement) row.replaceWith(replacement);
			}

			decorateReplies();
			chatCtx.relayout();
		});

		form.addEventListener("submit", (event) => {
			event.preventDefault();
			if (form.dataset.sending === "true") return;
			// 输入框是富文本：贴纸是 <img>，textContent 里什么都读不到，
			// 必须走 readComposer 把「文字 + 换行 + 贴纸」按顺序拼回 Markdown
			const source = readComposer();
			if (!source.trim()) return;

			// 身份没填全时输入栏本来就是锁着的，这里只是兜底（比如身份被清掉）
			const user = getCommentUser();
			const name = user?.name.trim() || chat.dataset.tgDefaultName || "";
			const email = user?.email.trim() || "";
			if (!name) return;

			// 取走待发送的引用：引用块要嵌在气泡顶部、正文之上。
			// 引用的 target 就是原消息的 data-tg-msg，自己发过的那些已经是后端 id，
			// 提交时直接当 parentId 用
			const quote = chatCtx.takePendingReply();
			const row = buildOutgoing(source, clockOf(new Date()), true);
			if (!row) return;
			if (quote) chatCtx.decorate(row, quote);

			chatCtx.registerRow(row);
			scroller.append(row);
			chatCtx.relayout();
			composer.innerHTML = "";
			syncSend();
			resizeInput();
			closeEmoji();
			// 等浏览器完成一次布局再滚，否则新气泡高度还算不出来
			requestAnimationFrame(toBottom);
			composer.focus({ preventScroll: true });

			void submitComment(row, source, { name, email }, quote?.id);
		});

		/* ---------------- 抽屉切换动态 ---------------- */

		// 抽屉里换一条动态时父窗口只递 path 过来、不重载文档（重载等于白屏），
		// 线程就靠这里换。同一个 path 会重复到达（打开、尺寸变化都会发），要忽略
		window.addEventListener("message", (event) => {
			if (event.origin !== window.location.origin) return;
			const data = event.data as { type?: string; path?: string } | null;
			if (data?.type !== "dynamic-comment-path") return;
			chat.dataset.tgPath = String(data.path || "");
			const next = slugOfPath(chat.dataset.tgPath || "/dynamic/");
			if (next === slug) return;
			slug = next;
			void loadComments();
		});

		void loadComments();
	}

	/* ---------------- 与评论抽屉（父窗口）的桥 ---------------- */

	/**
	 * 抽屉的收起只能由父窗口做（几何、焦点、触发按钮都在那边），
	 * 这里只把「想关」传出去。独立访问这个页面时没有父窗口，什么也不做。
	 */
	function requestClose(): void {
		if (window.parent === window) return;
		window.parent.postMessage(
			{ type: "dynamic-comment-close" },
			window.location.origin,
		);
	}

	// 关闭按钮只在抽屉里渲染（embedded），独立访问时这个查询是空的
	document
		.querySelector<HTMLElement>("[data-tg-close]")
		?.addEventListener("click", requestClose);

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init, { once: true });
	} else {
		init();
	}
</script>
