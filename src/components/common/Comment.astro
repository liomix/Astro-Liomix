---
/**
 * 评论组件（原子组件）：一条评论线程的完整界面 —— 顶栏、消息区、输入栏、表情面板。
 * ---------------------------------------------------------------------------
 * 两个地方用它，靠 props 区分形态，行为是同一份：
 *   1. 动态页的动态评论（/dynamic/comments/，装在 iframe 抽屉里，closable 默认 true）；
 *   2. 文章页的文章评论（PostComments 内嵌在正文下方，closable=false，直接给 slug）。
 * 线程就是 slug：动态页从 path 推算（dynamic-<id>），文章页由调用方直接传文章 slug。
 * 样式由组件自己带（styles/components/comment.css + comment-info.css），
 * 内部逻辑在 components/common/comment/ 下，外面不需要再引任何东西。
 *
 * 按 Telegram Android 客户端的私聊页复刻：
 *   气泡 17px 圆角 + 靠发送者一侧的 6px 小角（源码 SharedConfig.bubbleRadius = 17，
 *   近侧角 Math.min(6, bubbleRadius)）；对方白/深灰气泡靠左、自己浅绿/蓝气泡靠右；
 *   时间贴在气泡右下角（不放已读回执的双勾）；底部是输入栏，右侧纸飞机
 *   （空输入时灰、有文字才点亮成蓝色）。表情面板放的是自定义表情包：
 *   数据来自 config/commentEmojiConfig.ts 登记的 JSON（一份 JSON = 一个 tab），
 *   点一下插进输入框，和文字一起发出去。
 *
 * 群聊式头像：对方消息左侧跟一个首字母彩圆（Telegram 没有用户头像时的默认画法），
 * 连发多条只在最后一条下方露头像、只在第一条上方显示昵称 —— 和 Telegram 分组规则一致。
 *
 * 所有消息（拉回来的评论和自己发出去的）都按 GitHub Flavored Markdown 解析
 * （粗体、斜体、删除线、行内代码 / 代码块、列表、引用、链接、表格、换行），
 * 解析结果先过一遍标签白名单再塞进气泡，避免脚本注入。
 * 代码块会补一条「语言 + 复制」的顶栏：marked 只吐标准的 <pre><code class="language-x">，
 * 顶栏和复制按钮在消毒之后由 DOM 拼（见 decorateCodeBlocks），白名单不用为 button 开口子。
 * 输入框是会自动长高的 textarea：Enter 发送、Shift+Enter 换行，方便写多行 Markdown。
 *
 * 消息来自自建后端（`/api/v1/posts/{slug}/comments`）：打开时按当前动态的 slug
 * 拉一遍已审核评论，发送时 POST 一条并把气泡追加到本地。新评论默认 pending，
 * 因此本地气泡上带「待审核」；刷新后它不会立刻回来，审核通过才会出现在列表里。
 * slug 由 `slugOfPath()` 从 `data-tg-path` 算出（`/dynamic/<id>/` → `dynamic-<id>`），
 * 所以每条动态是一个独立的评论线程，抽屉切换动态时会重新拉取。
 * 回复关系也在这一层还原：带 parentId 的那条会按父评论画出引用块（点它跳回原
 * 消息），父评论不在已加载的消息里时不画 —— 编一个指向空处的引用比没有更糟。
 *
 * 列表是分页的：一次只拉 `commentApiConfig.pageSize` 条（最新的那些），顶上留一个
 * 「加载更早」，滚到顶也会自动接着拉。聊天读法是最新的在下面，所以补历史要往
 * 前插并保持视口不动，否则每点一次整屏都会跳。
 *
 * 自己发出去的评论可以撤回：创建响应里的 deleteToken 只够删这一条，存在
 * localStorage 里（见 comment-own.ts），右键菜单的「撤回」拿它去调后端。
 * `commentApiConfig.enable` 关掉时这一页不动任何网络请求，输入栏收起、只显示空态。
 *
 * 图片附件按钮暂不开放：后端还没有上传接口，blob: 地址过不了正文的 URL 白名单，
 * 放出来只会得到「本地看着发出去了、刷新就没了」的假象。
 */
import { avatarGradientOf, initialOf } from "@/components/common/comment/comment-user";
import { commentEmojiConfig } from "@/config/commentEmojiConfig";
import { profileConfig } from "@/config/profileConfig";
import {
	avatarMotionOverride,
	isVideoAvatar,
	resolveRawAvatarUrl,
} from "@/utils/avatar-utils";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
// 组件自带样式：气泡/顶栏/输入栏在 comment.css，评论身份弹窗在 comment-info.css。
// 后者要覆盖前者里的 .tg-head-avatar、给 .tg-composer 补 position，顺序不能反。
import "@/styles/components/comment.css";
import "@/styles/components/comment-info.css";

interface Props {
	/** 消息数据来源，挂到 data 属性上并据此算出评论线程的 slug */
	path?: string;
	/** 默认昵称：访客还没设置过身份时，顶栏与弹窗先填这个值 */
	name?: string;
	/** 默认邮箱：同上，来自站点配置里的 Email 链接 */
	contact?: string;
	/** 关闭按钮的无障碍文案 */
	closeLabel?: string;
	/**
	 * 直接指定评论线程的 slug，跳过「从 path 推算」那一步。
	 * 文章页内嵌时用文章的 slug：那里没有 /dynamic/<id>/ 这种地址可算。
	 */
	slug?: string;
	/**
	 * 是否显示顶栏的关闭按钮，默认显示（抽屉里需要）。
	 * 内嵌在文章页时没有「关闭」这个动作，设成 false。
	 */
	closable?: boolean;
}

const {
	path = "/dynamic/",
	name = "",
	contact = "",
	closeLabel = "Close",
	slug = "",
	closable = true,
} = Astro.props;

/** 没有头像图时用首字母彩圆，和 Telegram 无头像账号的画法一致（与弹窗共用 initialOf） */
const initial = initialOf(name);

/**
 * 首屏就先按默认邮箱把渐变色算好：脚本要等模块加载完才跑，
 * 这一帧里头像得已经是「这个身份的颜色」，不能先蓝一下再变。
 * 访客保存过自己的邮箱时，脚本会把它换成自己的那对色。
 */
const avatarPaint = avatarGradientOf(contact || name);

/**
 * 站长的气泡用博客头像，并在头像下面垫一层光环头饰。
 *
 * 「下面」是字面意思：头饰先渲染、头像盖在上面，所以只露出头顶那圈光环和翅膀，
 * 脸不会被糊住。两张图都走 ?url 直出原始文件，不经过图片优化。
 */
const ownerAvatarUrl = resolveRawAvatarUrl(
	profileConfig.avatarPoster || profileConfig.avatar || "",
);
const ownerHaloUrl = resolveRawAvatarUrl("assets/images/owner-halo.png");

/**
 * 站长的头像支持动图/视频：视频走 <video>（静音、循环、自动播放、playsinline，
 * 否则手机浏览器不自动播），动图走 <img> 本身就动。
 * avatarMotion: "never" 时仍然只给静帧，和站点头像的开关保持一致。
 */
const ownerMotionUrl =
	avatarMotionOverride() !== false && isVideoAvatar(profileConfig.avatar ?? "")
		? resolveRawAvatarUrl(profileConfig.avatar ?? "")
		: "";

/** 表情包：面板里一栏一个系列，只有一个系列时不渲染 tab 栏（见下方 markup） */
const packs = commentEmojiConfig.packs;
const showTabs = packs.length > 1;

---

<div
	class="tg-chat"
	data-tg-chat
	data-tg-path={path}
	data-tg-slug={slug}
	style={`--avatar-from:${avatarPaint.from};--avatar-to:${avatarPaint.to};--tg-emoji-size:${commentEmojiConfig.size}px`}
	data-tg-label-copy={i18n(I18nKey.commentChatCopy)}
	data-tg-label-copied={i18n(I18nKey.commentChatCopied)}
	data-tg-label-code={i18n(I18nKey.commentChatCode)}
	data-tg-label-retracted={i18n(I18nKey.commentChatRetracted)}
	data-tg-label-retract-failed={i18n(I18nKey.commentChatRetractFailed)}
	data-tg-label-retract-replies={i18n(I18nKey.commentChatRetractReplies)}
	data-tg-label-load-more={i18n(I18nKey.commentChatLoadMore)}
	data-tg-label-disabled={i18n(I18nKey.commentChatDisabled)}
	data-tg-label-me={i18n(I18nKey.commentChatMe)}
	data-tg-label-empty={i18n(I18nKey.commentChatEmpty)}
	data-tg-label-load-failed={i18n(I18nKey.commentChatLoadFailed)}
	data-tg-label-send-failed={i18n(I18nKey.commentChatSendFailed)}
	data-tg-owner-avatar={ownerAvatarUrl}
	data-tg-owner-halo={ownerHaloUrl}
	data-tg-owner-motion={ownerMotionUrl}
	data-tg-label-send-unconfirmed={i18n(I18nKey.commentChatSendUnconfirmed)}
	data-tg-api-network={i18n(I18nKey.apiErrorNetwork)}
	data-tg-api-request={i18n(I18nKey.apiErrorRequest)}
	data-tg-api-server={i18n(I18nKey.apiErrorServer)}
	data-tg-api-unknown={i18n(I18nKey.apiErrorUnknown)}
	data-tg-default-name={name}
	data-tg-default-email={contact}
	data-tg-ci-sub-empty={i18n(I18nKey.commentInfoSubEmpty)}
	data-tg-ci-name-required={i18n(I18nKey.commentInfoNameRequired)}
	data-tg-ci-email-invalid={i18n(I18nKey.commentInfoEmailInvalid)}
	data-identity-ready="false"
>
	{/* 壁纸画在聊天页自己身上：顶栏、消息区、输入栏同处一个文档，
	    顶栏与输入栏的 backdrop-filter 直接采样它 —— 不需要任何跨文档技巧 */}
	<div class="tg-wallpaper" data-tg-wallpaper aria-hidden="true"></div>

	<header class="tg-head">
		{/* 顶栏整块就是「我的评论身份」入口：点开是 CommentInfoPop。
		    头像/昵称/邮箱由脚本按 localStorage 里存的身份覆盖这里的初始值，
		    初始值取站点配置（昵称 + Email 链接），这样没设置过的访客也不是一片空白 */}
		<button
			type="button"
			class="tg-head-id"
			data-ci-open
			aria-haspopup="dialog"
			aria-label={i18n(I18nKey.commentInfoOpen)}
		>
			<span
				class="tg-head-avatar"
				data-ci-head-avatar
				data-has-image="false"
				aria-hidden="true"
			>
				<img data-avatar-img alt="" decoding="async" hidden />
				<span data-avatar-initial>{initial}</span>
			</span>
			<span class="tg-head-text">
				<span class="tg-head-title" data-ci-head-name>{name}</span>
				<span class="tg-head-sub" data-ci-head-sub>{contact}</span>
			</span>
			<span class="tg-head-edit" aria-hidden="true">
				<svg viewBox="0 0 24 24" focusable="false">
					{/* 铅笔 + 笔杆分界线：线稿比原来那支实心笔更轻，小尺寸下轮廓也不会糊成一团 */}
					<path
						d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
					<path
						d="M15 5l4 4"
						fill="none"
						stroke="currentColor"
						stroke-width="1.75"
						stroke-linecap="round"
					/>
				</svg>
			</span>
		</button>
		{
			/* 关闭按钮常驻 DOM，只在「装在抽屉里」时显示：
			   这一页是预渲染的静态路由，查询参数到不了服务端，
			   显隐由 CommentLayout 在首屏前打的 html[data-embedded] 标记决定。
			   内嵌在文章页时（closable=false）连 DOM 都不留。 */
			closable && <button
				type="button"
				class="tg-head-close"
				data-tg-close
				title={closeLabel}
				aria-label={closeLabel}
			>
				<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
					<path
						d="M6 6 18 18M18 6 6 18"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					/>
				</svg>
			</button>
		}
	</header>

	<div class="tg-scroll" data-tg-scroll>
		{/* 「加载更早」：分页只先拉最新一页，历史在用户往上滚时才补。
		    常驻 DOM、默认 hidden，脚本按还有没有下一页开关 */}
		<div class="tg-more" data-tg-more hidden>
			<button type="button" class="tg-more-btn" data-tg-load-more>
				{i18n(I18nKey.commentChatLoadMore)}
			</button>
		</div>

		{/* 分隔线先藏着：消息是异步拉回来的，直接显示「今天」会在空列表上闪一下，
		    加载成功后只要日期确实都是今天，脚本再把它露出来 */}
		<div class="tg-day" data-tg-day hidden>
			<span>{i18n(I18nKey.commentChatToday)}</span>
		</div>

		{/* 消息由脚本按后端评论渲染：这里只留状态占位，避免首屏一片空白。
		    加载完成且有数据时脚本会把这块整个摘掉；空列表 / 请求失败换成对应文案 */}
		<div class="tg-state" data-tg-state="loading">
			{i18n(I18nKey.commentChatLoading)}
		</div>
	</div>

	<div class="tg-bottom">
		{/* 回复预览条：和 Telegram 输入框上方那条一样 —— 左侧竖线 + 名字 + 摘要，
		    发送后引用块会嵌进新气泡顶部。由 ChatContextPop 控制显隐 */}
		<div class="tg-reply" data-tg-reply hidden>
			<span class="tg-reply-line" aria-hidden="true"></span>
			<span class="tg-reply-body">
				<span class="tg-reply-name" data-tg-reply-name></span>
				<span class="tg-reply-text" data-tg-reply-text></span>
			</span>
			<button
				type="button"
				class="tg-reply-close"
				data-tg-reply-cancel
				aria-label={i18n(I18nKey.tabClose)}
				title={i18n(I18nKey.tabClose)}
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M6 6 18 18M18 6 6 18"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					/>
				</svg>
			</button>
		</div>

		<div class="tg-emoji-panel" data-tg-emoji-panel hidden>
			<div class="tg-emoji-body" data-tg-emoji-body>
				{/* 一个系列一栏：网格结构与 emoji 时期的完全一样（8 列、.tg-emoji-item 格子），
				    只是格子里放的是一张图，点一下插进输入框，能和文字排在同一行 */}
				{packs.map((pack, index) => (
					<div
						class="tg-emoji-grid"
						id={`tg-emoji-pack-${pack.id}`}
						data-tg-emoji-cat={pack.id}
						hidden={index !== 0}
					>
						{pack.items.map((item) => (
							<button
								type="button"
								class="tg-emoji-item"
								data-tg-emoji-src={item.src}
								data-tg-emoji-name={item.name}
								title={item.name}
								aria-label={item.name}
							>
								<img src={item.src} alt="" loading="lazy" decoding="async" />
							</button>
						))}
					</div>
				))}
			</div>

			{/* 只有一个系列时不显示 tab 栏：一栏的「分类」没有意义，还会白占一行高度 */}
			{
				showTabs && (
					<div class="tg-emoji-tabs" role="tablist">
						{packs.map((pack, index) => (
							<button
								type="button"
								class="tg-emoji-tab"
								role="tab"
								data-tg-emoji-tab={pack.id}
								aria-selected={index === 0 ? "true" : "false"}
								aria-controls={`tg-emoji-pack-${pack.id}`}
								title={pack.label}
								aria-label={pack.label}
							>
								<svg class="tg-emoji-tab-icon" viewBox="0 0 24 24" aria-hidden="true">
									{/* 表情包：方角 + 右上卷边 + 笑脸，和 Telegram 的表情包 tab 同义 */}
									<path d="M15.5 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.5L15.5 3Z" />
									<path d="M15 3v4a2 2 0 0 0 2 2h4" />
									<path d="M8.6 13.2h.01M15.4 13.2h.01" />
									<path d="M9.8 16.1c.55.4 1.3.6 2.2.6s1.65-.2 2.2-.6" />
								</svg>
							</button>
						))}
					</div>
				)
			}
		</div>

		<form class="tg-composer" data-tg-composer>
			<button
				type="button"
				class="tg-tool"
				data-tg-attach
				title={i18n(I18nKey.commentChatAttach)}
				aria-label={i18n(I18nKey.commentChatAttach)}
			>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M20.4 11.3 12 19.7a5.6 5.6 0 0 1-7.9-7.9l8.6-8.6a3.7 3.7 0 0 1 5.3 5.3l-8.5 8.5a1.9 1.9 0 0 1-2.6-2.6l7.6-7.6"
					/>
				</svg>
			</button>

			<div class="tg-input-wrap">
				{/* 用 contenteditable 而不是 textarea：贴纸要能像 QQ 那样直接排在文字里。
				    textarea 只能放纯文本，图片塞不进去，也就没法做「前排 🐱」这种效果。
				    代价是换行、光标、取值都得自己处理，见脚本里的 insertAtCaret / readComposer */}
				<div
					class="tg-input tg-input--rich"
					role="textbox"
					aria-multiline="true"
					contenteditable="true"
					spellcheck="false"
					data-tg-input
					data-empty="true"
					data-placeholder={i18n(I18nKey.commentChatPlaceholder)}
					aria-label={i18n(I18nKey.commentChatPlaceholder)}
				></div>
				<button
					type="button"
					class="tg-emoji"
					data-tg-emoji
					aria-expanded="false"
					title={i18n(I18nKey.commentChatEmoji)}
					aria-label={i18n(I18nKey.commentChatEmoji)}
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="8.6"></circle>
						<path d="M8.6 14.3a4.2 4.2 0 0 0 6.8 0"></path>
						<circle cx="9.2" cy="10" r="0.9" fill="currentColor" stroke="none"
						></circle>
						<circle cx="14.8" cy="10" r="0.9" fill="currentColor" stroke="none"
						></circle>
					</svg>
				</button>
			</div>

			<button class="tg-send" type="submit" aria-label={i18n(I18nKey.commentChatSend)} data-tg-send>
				<svg class="tg-send-plane" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M3.4 20.4 21 12 3.4 3.6l3.1 7.2 9 1.2-9 1.2z" fill="currentColor" />
				</svg>
			</button>

			<input
				type="file"
				accept="image/*"
				class="tg-file"
				data-tg-file
				tabindex="-1"
				aria-hidden="true"
			/>

			{/* 身份没填完时这层盖住整条输入栏，点它直接打开 CommentInfoPop。
			    用覆盖层而不是逐个控件绑事件：textarea 被 disabled 之后根本不派发
			    点击事件，包一层最省事，表情 / 附件 / 发送也一并挡住 */}
			<button
				type="button"
				class="tg-composer-lock"
				data-ci-open
				aria-haspopup="dialog"
			>
				{i18n(I18nKey.commentInfoLocked)}
			</button>
		</form>
	</div>

	{/* CommentInfoPop：评论信息弹窗。铺满整个聊天页（.tg-chat 是 position: relative），
	    和顶栏、输入栏同处一个文档，主题变量直接可用，不涉及任何跨 iframe 通信 */}
	<div class="ci-pop" data-ci-pop hidden>
		<div class="ci-mask" data-ci-mask></div>
		<div
			class="ci-card"
			role="dialog"
			aria-modal="true"
			aria-labelledby="comment-info-title"
		>
			<div class="ci-head">
				<span class="ci-title" id="comment-info-title">
					{i18n(I18nKey.commentInfoTitle)}
				</span>
				<button
					type="button"
					class="ci-close"
					data-ci-close
					aria-label={i18n(I18nKey.tabClose)}
