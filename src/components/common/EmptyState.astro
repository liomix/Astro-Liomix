---
/**
 * 空状态：一张插画 + 一句（可选）说明
 * ---------------------------------------------------------------------------
 * 全站「这里本来该有东西，但现在没有」的页面和区块都用它，插画是同一份
 * `utyan_empty.json`，区别只在尺寸：
 *   - 整页空态（404、友链、项目、番组……）传大一点；
 *   - 列表筛选无结果、评论区空态这类「局部空」传小一点。
 * 不传就按视口走 `clamp()`，窄屏不会顶满、宽屏不会缩成一个小点。
 *
 * 动画本身在 utils/empty-lottie.ts 的 `<empty-lottie>` 里：按需加载 lottie-web、
 * 进视口才播、`prefers-reduced-motion` 时只画静态帧。
 */
interface Props {
	/** 素材名（src/assets/lottie 下的文件名，不带 .json），默认就是空态那张 */
	animation?: string;
	/** 插画边长，任意 CSS 长度；跟着所在容器走 */
	size?: string;
	title?: string;
	description?: string;
	class?: string;
}

const {
	animation = "utyan_empty",
	size = "clamp(96px, 18vw, 148px)",
	title,
	description,
	class: className,
} = Astro.props;
---

<div class:list={["empty-state", className]} style={`--empty-size: ${size}`}>
	<empty-lottie
		class="empty-state__art"
		data-animation={animation}></empty-lottie>
	{
		title && (
			<p class="empty-state__title" set:html={title} />
		)
	}
	{
		description && (
			<p class="empty-state__desc" set:html={description} />
		)
	}
	<slot />
</div>

<script>
	import { registerEmptyLottie } from "@/utils/empty-lottie";

	// frontmatter 只在构建/SSR 时执行，自定义元素必须在浏览器里注册一次
	registerEmptyLottie();
</script>

<style>
	.empty-state {
		display: flex;
		flex-direction: column;
		/* 横竖都居中，并且自己占满容器宽度：哪怕被塞进 grid/flex 的某个格子里，
		   插画和文字也不会贴着左边 */
		align-items: center;
		justify-content: center;
		width: 100%;
		margin-inline: auto;
		gap: 0.5rem;
		padding: 2rem 0;
		text-align: center;
	}

	/* 插画铺满自己的方框；框的大小由 --empty-size 决定，缺省也不会塌 */
	.empty-state__art {
		display: block;
		width: var(--empty-size, 128px);
		height: var(--empty-size, 128px);
		flex: none;
	}

	.empty-state__title,
	.empty-state__desc {
		width: 100%;
	}

	.empty-state__title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		color: var(--deep-text, #1f2937);
	}

	.empty-state__desc {
		margin: 0;
		max-width: 28rem;
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--muted-text, rgb(107 114 128));
	}

	:global(.dark) .empty-state__title {
		color: var(--deep-text, #f3f4f6);
	}
</style>
