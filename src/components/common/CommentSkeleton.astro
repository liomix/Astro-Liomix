---
/**
 * 评论区的加载骨架屏
 * ---------------------------------------------------------------------------
 * 拉评论是一个网络往返，等待期间原来只有一行「正在加载评论…」。换成骨架屏之后，
 * 首屏先把「这里会有一串聊天气泡」的形状画出来：左一条右一条、带头像、圆角方向
 * 跟着发送方走 —— 数据回来时是替换而不是重排，视觉上不跳。
 *
 * 形状按 Telegram 的聊天列表来：
 *   - 别人（左）带头像，气泡左上角收窄；自己（右）没有头像，气泡右上角收窄；
 *   - 每条 1–2 行字，宽度不等，读起来像真的在加载，而不是一排等长灰条。
 *
 * 组件本身不拉数据，也不管什么时候消失：`Comment.astro` 把它放进状态占位里，
 * 脚本拿到数据后用 `innerHTML` 换掉（连「再加载一次」都能原样恢复）。
 */
import Skeleton from "@/components/common/Skeleton.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	/** 画几条；默认 4 条足够铺满一屏的上半部分 */
	rows?: number;
	class?: string;
}

const { rows = 4, class: className } = Astro.props;

/** 每条气泡的形状：左/右 + 两行字的宽度（第二行不写就是单行） */
const ROWS = [
	{ side: "in", lines: ["72%", "44%"] },
	{ side: "out", lines: ["56%"] },
	{ side: "in", lines: ["84%", "62%"] },
	{ side: "out", lines: ["68%", "38%"] },
	{ side: "in", lines: ["48%"] },
	{ side: "out", lines: ["76%"] },
] as const;

const list = ROWS.slice(0, Math.max(1, Math.min(ROWS.length, rows)));
---

<div class:list={["comment-skeleton", className]} role="status" aria-live="polite">
	{/* 视觉上是骨架，读屏软件读到的仍然是「正在加载」 */}
	<span class="comment-skeleton__sr">{i18n(I18nKey.commentChatLoading)}</span>
	{
		list.map((row) => (
			<div class:list={["comment-skeleton__row", `comment-skeleton__row--${row.side}`]}>
				{row.side === "in" && (
					<Skeleton class="comment-skeleton__avatar" circle width="2.25rem" height="2.25rem" />
				)}
				<div class="comment-skeleton__bubble">
					{row.lines.map((line) => (
						<Skeleton class="comment-skeleton__line" height="0.7rem" width={line} />
					))}
				</div>
			</div>
		))
	}
</div>

<style>
	.comment-skeleton {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		width: 100%;
		padding: 0.35rem 0 0.6rem;
	}

	.comment-skeleton__sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.comment-skeleton__row {
		display: flex;
		align-items: flex-end;
		gap: 0.5rem;
		max-width: 100%;
	}

	.comment-skeleton__row--out {
		justify-content: flex-end;
	}

	.comment-skeleton__avatar {
		margin-bottom: 0.1rem;
	}

	/* 气泡：一半是内容行，一半是留白，靠左右不同的圆角表现「谁发的」 */
	.comment-skeleton__bubble {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		width: min(72%, 22rem);
		padding: 0.6rem 0.7rem;
		border-radius: 1rem;
		background: color-mix(in srgb, var(--tg-text, #1a1a1a) 4%, transparent);
	}

	.comment-skeleton__row--in .comment-skeleton__bubble {
		border-top-left-radius: 0.3rem;
	}

	/* 右边（自己）的气泡短一点，左边（别人）长短不一：读起来像真实消息 */
	.comment-skeleton__row--out .comment-skeleton__bubble {
		width: min(58%, 18rem);
		border-top-right-radius: 0.3rem;
	}

	.comment-skeleton__line {
		min-width: 2rem;
	}
</style>
